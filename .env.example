# Public Astro site URL (canonicals / revalidate)
SITE_URL=https://xoomplus.co.uk

# WordPress CMS (headless)
WP_BASE_URL=https://xoomplusagency.com
PUBLIC_WP_API=https://xoomplusagency.com/wp-json/wp/v2

# Contact Form 7 (browser → WP REST — no /api/contact)
PUBLIC_CF7_FORM_ID=123
# PUBLIC_CF7_FORM_ID_ENQUIRY=124
# PUBLIC_CF7_FIELD_MAP={"name":"your-name","email":"your-email","details":"your-message","company":"your-company","phone":"your-phone","website":"your-website","budget":"your-budget","services":"your-services","source":"your-source"}

# Node / Vercel
REVALIDATE_SECRET=
# ISR_BYPASS_TOKEN=   # optional; defaults to REVALIDATE_SECRET on Vercel
# HTML_CACHE=1        # opt-in Node HTML page cache (cPanel/VPS)
# HTML_CACHE_DIR=/home/user/tmp/xoomplus-html-cache
