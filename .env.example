# staging (default) | production
SITE_ENV=staging

# WordPress origin (no trailing slash). Server-side only.
# Today may match SITE_URL; after the CMS move use https://cms.xoomplus.co.uk
WP_BASE_URL=https://xoomplus.co.uk

# Optional: Yoast sitemap fetch origin if it differs from WP_BASE_URL.
# Defaults to WP_BASE_URL. Must reach WordPress directly (never the Astro public host
# once Astro owns the apex — otherwise the sitemap proxy would loop).
# WP_SITEMAP_ORIGIN=https://cms.xoomplus.co.uk

# WordPress REST collection root for blog posts. Default shown.
# After CMS move: https://cms.xoomplus.co.uk/wp-json/wp/v2
PUBLIC_WP_API=https://xoomplus.co.uk/wp-json/wp/v2

# Public frontend origin for canonicals, schema, and sitemap <loc> rewrite.
# Always the production website — never the CMS hostname.
SITE_URL=https://xoomplus.co.uk

# Shared secret for POST /api/revalidate (header: x-revalidate-secret).
REVALIDATE_SECRET=

# Host build/deploy hook URL (VPS listener, Vercel Deploy Hook, Netlify Build Hook, etc.).
# Used by WordPress (and optional CI) to trigger a rebuild when posts change.
# Never expose to the browser — server / WP / CI only. Do not commit real secrets.
XP_DEPLOY_HOOK_URL=
DEPLOY_HOOK_URL=

# Legacy alias — still read if DEPLOY_HOOK_URL is empty.
VERCEL_DEPLOY_HOOK_URL=

# Dev-only: set to "off" to skip the WordPress posts disk cache (node_modules/.cache/wp-cache.json).
# Or visit any page with ?refresh=1. Production builds always skip the disk cache.
# WP_CACHE=off
