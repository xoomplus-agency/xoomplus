# Xoomplus static site — upload dist/ contents into public_html
# (Astro directory format: /about/index.html)

Options -Indexes
DirectoryIndex index.html

# Pretty URLs: /about → /about/ or /about/index.html
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Existing files/dirs
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Trailing-slash directories with index.html
	RewriteCond %{REQUEST_FILENAME}/index.html -f
	RewriteRule ^(.*)$ $1/index.html [L]

	# 404
	RewriteRule ^ 404.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	<If "%{REQUEST_URI} =~ m#^/(fonts|images|videos|icons)/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/avif "access plus 1 year"
	ExpiresByType video/webm "access plus 1 year"
	ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
	AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>
