---
/**
 * On-demand /blog listing. First page of `status=publish` posts via wp-posts.
 * ISR + CDN s-maxage=300; purge via /api/revalidate on WP publish.
 * Takes priority over CMS [slug].astro for `/blog`.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
	theme="light"
	title="Digital Marketing Insights & Guides | Xoomplus Blog"
	description="Practical SEO, PPC, web design and social media insights from the Xoomplus team. Read our latest guides, tips and industry updates to grow online."
	canonicalPath="/blog"
	skipWpSeo
>
	<main id="main-content" class="flex-1">
		<PageHero title="Blogs" />
		<BlogListing />
		<CTASection />
	</main>
</Layout>
