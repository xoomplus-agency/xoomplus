---
import Layout from '../../layouts/Layout.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import CaseStudyOverview from '../../components/case-study/CaseStudyOverview.astro';
import CaseStudyChallenge from '../../components/case-study/CaseStudyChallenge.astro';
import CaseStudyStrategy from '../../components/case-study/CaseStudyStrategy.astro';
import CaseStudyDelivered from '../../components/case-study/CaseStudyDelivered.astro';
import CaseStudyOutcome from '../../components/case-study/CaseStudyOutcome.astro';
import CaseShowcase from '../../components/CaseShowcase.astro';
import CTASection from '../../components/CTASection.astro';
import { caseStudies, getCaseStudyBySlug, type CaseStudy } from '../../data/caseStudies';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

interface Props {
	study: CaseStudy;
}

const { slug } = Astro.params;
const studyFromProps = Astro.props.study;
const study = studyFromProps ?? (slug ? getCaseStudyBySlug(slug) : undefined);

if (!study) {
	return Astro.rewrite('/404');
}

const canonicalPath = `/case-studies/${study.slug}`;
const metaTitle = `${study.title} ${study.highlight} | Xoomplus`;
const metaDescription = study.description.join(' ').slice(0, 160);
const heroImage = study.heroImage ?? '/images/case-study-hero.webp';
---

<Layout
	title={metaTitle}
	description={metaDescription}
	canonicalPath={canonicalPath}
	image={heroImage}
	lcpImagePreload={{ href: heroImage }}
>
	<main id="main-content" class="flex-1 overflow-x-clip">
		<CaseStudyHero
			title={study.title}
			highlight={study.highlight}
			description={study.description}
			heroPill={study.heroPill}
			heroImage={heroImage}
			liveUrl={study.liveUrl}
			client={study.client}
			industry={study.industry}
			location={study.location}
			services={study.services}
		/>
		<CaseStudyOverview {...study.overview} />
		<CaseStudyChallenge {...study.challenge} />
		<CaseStudyStrategy {...study.strategy} />
		<CaseStudyDelivered {...study.delivered} />
		<CaseStudyOutcome {...study.outcome} />
		{study.showcase ? <CaseShowcase showcase={study.showcase} /> : null}
		<CTASection
			pill="Your Next Chapter"
			heading="Let’s Move Your Business Forward"
			text="Tell us what you’re working towards. We’ll explore your challenges, discuss the possibilities and identify the right place to start."
			buttonLabel="Discuss Your Project"
			buttonHref="/contact"
			secondaryLabel="info@xoomplus.co.uk"
			secondaryHref="mailto:info@xoomplus.co.uk"
		/>
	</main>
</Layout>
