---
/**
 * Privacy Policy — content from WordPress page slug `privacy-policy`.
 * Build fails if the CMS page is missing (footer links here).
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { getPage } from '../lib/wp';
import { prepareCmsPageHtml } from '../lib/wp-content';
import '../styles/prose-blog.css';

const cmsPage = await getPage('privacy-policy');
if (!cmsPage) {
	throw new Error(
		'[privacy-policy] WordPress page slug "privacy-policy" not found or not published. The footer links to /privacy-policy/.',
	);
}

const title = cmsPage.seoTitle?.trim() || `${cmsPage.title} | Xoomplus`;
const description =
	cmsPage.seoDescription?.trim() ||
	'Read the Xoomplus privacy policy to understand how we collect, use and protect your personal information.';
const bodyHtml = prepareCmsPageHtml(cmsPage.content, cmsPage.title);

const lastUpdated = cmsPage.modified
	? new Date(cmsPage.modified).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		})
	: null;
---

<Layout
	title={title}
	description={description}
	canonicalPath="/privacy-policy/"
	suppressNavActive={true}
	skipWpSeo={true}
>
	<main id="main-content" class="page-privacy-policy flex-1">
		<PageHero title={cmsPage.title || 'Privacy Policy'} />
		<Section background="white" aria-label="Privacy Policy">
			<div class="privacy-policy__column">
				{
					bodyHtml ? (
						<div class="prose-blog" set:html={bodyHtml} />
					) : (
						<p class="privacy-policy__empty m-0">
							This privacy policy is being updated. Please check back soon.
						</p>
					)
				}
				{
					lastUpdated ? (
						<p class="privacy-policy__updated m-0">Last updated: {lastUpdated}</p>
					) : null
				}
			</div>
		</Section>
	</main>
</Layout>

<style>
	.privacy-policy__column {
		max-width: 820px;
		margin-inline: auto;
	}

	.privacy-policy__updated {
		margin-top: 2rem;
		font-family: var(--font-inter);
		font-size: 13px;
		line-height: 1.5;
		color: #888888;
	}

	.privacy-policy__empty {
		font-family: var(--font-inter);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-primary-black);
	}
</style>
