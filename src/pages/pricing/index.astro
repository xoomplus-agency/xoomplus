---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PricingIntro from '../../components/PricingIntro.astro';
import PricingPlans from '../../components/PricingPlans.astro';
import PricingSteps from '../../components/PricingSteps.astro';
import WhyXoomplus from '../../components/WhyXoomplus.astro';
import PricingForm from '../../components/PricingForm.astro';
import FAQ from '../../components/FAQ.astro';
import { pricingWhy } from '../../data/pricing-why';
import CTASection from '@/components/CTASection.astro';
---

<Layout
	title="Digital Marketing Packages | From £699/month"
	description="Clear digital marketing packages from £699/month. Compare SEO, PPC, social media and web design pricing, then book a strategy call with Xoomplus."
	skipWpSeo
>
	<main id="main-content" class="page-pricing flex-1">
		<PageHero title="Pricing" titleTag="p" />
		<PricingIntro />
		<PricingPlans />
		<PricingSteps />
		<WhyXoomplus content={pricingWhy} id="why-xoomplus" buttonWidth="212px" />
		<PricingForm />
		<FAQ page="pricing" id="pricing-faq" />
		<CTASection
			pill="Take the Next Step"
			heading="Let’s Move Your Business Forward"
			text="Share a few details about your business. We will review your current digital footprint and discuss the best place to start."
			buttonHref="#pricing-form"
			buttonLabel="Request Your Tailored Proposal"
		/>
	</main>
</Layout>

<style is:global>
	/* Pricing-only intro wrapping — scoped under .page-pricing */

	@media (min-width: 1024px) {
		/* Pricing plans intro — 2 lines */
		.page-pricing .pricing-plans__intro {
			max-width: min(100%, 860px);
		}

		/* Why Xoomplus heading — 1 line when space permits */
		.page-pricing #why-xoomplus .container > [data-reveal='up'] {
			max-width: min(100%, 1100px);
		}

		.page-pricing #pricing-why-heading {
			text-wrap: wrap;
			overflow-wrap: normal;
		}

		/* Why Xoomplus paragraph — 2 lines */
		.page-pricing #why-xoomplus .text-on-light {
			max-width: min(100%, 820px);
		}
	}
</style>
