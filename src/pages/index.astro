---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Brands from '../components/Brands.astro';
import Services from '../components/Services.astro';
import OurGrowth from '../components/OurGrowth.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import OurProcess from '../components/OurProcess.astro';
import Industries from '../components/Industries.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import Blogs from '../components/Blogs.astro';
import OurLocations from '../components/OurLocations.astro';
import ContactSection from '../components/ContactSection.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout>
	<main class="flex-1">
		<Hero />
		<Brands />
		<Services />
		<WhyChooseUs />
		<OurProcess />
		<OurGrowth />
		<CaseStudies />
		<Industries />
		<OurLocations />
		<Testimonials />
		<Blogs />
		<FAQ page="home" />
		<ContactSection />
		<CTASection />
	</main>
</Layout>
