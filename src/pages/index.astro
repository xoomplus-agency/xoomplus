---
/** On-demand so Yoast SEO refreshes without a full redeploy (memory cache + /api/revalidate). */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Brands from '../components/Brands.astro';
import Services from '../components/Services.astro';
import OurGrowth from '../components/OurGrowth.astro';
import WhyXoomplus from '../components/WhyXoomplus.astro';
import OurProcess from '../components/OurProcess.astro';
import Industries from '../components/Industries.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import Blogs from '../components/Blogs.astro';
import OurLocations from '../components/OurLocations.astro';
import ContactSection from '../components/ContactSection.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { getPosts } from '../lib/wp-posts';
import type { WpPost } from '../lib/wp';

// Start the 3-card fetch before layout SEO/nav work so it does not run after them.
const blogPosts: Promise<WpPost[]> = getPosts({ perPage: 3 })
	.then((r) => r.posts)
	.catch((err) => {
		console.error('[home] getPosts failed:', err);
		return [] as WpPost[];
	});
---

<Layout
	lcpImagePreload={{
		href: '/videos/bg-hero-poster.avif',
	}}
>
	<main class="page-home flex-1">
		<Hero />
		<Brands />
		<Services />
		<WhyXoomplus />
		<OurProcess />
		<OurGrowth />
		<CaseStudies />
		<Industries />
		<OurLocations />
		<Testimonials />
		<Blogs posts={blogPosts} />
		<!-- <FAQ page="home" /> -->
		<ContactSection />
		<CTASection />
	</main>
</Layout>

<style is:global>
	/* Homepage-only intro wrapping — scoped under .page-home so shared sections stay unchanged elsewhere */
	/* Long section titles — let the intro block use more of the container */
	.page-home #why-xoomplus .container > [data-reveal='up'],
	.page-home #case-studies .container > [data-reveal='up'],
	.page-home #locations .container > [data-reveal='up'] {
		max-width: min(100%, 1100px);
	}

	.page-home #why-heading,
	.page-home #case-studies-heading,
	.page-home #locations-heading {
		text-wrap: wrap;
		overflow-wrap: normal;
	}

	/* Two-line intros when the container is wide enough */
	.page-home #why-xoomplus .text-on-light,
	.page-home #case-studies .text-on-light,
	.page-home #industries .text-on-light,
	.page-home #locations .text-on-light,
	.page-home #process .process-intro {
		max-width: min(100%, 820px);
	}

	/* One-line support copy when width permits */
	.page-home #testimonials .container > [data-reveal='up'],
	.page-home #blogs .container > [data-reveal='up'] {
		max-width: min(100%, 900px);
	}

	.page-home #testimonials .text-on-light,
	.page-home #blogs .text-on-light {
		max-width: min(100%, 860px);
	}

	/* Use the full contact column so copy can wrap to two lines */
	.page-home #contact .contact-intro {
		max-width: none;
	}
</style>
