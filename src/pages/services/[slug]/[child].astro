---
/**
 * Nested child service page — one path per (main service, child) from data.
 * Adding a child to mainServices[].children creates its page automatically.
 *
 * Section order:
 * Hero → Built around people → Working together → Services (grid) → Clarity →
 * Services stack → Services behind → FAQ → CTA
 */
import Layout from '../../../layouts/Layout.astro';
import ChildServiceHero from '../../../components/ChildServiceHero.astro';
import ServiceFeatures from '../../../components/ServiceFeatures.astro';
import ChildProcess from '../../../components/ChildProcess.astro';
import ChildServices from '../../../components/ChildServices.astro';
import IndustryClarity from '../../../components/IndustryClarity.astro';
import ChildServiceStack from '../../../components/ChildServiceStack.astro';
import ServicesBehind from '../../../components/ServicesBehind.astro';
import FAQ from '../../../components/FAQ.astro';
import {
	defaultChildClarity,
	defaultChildFaq,
	defaultChildFeatures,
	defaultChildServicesBehind,
} from '../../../data/child-defaults';
import {
	CHILD_PROCESS_IMAGE_HEIGHT,
	CHILD_PROCESS_IMAGE_WIDTH,
	getChildService,
	getLiveChildServices,
	mainServices,
	resolveChildProcessImage,
	type ChildServiceLive,
	type MainService,
} from '../../../data/main-services';
import {
	CHILD_SERVICE_STACK_IMAGE_HEIGHT,
	CHILD_SERVICE_STACK_IMAGE_WIDTH,
	defaultChildServicesDraft,
	defaultChildServiceStackDraft,
	resolveChildServicesContent,
} from '../../../data/child-services';
import CTASection from '@/components/CTASection.astro';

export function getStaticPaths() {
	return mainServices.flatMap((service) =>
		getLiveChildServices(service).map((child) => ({
			params: { slug: service.slug, child: child.slug },
			props: { service, child },
		})),
	);
}

interface Props {
	service: MainService;
	child: ChildServiceLive;
}

const { slug, child: childParam } = Astro.params;
const fromProps = Astro.props as Props;
const resolved =
	fromProps.service && fromProps.child
		? { service: fromProps.service, child: fromProps.child }
		: slug && childParam
			? getChildService(slug, childParam)
			: undefined;

if (!resolved || resolved.child.disabled === true) {
	return Astro.rewrite('/404');
}

const { service, child } = resolved;
const canonicalPath = `/services/${service.slug}/${child.slug}/`;
const site = Astro.site;
const origin = site?.origin ?? '';

/** FAQ — override per child with `child.faq` when ready. */
const faqData = child.faq ?? defaultChildFaq;

const shortName = child.shortName ?? child.name;
const secondaryLabel =
	child.secondaryLabel ??
	(service.slug === 'web-design-development'
		? 'Explore Our Design Process'
		: 'Explore Our Process');
const primaryLabel = child.hero.buttonLabel ?? `Book a ${shortName} Consultation`;

const childProcessHeading =
	child.processHeading ?? `What Better ${shortName} Can Do for Your Business`;
// PLACEHOLDER: replace with real content
const childProcessText =
	child.processText ??
	`${shortName} can strengthen how people discover, understand and act on your offer — from clearer journeys and messaging to a more confident next step. We shape the work around your audience, your goals and the channels that matter most.`;
const childProcessPill = child.processPill ?? 'Working together';
const childProcessPrimaryLabel = child.processPrimaryLabel ?? primaryLabel;
const childProcessSecondaryLabel = child.processSecondaryLabel ?? secondaryLabel;

const resolvedProcessImage = resolveChildProcessImage(child.slug, child.processImage);
const childProcessImageData = {
	src: resolvedProcessImage.src,
	alt: child.processImage?.alt ?? `${child.name} design shown on a phone`,
	width: child.processImage?.width ?? CHILD_PROCESS_IMAGE_WIDTH,
	height: child.processImage?.height ?? CHILD_PROCESS_IMAGE_HEIGHT,
};

if (import.meta.env.DEV) {
	console.log(
		`ChildProcess image: ${resolvedProcessImage.path} (source: ${resolvedProcessImage.source})`,
	);
}

/**
 * Services card grid — below Working together.
 * Set `child.services.cards` to [] to hide.
 */
const servicesDraft = child.services ?? defaultChildServicesDraft();
const { content: childServicesContent, missing: childServicesMissing } =
	servicesDraft.cards.length > 0
		? resolveChildServicesContent(servicesDraft, shortName)
		: { content: null, missing: [] as { title: string; expected: string[] }[] };

/**
 * Services scroll stack — below Clarity.
 * Set `child.serviceStack.cards` to [] to hide.
 */
const serviceStackDraft = child.serviceStack ?? defaultChildServiceStackDraft();
const { content: childServiceStackContent, missing: childServiceStackMissing } =
	serviceStackDraft.cards.length > 0
		? resolveChildServicesContent(serviceStackDraft, shortName, {
				imageWidth: CHILD_SERVICE_STACK_IMAGE_WIDTH,
				imageHeight: CHILD_SERVICE_STACK_IMAGE_HEIGHT,
			})
		: { content: null, missing: [] as { title: string; expected: string[] }[] };

if (import.meta.env.DEV) {
	for (const miss of childServicesMissing) {
		console.warn(
			`ChildServices (grid) missing image for "${miss.title}". Expected one of: ${miss.expected.join(', ')}`,
		);
	}
	for (const miss of childServiceStackMissing) {
		console.warn(
			`ChildServiceStack missing image for "${miss.title}". Expected one of: ${miss.expected.join(', ')}`,
		);
	}
}

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: origin ? `${origin}/` : '/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Services',
			item: origin ? `${origin}/services/` : '/services/',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: service.name,
			item: origin ? `${origin}/services/${service.slug}/` : `/services/${service.slug}/`,
		},
		{
			'@type': 'ListItem',
			position: 4,
			name: child.name,
			item: origin ? `${origin}${canonicalPath}` : canonicalPath,
		},
	],
};
---

<Layout
	title={child.metaTitle}
	description={child.metaDescription}
	canonicalPath={canonicalPath}
	image={child.hero.image.src}
	headerTheme="light"
>
	<script slot="json-ld" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

	<main
		id="main-content"
		class:list={[
			'child-service-main',
			'flex-1',
			service.slug === 'web-design-development' ? 'child-service-main--web-design-development' : null,
		]}
	>
		<ChildServiceHero
			{...child.hero}
			primaryLabel={primaryLabel}
			primaryHref="/contact"
			secondaryLabel={secondaryLabel}
			secondaryHref="#process"
		/>
		<ServiceFeatures {...(child.features ?? defaultChildFeatures)} id="features" />
		{/* Working together — hero secondary CTA target (#process) */}
		<ChildProcess
			id="process"
			pill={childProcessPill}
			heading={childProcessHeading}
			text={childProcessText}
			image={childProcessImageData}
			primaryButton={{ label: childProcessPrimaryLabel, href: '/contact' }}
			secondaryButton={{ label: childProcessSecondaryLabel, href: '#clarity' }}
		/>
		{childServicesContent ? (
			<ChildServices
				id="services"
				pill={childServicesContent.pill ?? 'Services'}
				heading={childServicesContent.heading ?? `Our ${shortName} Services`}
				text={childServicesContent.text ?? ''}
				cards={childServicesContent.cards}
			/>
		) : null}
		<IndustryClarity content={child.clarity ?? defaultChildClarity} />
		{childServiceStackContent ? (
			<ChildServiceStack
				id="service-stack"
				pill={childServiceStackContent.pill ?? 'Services'}
				heading={childServiceStackContent.heading ?? `Our ${shortName} Services`}
				text={childServiceStackContent.text ?? ''}
				cards={childServiceStackContent.cards}
			/>
		) : null}
		{/* DEFAULT: replace per child service when real content is ready */}
		<ServicesBehind content={child.servicesBehind ?? defaultChildServicesBehind} />
		{/* DEFAULT: replace per child via `child.faq` or `faqs['child-service']` */}
		<FAQ
			id={`${child.slug}-faq`}
			pill={faqData.pill}
			heading={faqData.heading}
			text={faqData.text}
			items={faqData.items}
		/>
		<CTASection
			pill={child.cta?.pill}
			heading={child.cta?.heading}
			text={child.cta?.text}
			buttonLabel={child.cta?.buttonLabel}
			buttonHref={child.cta?.buttonHref}
			secondaryButtonLabel={child.cta?.secondaryButtonLabel}
			secondaryButtonHref={child.cta?.secondaryButtonHref}
			secondaryLabel={child.cta?.secondaryLabel}
			secondaryHref={child.cta?.secondaryHref}
		/>
	</main>
</Layout>

<style>
	/* Clears fixed navbar (same approach as blog detail) before Section py-section */
	.child-service-main {
		--child-nav-offset: 100px;
		padding-top: var(--child-nav-offset);
	}

	/* Anchor targets clear the fixed navbar */
	.child-service-main :global(#process),
	.child-service-main :global(#clarity),
	.child-service-main :global(#services),
	.child-service-main :global(#service-stack) {
		scroll-margin-top: var(--child-nav-offset);
	}

	@media (max-width: 639px) {
		.child-service-main {
			--child-nav-offset: 88px;
		}
	}
</style>

{/* Global so selectors reach nested section components; limited by WDD modifier class */}
<style is:global>
	@media (min-width: 1024px) {
		/* Higher specificity than scoped component rules (class + data-astro-cid) */
		.child-service-main.child-service-main--web-design-development .csh {
			grid-template-columns: 1.85fr 1fr;
		}

		.child-service-main.child-service-main--web-design-development .csh__heading {
			text-wrap: wrap;
			overflow-wrap: normal;
		}

		.child-service-main.child-service-main--web-design-development .sf-header__aside {
			max-width: 560px;
		}

		.child-service-main.child-service-main--web-design-development .industry-clarity__intro {
			max-width: 530px;
		}

		.child-service-main.child-service-main--web-design-development .services-behind__intro {
			max-width: 450px;
		}
	}
</style>
