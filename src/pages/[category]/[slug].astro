---
/**
 * Blog detail — WordPress permalink shape /%category%/%postname%/.
 * On-demand (SSR): only `status=publish` posts render. Draft/delete → 404
 * without a redeploy. CDN: short s-maxage + SWR; purge via revalidate / ?refresh=1.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import FAQAccordion from '../../components/FAQAccordion';
import BlogRelatedPosts from '../../components/BlogRelatedPosts.astro';
import BlogSidebarCta from '../../components/BlogSidebarCta.astro';
import CTASection from '../../components/CTASection.astro';
import {
	BLOG_IMAGE_PLACEHOLDER,
	RESERVED_BLOG_CATEGORY_SLUGS,
	postUrl,
	readTimeMinutes,
} from '../../lib/wp';
import {
	BLOG_NO_STORE,
	BLOG_POST_CACHE_CONTROL,
	getPostBySlug,
} from '../../lib/wp-posts';
import { getNavItemsResolved } from '../../data/nav';
import { cleanWpPostHtml } from '../../lib/wp-content';
import { enhanceTables } from '../../lib/enhance-post-html';
import { extractFaqs } from '../../lib/extract-faqs';
import { BLOG_AUTHOR, RESPECT_CMS_NOINDEX } from '../../config';
import '../../styles/prose-blog.css';

const { category, slug } = Astro.params;

if (
	!category ||
	!slug ||
	RESERVED_BLOG_CATEGORY_SLUGS.has(category)
) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

// Kick off nav in parallel with the post fetch so Header does not wait again.
const navPromise = getNavItemsResolved();

let post: Awaited<ReturnType<typeof getPostBySlug>> = null;
try {
	post = await getPostBySlug(slug);
} catch (err) {
	console.error('[blog detail] getPostBySlug failed:', err);
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

// Wrong category segment, or WP no longer returns this slug as publish.
if (!post || post.categorySlug !== category) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

const forceRefresh = Astro.url.searchParams.get('refresh') === '1';
const cacheControl = forceRefresh ? BLOG_NO_STORE : BLOG_POST_CACHE_CONTROL;
Astro.response.headers.set('Cache-Control', cacheControl);
Astro.response.headers.set('CDN-Cache-Control', cacheControl);
Astro.response.headers.set('Vercel-CDN-Cache-Control', cacheControl);

/** Strip Elementor chrome for Astro prose — not applied to the shared catalog. */
const cleanedHtml = cleanWpPostHtml(post.content);
const enhancedHtml = enhanceTables(cleanedHtml);
const extracted = extractFaqs(enhancedHtml);
const hasContentFaqs = extracted.faqs.length > 0;
const articleHtml = hasContentFaqs
	? extracted.before
	: enhancedHtml;
const articleAfterHtml = hasContentFaqs ? extracted.after : '';
const readTime = readTimeMinutes(enhancedHtml);
const canonicalPath = postUrl(post);
const siteOrigin = Astro.site?.href.replace(/\/+$/, '') ?? '';
const absolutePostUrl = siteOrigin ? `${siteOrigin}${canonicalPath}` : canonicalPath;
/** CMS noindex → ask crawlers not to index, but keep follow + full page render/links. */
const robotsMeta =
	RESPECT_CMS_NOINDEX && post.noindex ? 'noindex, follow' : undefined;

const featureImage = {
	src: post.image?.src ?? BLOG_IMAGE_PLACEHOLDER,
	alt: post.image?.alt ?? post.title,
	width: post.image?.width ?? 1196,
	height: post.image?.height ?? 539,
	srcset: post.image?.srcset,
};

/**
 * Content column ≈ container (1320) − gutters − sidebar (320) − gap (32) ≈ 900px
 * on desktop; full container width on mobile. Matches rendered CSS.
 */
const featureSizes = '(max-width: 1023px) 100vw, 900px';

let featureImageOrigin: string | undefined;
try {
	if (/^https?:\/\//i.test(featureImage.src)) {
		featureImageOrigin = new URL(featureImage.src).origin;
	}
} catch {
	featureImageOrigin = undefined;
}
// Compare to the request origin (not SITE_URL) so localhost → WP media gets preconnect.
const pageOrigin = Astro.url.origin;
const preconnectOrigins =
	featureImageOrigin && featureImageOrigin !== pageOrigin
		? [featureImageOrigin]
		: [];
const lcpImagePreload =
	featureImage.src && featureImage.src !== BLOG_IMAGE_PLACEHOLDER
		? {
				href: featureImage.src,
				imagesrcset: featureImage.srcset || undefined,
				imagesizes: featureImage.srcset ? featureSizes : undefined,
			}
		: undefined;

/** Fallback when the post body has no extractable FAQ section. */
const placeholderFaqs = [
	{
		question: 'Are these examples of industries you have worked in?',
		answer:
			"This page describes possible uses of XoomPlus's services across the listed sectors. It is not a portfolio of sector projects or a claim of specialist experience. We would discuss suitability and any relevant experience in your first conversation.",
	},
	{
		question: 'What if my industry is not listed?',
		answer:
			'We work with businesses across many sectors. If yours is not listed, get in touch — we will tell you honestly whether we are a good fit and how we can help.',
	},
	{
		question: 'Do I need a whole new website?',
		answer:
			'Not always. Some clients need a full rebuild; others only need targeted improvements to pages, SEO, or lead generation. We recommend what matches your goals and budget.',
	},
	{
		question: 'Can I start with just one service?',
		answer:
			'Yes. Many clients begin with a single service such as SEO, Google Ads, or a website refresh, then expand once they see results.',
	},
	{
		question: 'How do you handle specialist or regulated content?',
		answer:
			'We follow your compliance requirements and work with your team or advisors on sensitive copy. Accuracy and approval processes come first in regulated industries.',
	},
];

const formattedDate = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: '2-digit',
	year: 'numeric',
}).format(new Date(post.date));

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.title,
	description: post.excerpt,
	image: featureImage.src,
	datePublished: post.date,
	url: absolutePostUrl,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': absolutePostUrl,
	},
	author: {
		'@type': 'Organization',
		name: BLOG_AUTHOR.name,
		description: BLOG_AUTHOR.role,
	},
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: siteOrigin ? `${siteOrigin}/` : '/',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blogs',
			item: siteOrigin ? `${siteOrigin}/blogs/` : '/blogs/',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: post.category || post.categorySlug,
		},
		{
			'@type': 'ListItem',
			position: 4,
			name: post.title,
			item: absolutePostUrl,
		},
	],
};

const faqSource = hasContentFaqs
	? extracted.faqs.map((item) => ({
			question: item.question,
			answer: item.answerHtml,
		}))
	: placeholderFaqs;

const faqItems = faqSource.map((item, index) => ({
	id: `blog-faq-item-${index}`,
	question: item.question,
	answer: item.answer,
}));

/** Plain text for schema.org — strip HTML from trusted answers. */
function stripHtml(html: string): string {
	return html
		.replace(/<[^>]*>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
}

const faqJsonLd =
	faqItems.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faqItems.map((item) => ({
					'@type': 'Question',
					name: item.question,
					acceptedAnswer: {
						'@type': 'Answer',
						text: stripHtml(item.answer),
					},
				})),
			}
		: null;

const navItems = await navPromise;
---

<Layout
	title={`${post.title} | Xoomplus`}
	description={post.excerpt}
	image={featureImage.src}
	type="article"
	canonicalPath={canonicalPath}
	theme="light"
	robots={robotsMeta}
	skipWpSeo
	lcpImagePreload={lcpImagePreload}
	preconnectOrigins={preconnectOrigins}
	navItems={navItems}
>
	<script slot="json-ld" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
	<script slot="json-ld" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	{
		faqJsonLd && (
			<script
				slot="json-ld"
				type="application/ld+json"
				set:html={JSON.stringify(faqJsonLd)}
			/>
		)
	}

	<main id="main-content" class="blog-detail-main flex-1">
		<Section aria-labelledby="article-title">
			<article class="blog-article">
				<a class="blog-article__back" href="/blogs">
					<svg
						width="14"
						height="14"
						viewBox="0 0 14 14"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M8.5 3.5 5 7l3.5 3.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					Back
				</a>

				<h1
					id="article-title"
					class="blog-article__title text-h1 tracking-[-0.02em] text-primary-black"
				>
					{post.title}
				</h1>

				<div class="blog-article__meta">
					<div class="blog-article__author">
						<span class="blog-article__avatar" aria-hidden="true">X</span>
						<div class="blog-article__author-text">
							<span class="blog-article__author-name">{BLOG_AUTHOR.name}</span>
							<span class="blog-article__author-role">{BLOG_AUTHOR.role}</span>
						</div>
					</div>

					<div class="blog-article__facts">
						<span class="blog-article__fact">
							<svg
								width="14"
								height="14"
								viewBox="0 0 14 14"
								fill="none"
								aria-hidden="true"
							>
								<rect
									x="2"
									y="3"
									width="10"
									height="9"
									rx="1.5"
									stroke="currentColor"
									stroke-width="1.25"></rect>
								<path
									d="M2 5.5h10M4.5 2v2M9.5 2v2"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-linecap="round"></path>
							</svg>
							<time datetime={post.date}>{formattedDate}</time>
						</span>
						<span class="blog-article__fact">
							<svg
								width="14"
								height="14"
								viewBox="0 0 14 14"
								fill="none"
								aria-hidden="true"
							>
								<circle
									cx="7"
									cy="7"
									r="5.25"
									stroke="currentColor"
									stroke-width="1.25"></circle>
								<path
									d="M7 4.5V7l2 1.25"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							{readTime} min read
						</span>
					</div>
				</div>

				<div class="blog-article__layout">
					<div class="blog-article__content">
						{/* LCP: server HTML, never lazy, high priority, intrinsic size + srcset */}
						<img
							class="blog-article__feature"
							src={featureImage.src}
							srcset={featureImage.srcset || undefined}
							sizes={featureImage.srcset ? featureSizes : undefined}
							alt={featureImage.alt}
							width={featureImage.width}
							height={featureImage.height}
							fetchpriority="high"
							decoding="async"
						/>

						<div class="prose-blog blog-article__body" set:html={articleHtml} />

						{
							faqItems.length > 0 && (
								<section
									class="blog-article__faqs"
									aria-labelledby="blog-faqs-heading"
									id="blog-faq"
								>
									<h2
										id="blog-faqs-heading"
										class="blog-article__faqs-heading"
									>
										FAQs
									</h2>
									{/* Below-fold: hydrate when visible so it does not compete with LCP */}
									<FAQAccordion client:visible items={faqItems} defaultOpen={0} />
								</section>
							)
						}

						{
							articleAfterHtml ? (
								<div class="prose-blog blog-article__body" set:html={articleAfterHtml} />
							) : null
						}
					</div>

					<aside class="blog-sidebar" aria-label="Sidebar">
						<div class="blog-sidebar__cta">
							<BlogSidebarCta />
						</div>

						<BlogRelatedPosts
							server:defer
							postId={post.id}
							categorySlug={post.categorySlug}
							postSlug={post.postSlug || post.slug}
							category={post.category}
						>
							<div slot="fallback" class="blog-sidebar__related" aria-hidden="true"></div>
						</BlogRelatedPosts>
					</aside>
				</div>
			</article>
		</Section>

		<CTASection />
	</main>
</Layout>

<style>
	/* Matches existing header clear on this page (fixed navbar) */
	.blog-detail-main {
		--blog-nav-offset: 100px;
		padding-top: var(--blog-nav-offset);
	}

	.blog-article {
		margin-inline: auto;
		/* Fill the site container (1320px) — wider than the old 1196px shell */
		max-width: var(--container-max);
		width: 100%;
	}

	.blog-article__back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		box-sizing: border-box;
		padding: 6px 14px;
		border: 1.5px solid transparent;
		border-radius: 9999px;
		background:
			linear-gradient(#ffffff, #ffffff) padding-box,
			linear-gradient(180deg, #d6d6d6 0%, #4a4a4a 100%) border-box;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
		color: #555555;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease;
	}

	.blog-article__back:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	@media (hover: hover) {
		.blog-article__back:hover {
			border: 1.5px solid #ffa800;
			background: #ffffff;
			color: var(--color-primary-black);
		}
	}

	.blog-article__title {
		margin: 24px 0 0;
		font-family: var(--font-sans);
		font-size: 40px;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-align: left;
	}

	.blog-article__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 24px;
	}

	.blog-article__author {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 16px;
		min-width: 0;
	}

	.blog-article__author-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.blog-article__author-name {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-primary, #ffa800);
	}

	.blog-article__author-role {
		margin: 2px 0 0;
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 400;
		line-height: 1.3;
		color: var(--color-muted, #6b6b6b);
	}

	.blog-article__facts {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px;
	}

	.blog-article__fact {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.3;
		color: #555555;
	}

	.blog-article__fact svg {
		flex-shrink: 0;
		display: block;
	}

	.blog-article__layout {
		display: grid;
		grid-template-columns: 1fr;
		align-items: start;
		gap: 32px;
		margin-top: 24px;
	}

	.blog-article__content {
		min-width: 0;
	}

	.blog-article__feature {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1196 / 539;
		border-radius: 20px;
		object-fit: cover;
	}

	.blog-article__body {
		margin-top: 32px;
	}

	.blog-article__faqs {
		margin-top: 48px;
	}

	.blog-article__faqs-heading {
		margin: 0 0 20px;
		font-family: var(--font-sans);
		font-size: 36px;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--color-primary-black);
	}

	.blog-sidebar {
		display: flex;
		flex-direction: column;
		gap: 24px;
		min-width: 0;
	}

	.blog-sidebar__related-heading {
		margin: 0 0 16px;
		font-family: var(--font-inter);
		font-size: var(--text-h3);
		font-weight: 500;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.blog-sidebar__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
	}

	.blog-sidebar__item {
		min-width: 0;
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.blog-sidebar__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.blog-sidebar__cta {
			width: 100%;
			max-width: 480px;
			margin-inline: auto;
		}
	}

	@media (min-width: 1024px) {
		.blog-article__layout {
			grid-template-columns: minmax(0, 1fr) 320px;
			column-gap: 32px;
			row-gap: 0;
		}

		/* Sticky sidebar — natural height, no internal scroll */
		.blog-sidebar {
			position: sticky;
			top: calc(var(--blog-nav-offset) + 24px);
			align-self: start;
		}

		.blog-sidebar__list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 639px) {
		.blog-detail-main {
			--blog-nav-offset: 88px;
		}

		.blog-article__meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

{/* Same answer HTML chrome as FAQ.astro — scoped to this page only */}
<style is:global>
	.blog-article__faqs .faq-answer a {
		color: var(--color-primary-black);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.blog-article__faqs .faq-answer a:hover {
		color: #ffa800;
	}

	.blog-article__faqs .faq-answer ul,
	.blog-article__faqs .faq-answer ol {
		margin: 0.75em 0 0;
		padding-left: 1.25em;
	}

	.blog-article__faqs .faq-answer li {
		margin-top: 0.35em;
	}

	.blog-article__faqs .faq-answer ul {
		list-style-type: disc;
	}

	.blog-article__faqs .faq-answer ol {
		list-style-type: decimal;
	}
</style>
