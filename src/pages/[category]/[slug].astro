---
/**
 * Permanent redirect: legacy /{category}/{slug}/ → /blog/{slug}/.
 * On-demand so new/unpublished slugs resolve from live WordPress status.
 */
export const prerender = false;

import {
	RESERVED_BLOG_CATEGORY_SLUGS,
	postUrl,
} from '../../lib/wp';
import { BLOG_NO_STORE, getPostBySlug } from '../../lib/wp-posts';

const { category, slug } = Astro.params;

if (
	!category ||
	!slug ||
	RESERVED_BLOG_CATEGORY_SLUGS.has(category)
) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

let post: Awaited<ReturnType<typeof getPostBySlug>> = null;
try {
	post = await getPostBySlug(slug);
} catch (err) {
	console.error('[category/slug] getPostBySlug failed:', err);
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

// Wrong category segment, or WP no longer returns this slug as publish.
if (!post || post.categorySlug !== category) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

const target = postUrl(post);
const absoluteTarget = `https://xoomplus.co.uk${target.replace(/\/+$/, '')}`;

Astro.response.status = 301;
Astro.response.headers.set('Location', target);
Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={absoluteTarget} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>
			This post has moved. <a href={target}>Continue to the article</a>.
		</p>
	</body>
</html>
