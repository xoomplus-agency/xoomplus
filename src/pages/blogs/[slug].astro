---
/**
 * Permanent redirect: legacy /blogs/<slug>/ → WordPress-shaped /<category>/<slug>/
 * Does not match /blogs itself (that stays on the listing).
 */
export const prerender = true;

import { getPosts, postUrl, type WpPost } from '../../lib/wp';

export async function getStaticPaths() {
	const posts = await getPosts({ all: true });
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

interface Props {
	post: WpPost;
}

const postFromProps = Astro.props.post as WpPost | undefined;
const { slug } = Astro.params;
const allPosts = await getPosts({ all: true });
const post =
	postFromProps ?? (slug ? allPosts.find((p) => p.slug === slug) : undefined);

if (!post) {
	return Astro.rewrite('/404');
}

const target = postUrl(post);
const siteOrigin = Astro.site?.href.replace(/\/+$/, '') ?? '';
const absoluteTarget = siteOrigin ? `${siteOrigin}${target}` : target;

// Prefer HTTP 301 via the adapter; HTML below is the static-host / crawl fallback.
Astro.response.status = 301;
Astro.response.headers.set('Location', target);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={absoluteTarget} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>
			This post has moved. <a href={target}>Continue to the article</a>.
		</p>
	</body>
</html>
