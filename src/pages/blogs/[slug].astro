---
/**
 * Permanent redirect: legacy /blogs/<slug>/ → WordPress-shaped /<category>/<slug>/.
 * On-demand so new/unpublished slugs resolve from live WordPress status.
 */
export const prerender = false;

import { postUrl } from '../../lib/wp';
import { BLOG_NO_STORE, getPostBySlug } from '../../lib/wp-posts';

const { slug } = Astro.params;

if (!slug) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

let post: Awaited<ReturnType<typeof getPostBySlug>> = null;
try {
	post = await getPostBySlug(slug);
} catch (err) {
	console.error('[blogs/slug] getPostBySlug failed:', err);
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

if (!post) {
	Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
	return Astro.rewrite('/404');
}

const target = postUrl(post);
const siteOrigin = Astro.site?.href.replace(/\/+$/, '') ?? '';
const absoluteTarget = siteOrigin ? `${siteOrigin}${target}` : target;

Astro.response.status = 301;
Astro.response.headers.set('Location', target);
Astro.response.headers.set('Cache-Control', BLOG_NO_STORE);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={absoluteTarget} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>
			This post has moved. <a href={target}>Continue to the article</a>.
		</p>
	</body>
</html>
