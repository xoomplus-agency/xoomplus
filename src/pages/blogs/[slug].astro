---
/**
 * Blog detail — data from src/data/blogs.ts today.
 * Later: swap getStaticPaths / post lookup to content collections or a CMS;
 * keep this page template and only replace the data source.
 */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedBlogs from '../../components/RelatedBlogs.astro';
import CTASection from '../../components/CTASection.astro';
import { blogs, getBlogBySlug, getRelatedPosts } from '../../data/blogs';
import '../../styles/prose-blog.css';

export function getStaticPaths() {
	return blogs.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { slug } = Astro.params;
const postFromProps = Astro.props.post;
const post = postFromProps ?? (slug ? getBlogBySlug(slug) : undefined);

if (!post) {
	return Astro.redirect('/blogs');
}

const related = getRelatedPosts(post, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: '2-digit',
	year: 'numeric',
}).format(new Date(post.date));

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.title,
	description: post.excerpt,
	image: post.featureImage.src,
	datePublished: post.date,
	author: {
		'@type': 'Person',
		name: post.author.name,
		jobTitle: post.author.role,
	},
};

const faqItems = post.faqs.map((faq, index) => ({
	id: `faq-${index + 1}`,
	question: faq.question,
	answer: faq.answer,
}));
---

<Layout
	title={`${post.title} | Xoomplus`}
	description={post.excerpt}
	image={post.featureImage.src}
	type="article"
	canonicalPath={`/blogs/${post.slug}/`}
	headerTheme="light"
>
	<script slot="json-ld" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

	<main id="main-content" class="blog-detail-main flex-1">
		<Section aria-labelledby="article-title">
			<article class="blog-article">
				<a class="blog-article__back" href="/blogs">
					<svg
						width="14"
						height="14"
						viewBox="0 0 14 14"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M8.5 3.5 5 7l3.5 3.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					Back
				</a>

				<h1
					id="article-title"
					class="blog-article__title text-h1 font-medium tracking-[-0.03em] text-primary-black"
				>
					{post.title}
				</h1>

				<div class="blog-article__meta">
					<div class="blog-article__author">
						<img
							class="blog-article__avatar"
							src={post.author.avatar}
							alt=""
							width="40"
							height="40"
							decoding="async"
						/>
						<div class="blog-article__author-text">
							<span class="blog-article__author-name">{post.author.name}</span>
							<span class="blog-article__author-role">{post.author.role}</span>
						</div>
					</div>

					<div class="blog-article__facts">
						<span class="blog-article__fact">
							<svg
								width="14"
								height="14"
								viewBox="0 0 14 14"
								fill="none"
								aria-hidden="true"
							>
								<rect
									x="2"
									y="3"
									width="10"
									height="9"
									rx="1.5"
									stroke="currentColor"
									stroke-width="1.25"></rect>
								<path
									d="M2 5.5h10M4.5 2v2M9.5 2v2"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-linecap="round"></path>
							</svg>
							<time datetime={post.date}>{formattedDate}</time>
						</span>
						<span class="blog-article__fact">
							<svg
								width="14"
								height="14"
								viewBox="0 0 14 14"
								fill="none"
								aria-hidden="true"
							>
								<circle
									cx="7"
									cy="7"
									r="5.25"
									stroke="currentColor"
									stroke-width="1.25"></circle>
								<path
									d="M7 4.5V7l2 1.25"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							{post.readTime} min read
						</span>
					</div>
				</div>

				<img
					class="blog-article__feature"
					src={post.featureImage.src}
					alt={post.featureImage.alt}
					width="1196"
					height="539"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>

				{/* Real content later: Markdown/MDX or CMS HTML into post.content */}
				<div class="prose-blog blog-article__body" set:html={post.content} />
				<div class="prose-blog blog-article__body" set:html={post.content} />
			</article>
		</Section>

		<!-- {
			faqItems.length > 0 && (
				<FAQ
					items={faqItems}
					pill="FAQ"
					heading="Frequently Asked Questions"
					paragraph="Quick answers to common questions about this topic."
				/>
			)
		} -->

		<RelatedBlogs posts={related} />
		<CTASection />
	</main>
</Layout>

<style>
	/* Clear fixed navbar — no dark hero on this page */
	.blog-detail-main {
		padding-top: 100px;
	}

	.blog-article {
		margin-inline: auto;
		max-width: 1196px;
	}

	.blog-article__back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		box-sizing: border-box;
		padding: 6px 14px;
		border: 1.5px solid transparent;
		border-radius: 9999px;
		background:
			linear-gradient(#ffffff, #ffffff) padding-box,
			linear-gradient(180deg, #d6d6d6 0%, #4a4a4a 100%) border-box;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
		color: #555555;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease;
	}

	.blog-article__back:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	@media (hover: hover) {
		.blog-article__back:hover {
			border: 1.5px solid #ffa800;
			background: #ffffff;
			color: var(--color-primary-black);
		}
	}

	.blog-article__title {
		margin: 24px 0 0;
		text-align: left;
	}

	.blog-article__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 24px;
	}

	.blog-article__author {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}

	.blog-article__avatar {
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}

	.blog-article__author-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.blog-article__author-name {
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.3;
		color: #ffa800;
	}

	.blog-article__author-role {
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.3;
		color: #555555;
	}

	.blog-article__facts {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px;
	}

	.blog-article__fact {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.3;
		color: #555555;
	}

	.blog-article__fact svg {
		flex-shrink: 0;
		display: block;
	}

	.blog-article__feature {
		display: block;
		width: 100%;
		max-width: 1196px;
		height: auto;
		aspect-ratio: 1196 / 539;
		margin-top: 24px;
		border-radius: 20px;
		object-fit: cover;
	}

	.blog-article__body {
		margin-top: 32px;
	}

	@media (max-width: 639px) {
		.blog-detail-main {
			padding-top: 88px;
		}

		.blog-article__meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
