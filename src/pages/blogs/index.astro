---
/**
 * On-demand /blogs listing. First page of `status=publish` posts via wp-posts.
 * Cache-Control: no-store — publish/draft sync after one refresh (no rebuild).
 * Takes priority over CMS [slug].astro for `/blogs`.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout theme="light" seoPath="/blogs">
	<main id="main-content" class="flex-1">
		<PageHero title="Blogs" />
		<BlogListing />
		<CTASection />
	</main>
</Layout>
