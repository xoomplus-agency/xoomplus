---
import Layout from '../../layouts/Layout.astro';
import LocationHero from '../../components/LocationHero.astro';
import LocationIndustries from '../../components/LocationIndustries.astro';
import LocationIntent from '../../components/LocationIntent.astro';
import IndustryFeature from '../../components/IndustryFeature.astro';
import IndustryClarity from '../../components/IndustryClarity.astro';
import IndustryFundamentals from '../../components/IndustryFundamentals.astro';
import FAQ from '../../components/FAQ.astro';
import { industryFundamentals } from '../../data/industry-fundamentals';
import { getLocationBySlug, locations, type Location } from '../../data/locations';
import CTASection from '@/components/CTASection.astro';

export function getStaticPaths() {
	return locations.map((location) => ({
		params: { slug: location.slug },
		props: { location },
	}));
}

interface Props {
	location: Location;
}

const { slug } = Astro.params;
const locationFromProps = Astro.props.location;
const location =
	locationFromProps ?? (slug ? getLocationBySlug(slug) : undefined);

if (!location) {
	return Astro.rewrite('/404');
}

const canonicalPath = `/locations/${location.slug}`;
const {
	hero,
	industries,
	intent,
	rows,
	clarity,
	clarityLight,
	fundamentals,
	faq,
} = location;
---

<Layout
	title={location.metaTitle}
	description={location.metaDescription}
	canonicalPath={canonicalPath}
	image={hero.image}
>
	<main id="main-content" class="page-locations flex-1">
		<LocationHero
			pill={hero.pill}
			pillBrand={hero.pillBrand}
			title={hero.title}
			text={hero.text}
			button={hero.button}
			image={hero.image}
		/>
		{industries ? <LocationIndustries industries={industries} /> : null}
		{intent ? <LocationIntent intent={intent} /> : null}
		{rows ? (
			<IndustryFeature
				id="location-rows"
				rows={rows}
				aria-label="Location highlights"
			/>
		) : null}
		{clarity ? <IndustryClarity section={clarity} /> : null}
		{clarityLight ? <IndustryClarity section={clarityLight} /> : null}
		{/* Falls back to Industries fundamentals when location has no fundamentals */}
		<IndustryFundamentals content={fundamentals ?? industryFundamentals} />
		{faq ? (
			<FAQ
				id={`${location.slug}-faq`}
				pill={faq.pill}
				heading={faq.heading}
				text={faq.text}
				items={faq.items}
			/>
		) : null}
		<CTASection />
		<!-- Location page sections will be added here -->
	</main>
</Layout>

<style is:global>
	/* Location pages only — scoped under .page-locations */

	/* Built around your business — 40px */
	.page-locations .loc-industries__subheading {
		font-size: 40px;
		line-height: 1.15;
	}

	/* Story paragraphs — 18px */
	.page-locations .loc-industries__paragraphs p {
		font-size: 18px;
		line-height: 1.65;
	}

	@media (min-width: 1024px) {
		/* Industries intro — 2 lines */
		.page-locations .loc-industries__intro {
			max-width: min(100%, 820px);
		}

		/* Widen copy column so 18px story paragraphs can hit their line targets */
		.page-locations .loc-industries__grid {
			grid-template-columns: 1.3fr 1fr;
		}

		/* Local intent intro — 3 lines */
		.page-locations .location-intent__intro {
			max-width: 400px;
		}

		/* Clarity intro — 3 lines (beat scoped .industry-clarity--light rule) */
		.page-locations#main-content .industry-clarity__intro,
		.page-locations#main-content .industry-clarity--light .industry-clarity__intro {
			max-width: 380px;
		}

		/* Fundamentals intro — 2 lines */
		.page-locations .industry-fundamentals__intro {
			max-width: 460px;
		}

		/* Image-text rows — widen copy for 2-line body paragraphs */
		.page-locations
			#location-rows
			.industry-feature__layout--rows.industry-feature__layout--image-left {
			grid-template-columns: 1fr 1.35fr;
		}

		.page-locations
			#location-rows
			.industry-feature__layout--rows.industry-feature__layout--image-right {
			grid-template-columns: 1.35fr 1fr;
		}

		.page-locations #location-rows .industry-feature__row-p1 {
			max-width: 640px;
		}
	}
</style>
