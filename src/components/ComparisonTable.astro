---
/**
 * Comparison matrix table — same visual language as ServiceDetail (Organic Authority),
 * without links or arrow column.
 */
import Section from './Section.astro';
import type { ComparisonTableContent } from '../data/comparison-table';

interface Props {
	content: ComparisonTableContent;
}

const { content } = Astro.props;
const headingId = `${content.id}-heading`;
const [colLabel, colOne, colTwo, colThree] = content.columns;
const caption = `${content.pill} comparison`;
---

<Section id={content.id} aria-labelledby={headingId} class="comparison-table">
	<div class="ct-header" data-reveal="up">
		<div class="ct-header__intro">
			<p class="pill-light m-0">{content.pill}</p>
			<h2
				id={headingId}
				class="ct-header__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				{
					content.title.map((line, index) => (
						<>
							{index > 0 ? <br /> : null}
							{line}
						</>
					))
				}
			</h2>
		</div>
		{content.intro ? <p class="ct-header__aside text-on-light m-0">{content.intro}</p> : null}
	</div>

	<table class="ct-table">
		<caption class="sr-only">{caption}</caption>
		<colgroup>
			<col style="width: 18%" />
			<col style="width: 27.333%" />
			<col style="width: 27.333%" />
			<col style="width: 27.333%" />
		</colgroup>
		<thead>
			<tr>
				<th scope="col">{colLabel}</th>
				<th scope="col">{colOne}</th>
				<th scope="col">{colTwo}</th>
				<th scope="col">{colThree}</th>
			</tr>
		</thead>
		<tbody>
			{
				content.rows.map((row) => (
					<tr>
						<th scope="row">{row.label}</th>
						<td data-label={colOne}>{row.values[0]}</td>
						<td data-label={colTwo}>{row.values[1]}</td>
						<td data-label={colThree}>{row.values[2]}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</Section>

<style>
	:global(section.comparison-table) {
		scroll-margin-top: calc(80px + 16px);
	}

	.ct-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 20px;
	}

	.ct-header__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		max-width: 820px;
	}

	.ct-header__heading {
		margin-top: 16px;
	}

	.ct-header__aside {
		max-width: 640px;
		text-align: center;
	}

	.ct-table {
		width: 100%;
		margin-top: 40px;
		border-collapse: collapse;
		table-layout: fixed;
	}

	.ct-table th,
	.ct-table td {
		border-left: none;
		border-right: none;
		text-align: left;
		vertical-align: middle;
	}

	.ct-table thead th {
		padding: 20px 16px 20px 0;
		border-top: 1px solid #e9e9e7;
		border-bottom: 1px solid #e9e9e7;
		font-family: var(--font-inter);
		font-size: var(--text-lead);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--color-text-on-light);
	}

	.ct-table thead th:last-child {
		padding-right: 0;
	}

	.ct-table tbody th,
	.ct-table tbody td {
		padding: 22px 16px 22px 0;
		border-bottom: 1px solid #e9e9e7;
	}

	.ct-table tbody td:last-child {
		padding-right: 0;
	}

	.ct-table tbody th {
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		font-size: var(--text-h3);
		font-weight: 500;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.ct-table tbody td {
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	@media (hover: hover) {
		.ct-table tbody tr:hover {
			background-color: #fafaf8;
		}
	}

	@media (max-width: 1023px) {
		.ct-table thead th {
			font-size: var(--text-small);
			padding: 16px 12px 16px 0;
		}

		.ct-table tbody th {
			font-size: var(--text-h3-sm);
		}
	}

	@media (max-width: 900px) {
		.ct-table {
			display: block;
		}

		.ct-table colgroup,
		.ct-table thead {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.ct-table tbody,
		.ct-table tr,
		.ct-table th,
		.ct-table td {
			display: block;
			width: 100%;
		}

		.ct-table tbody tr {
			padding: 20px 0;
			border-top: none;
		}

		.ct-table tbody tr:first-child {
			border-top: 1px solid #e9e9e7;
		}

		.ct-table tbody th,
		.ct-table tbody td {
			padding: 0;
			border: none;
		}

		.ct-table tbody th {
			margin-bottom: 12px;
			font-size: var(--text-h3-sm);
		}

		.ct-table tbody td {
			margin-top: 10px;
		}

		.ct-table tbody td::before {
			content: attr(data-label);
			display: block;
			margin-bottom: 4px;
			font-family: var(--font-inter);
			font-size: 12px;
			font-weight: 600;
			line-height: 1.3;
			letter-spacing: 0.02em;
			text-transform: uppercase;
			color: var(--color-text-on-light);
		}

		@media (hover: hover) {
			.ct-table tbody tr:hover {
				background-color: transparent;
			}
		}
	}

</style>
