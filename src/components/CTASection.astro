---
import Button from './Button.astro';
import ButtonOutline from './ButtonOutline.astro';
import { SITE_EMAIL } from '../data/site-contact';

interface Props {
	/** Pre-header pill. Default keeps existing site CTA copy. */
	pill?: string;
	heading?: string;
	text?: string;
	buttonHref?: string;
	buttonLabel?: string;
	/** Optional outline secondary button (between primary and email). */
	secondaryButtonHref?: string;
	secondaryButtonLabel?: string;
	/** Optional secondary link (defaults to email). Homepage can pass View Services. */
	secondaryHref?: string;
	secondaryLabel?: string;
	/** Compact card for in-article placement (no page-section / container). */
	embedded?: boolean;
	id?: string;
}

const {
	pill = 'Your next chapter',
	heading: headingProp,
	text = "Tell us what you're working towards. We'll explore the challenge, the possibilities and the right place to start.",
	buttonHref = '#contact',
	buttonLabel = 'Discuss your project',
	secondaryButtonHref,
	secondaryButtonLabel,
	secondaryHref = SITE_EMAIL.href,
	secondaryLabel = SITE_EMAIL.display,
	embedded = false,
	id = embedded ? 'blog-cta' : 'cta',
} = Astro.props;
const hasSecondaryButton = Boolean(secondaryButtonLabel && secondaryButtonHref);

/** Site CTA keeps the design default heading; blog/embedded only shows a WP-provided heading. */
const heading = embedded
	? (headingProp?.trim() || '')
	: (headingProp?.trim() || "Let's move your business forward.");
const headingId = `${id}-heading`;
---

{
	embedded ? (
		<div
			class="cta-card cta-card--embedded"
			style="background-image: url('/images/cta-bg-image.webp')"
			aria-label="Call to action"
		>
			<div class="cta-card__inner">
				<div class="cta-card__left" data-reveal="up">
					{
						heading ? (
							<h2 id={headingId} class="cta-card__heading text-hero-h1 m-0">
								{heading}
							</h2>
						) : null
					}
					<p class:list={['cta-card__copy', 'm-0', heading && 'cta-card__copy--after-heading']}>
						{text}
					</p>
				</div>
				<div class="cta-card__right">
					<Button href={buttonHref}>{buttonLabel}</Button>
					{
						hasSecondaryButton ? (
							<ButtonOutline
								variant="outline-dark"
								href={secondaryButtonHref}
								class="cta-card__secondary"
							>
								<span>{secondaryButtonLabel}</span>
							</ButtonOutline>
						) : null
					}
					<a class="cta-card__email" href={secondaryHref}>{secondaryLabel}</a>
				</div>
			</div>
		</div>
	) : (
		<section
			id={id}
			data-bg="dark"
			class="page-section bg-secondary-white py-section"
			aria-labelledby={headingId}
		>
			<div class="container">
				<div
					class="cta-card"
					style="background-image: url('/images/cta-bg-image.webp')"
				>
					<div class="cta-card__inner">
						<div class="cta-card__left" data-reveal="up">
							<p class="pill-dark text-primary m-0">{pill}</p>
							<h2 id={headingId} class="cta-card__heading text-hero-h1 m-0 mt-4">
								{heading}
							</h2>
							<p class="cta-card__copy m-0">{text}</p>
						</div>
						<div class="cta-card__right">
							<Button href={buttonHref}>
								{buttonLabel}
							</Button>
							{
								hasSecondaryButton ? (
									<ButtonOutline
										variant="outline-dark"
										href={secondaryButtonHref}
										class="cta-card__secondary"
									>
										<span>{secondaryButtonLabel}</span>
									</ButtonOutline>
								) : null
							}
							<a class="cta-card__email" href={secondaryHref}>{secondaryLabel}</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	)
}

<style>
	.cta-card {
		box-sizing: border-box;
		overflow: hidden;
		width: 100%;
		min-height: 196px;
		border-radius: 30px;
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}

	.cta-card--embedded {
		margin: 32px 0 0;
		border-radius: 24px;
	}

	.cta-card__inner {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 48px;
		box-sizing: border-box;
		min-height: 196px;
		padding: var(--card-padding);
	}

	.cta-card__left {
		display: flex;
		flex: 1 1 auto;
		min-width: 0;
		max-width: min(100%, 42rem);
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
	}

	/* Hero gradient style; display-scale size (small mobile → 42px desktop) */
	.cta-card__heading {
		font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.625rem); /* ~28px → 42px */
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-align: left;
		max-width: none;
		margin-inline: 0;
	}

	/* Blog/embedded CTA: hero gradient treatment at fixed 36px */
	.cta-card--embedded .cta-card__heading {
		font-size: 36px;
		line-height: 1.25;
	}

	.cta-card__copy {
		max-width: 65ch;
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: var(--text-body--font-weight);
		line-height: var(--text-body--line-height);
		text-wrap: pretty;
		color: var(--text-body-dark);
	}

	.cta-card__copy--after-heading,
	.cta-card__left > .pill-dark + .cta-card__heading + .cta-card__copy,
	.cta-card__left > .cta-card__heading + .cta-card__copy {
		margin-top: 0.5em;
	}

	.cta-card__right {
		display: flex;
		flex: 0 0 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}

	/* Match primary CTA height (layout only — reuses outline-dark styles) */
	.cta-card__right :global(.cta-card__secondary) {
		height: 52px;
		min-width: 220px;
		padding-inline: 28px;
		white-space: nowrap;
	}

	.cta-card__email {
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-body-dark);
		text-decoration: none;
	}

	.cta-card__email:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
		border-radius: 2px;
	}

	@media (hover: hover) {
		.cta-card__email:hover {
			color: #ffa800;
		}
	}

	@media (max-width: 1023px) {
		.cta-card {
			border-radius: 24px;
		}

		.cta-card__inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 28px;
			padding: 32px 24px;
		}

		.cta-card__right {
			align-items: flex-start;
			width: 100%;
		}

		.cta-card__right :global(.btn),
		.cta-card__right :global(.cta-card__secondary) {
			width: 100%;
		}
	}
</style>
