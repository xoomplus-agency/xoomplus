---
import { getAllWpPageRoutes, WP_PAGE_FALLBACK_ROUTES } from '../lib/wp-seo';

const year = new Date().getFullYear();

const routes = await getAllWpPageRoutes();
const byKey = new Map(routes.map((r) => [r.key, r.route]));
const aboutHref = byKey.get('about') ?? WP_PAGE_FALLBACK_ROUTES.about;
const servicesHref = byKey.get('services') ?? WP_PAGE_FALLBACK_ROUTES.services;
const industriesHref = byKey.get('industries') ?? WP_PAGE_FALLBACK_ROUTES.industries;
const caseStudiesHref = byKey.get('caseStudies') ?? WP_PAGE_FALLBACK_ROUTES.caseStudies;
const contactHref = byKey.get('contact') ?? WP_PAGE_FALLBACK_ROUTES.contact;
const blogsHref = byKey.get('blogs') ?? WP_PAGE_FALLBACK_ROUTES.blogs;
if (routes.length === 0) {
	console.error('[footer] live CMS paths unavailable — using fallback routes');
}

const linkColumns = [
	{
		title: 'Company',
		ariaLabel: 'Company',
		links: [
			{ label: 'About', href: aboutHref },
			{ label: 'Services', href: servicesHref },
			{ label: 'Industries', href: industriesHref },
			{ label: 'Case Studies', href: caseStudiesHref },
			{ label: 'Pricing', href: '/pricing' },
			{ label: 'Contact', href: contactHref },
			{ label: 'Blog', href: blogsHref },
		],
	},
	{
		title: 'Services',
		ariaLabel: 'Services',
		links: [
			{ label: 'SEO', href: '/services/seo' },
			{ label: 'Web Design & Development', href: '/services/web-design-development' },
			{ label: 'Social Media Marketing', href: '/services/social-media-marketing' },
			{ label: 'PPC & Google Ads', href: '/services/ppc-google-ads' },
		],
	},
];

const locationLinks = [
	{ label: 'Blackburn', href: '/locations/blackburn' },
	{ label: 'Manchester', href: '/locations/manchester' },
];

const socialLinks = [
	{ label: 'Facebook', href: 'https://www.facebook.com/xoomplus1/', icon: '/icons/footer-facebook.svg' },
	{ label: 'Instagram', href: 'https://www.instagram.com/xoomplus1/', icon: '/icons/footer-instagram.svg' },
	// { label: 'X', href: '#', icon: '/icons/footer-x.svg' },
	{ label: 'LinkedIn', href: 'https://pk.linkedin.com/company/xoomplus', icon: '/icons/footer-linkedin.svg' },
];

const legalLinks = [{ label: 'Privacy Policy', href: '/privacy-policy/' }];
---

<footer class="site-footer">
	<img
		class="site-footer__plus"
		src="/icons/plus-icon.svg"
		alt=""
		aria-hidden="true"
		width="164"
		height="147"
		decoding="async"
	/>

	<div class="site-footer__inner container container--wide">
		<div class="site-footer__grid">
			<div class="site-footer__brand">
				<a href="/" aria-label="Xoomplus home" class="site-footer__logo-link">
					<img
						src="/images/logo-xoomplus.webp"
						alt="Xoomplus"
						width="202"
						height="47"
						class="site-footer__logo"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<p class="site-footer__desc">
					XoomPlus helps UK businesses attract the right audience, generate quality leads and
					turn clicks into customers through our strategic digital marketing and web design
					services.
				</p>
			</div>

			{
				linkColumns.map((column) => (
					<nav class="site-footer__col" aria-label={column.ariaLabel}>
						<h3 class="site-footer__heading">{column.title}</h3>
						<ul class="site-footer__list">
							{column.links.map((link) => (
								<li>
									<a class="site-footer__link" href={link.href}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}

			<div class="site-footer__col site-footer__col--locations">
				<nav aria-label="Locations">
					<h3 class="site-footer__heading">Locations</h3>
					<ul class="site-footer__list">
						{
							locationLinks.map((link) => (
								<li>
									<a class="site-footer__link" href={link.href}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="site-footer__social-block" aria-label="Social Links">
					<h3 class="site-footer__heading">Social Links</h3>
					<ul class="site-footer__social-list">
						{
							socialLinks.map((social) => (
								<li>
									<a
										class="site-footer__social"
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={social.label}
									>
										<img
											src={social.icon}
											alt=""
											aria-hidden="true"
											width="30"
											height="30"
											decoding="async"
										/>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="site-footer__copy">© {year} Xoomplus. All rights reserved.</p>
			<nav aria-label="Legal">
				<ul class="site-footer__legal">
					{
						legalLinks.map((link) => (
							<li>
								<a class="site-footer__legal-link" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		width: 100%;
		padding-block: 2.75rem 1.5rem;
		background-color: var(--color-primary-black);
		font-family: var(--font-inter);
		/* Unitless so children inherit 150% of their own font-size */
		line-height: 1.5;
	}

	.site-footer__plus {
		position: absolute;
		right: -40px;
		bottom: -28px;
		z-index: 0;
		display: block;
		width: 164px;
		height: 147px;
		/* SVG already has fill-opacity ~0.1; keep CSS opacity high so it stays visible */
		opacity: 1;
		pointer-events: none;
		user-select: none;
	}

	.site-footer__inner {
		position: relative;
		z-index: 1;
		width: 100%;
	}

	.site-footer__grid {
		display: grid;
		/* Brand | Company | Services | Locations — last col ≥ ~150px for social icons */
		grid-template-columns: 1.4fr 1fr 1.35fr 1fr;
		column-gap: 28px;
		align-items: start;
	}

	.site-footer__logo-link {
		display: inline-block;
	}

	.site-footer__logo {
		display: block;
		width: 202px;
		height: 47px;
	}

	.site-footer__desc {
		margin: 20px 0 0;
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	.site-footer__heading {
		margin: 0 0 18px;
		font-family: var(--font-inter);
		font-size: var(--text-small-heading);
		font-weight: var(--text-small-heading--font-weight);
		line-height: var(--text-small-heading--line-height);
		color: #ffffff;
	}

	.site-footer__list {
		display: flex;
		flex-direction: column;
		gap: 7px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__link {
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: var(--text-body--font-weight);
		color: #888888;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.site-footer__link:focus-visible,
	.site-footer__legal-link:focus-visible,
	.site-footer__social:focus-visible,
	.site-footer__logo-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.site-footer__social-block {
		margin-top: 28px;
	}

	.site-footer__social-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__social {
		/* SVGs already include amber circle + glyph — size the asset to 30×30 */
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 30px;
		height: 30px;
		overflow: hidden;
		border-radius: 50%;
		background-color: transparent;
		transition: background-color 0.2s ease;
	}

	.site-footer__social img {
		display: block;
		width: 30px;
		height: 30px;
		transition: filter 0.2s ease;
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 12px;
		padding-top: 16px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.site-footer__copy,
	.site-footer__legal-link {
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		color: #888888;
	}

	.site-footer__copy {
		margin: 0;
	}

	.site-footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__legal-link {
		text-decoration: none;
		transition: color 0.2s ease;
	}

	@media (hover: hover) {
		.site-footer__link:hover,
		.site-footer__legal-link:hover {
			color: var(--color-primary);
		}

		.site-footer__social:hover {
			background-color: var(--color-primary);
		}

		.site-footer__social:hover img {
			/* Amber SVG → black on amber fill */
			filter: brightness(0);
		}
	}

	/* Desktop wide: long links stay on one line */
	@media (min-width: 1280px) {
		.site-footer__tagline-line {
			white-space: nowrap;
		}

		.site-footer__link {
			white-space: nowrap;
		}
	}

	/* Desktop narrow: allow long links to wrap; keep 4-col grid intact */
	@media (min-width: 1024px) and (max-width: 1279px) {
		.site-footer__grid {
			/* Brand ≥202px logo; Locations ≥150px social row */
			grid-template-columns: 1.25fr 0.85fr 1.2fr 1fr;
			column-gap: 20px;
		}

		.site-footer__tagline-line {
			white-space: nowrap;
		}
	}

	@media (max-width: 1023px) {
		.site-footer {
			padding: 40px 32px 24px;
		}

		.site-footer__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 32px;
		}

		.site-footer__brand {
			grid-column: 1 / -1;
		}
	}

	/* Tablet: gutters from .container only; brand → 2×2 links → Locations/Social full width */
	@media (min-width: 640px) and (max-width: 1023px) {
		.site-footer {
			padding-left: 0;
			padding-right: 0;
		}

		.site-footer__col--locations {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 639px) {
		.site-footer {
			padding: 40px 20px 24px;
		}

		.site-footer__grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 28px 24px;
		}

		.site-footer__brand {
			grid-column: 1 / -1;
		}

		.site-footer__col--locations {
			grid-column: 1 / -1;
		}

		.site-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}

		.site-footer__legal {
			gap: 12px;
		}
	}

	@media (max-width: 380px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
