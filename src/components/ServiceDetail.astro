---
import Section from './Section.astro';
import { getServiceDetail } from '../data/services-detail';
import { getChildHrefByName } from '../data/main-services';

interface Props {
	serviceId: string;
}

const { serviceId } = Astro.props;
const service = getServiceDetail(serviceId);

if (!service) {
	throw new Error(`Unknown service detail id: ${serviceId}`);
}

/** Map overview detail section ids → main service slugs for child href lookup. */
const detailToMainSlug: Record<string, string> = {
	seo: 'seo',
};

const mainSlug = detailToMainSlug[service.id];
const headingId = `${service.id}-heading`;
const [titleLine1, titleLine2] = service.title;
const [colCapability, colHelps, colScope] = service.columns;
const caption = `${service.pill} capabilities, what each helps address and the scope to explore`;
---

<Section
	id={service.id}
	aria-labelledby={headingId}
	class="service-detail"
>
	<div class="sd-header" data-reveal="up">
		<div class="sd-header__intro">
			<p class="pill-light m-0">{service.pill}</p>
			<h2
				id={headingId}
				class="sd-header__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				{titleLine1}<br />
				{titleLine2}
			</h2>
		</div>
		<p class="sd-header__aside text-on-light m-0">{service.intro}</p>
	</div>

	<table class="sd-table">
		<caption class="sr-only">{caption}</caption>
		<colgroup>
			<col class="sd-table__col sd-table__col--1" />
			<col class="sd-table__col sd-table__col--2" />
			<col class="sd-table__col sd-table__col--3" />
		</colgroup>
		<thead>
			<tr>
				<th scope="col">{colCapability}</th>
				<th scope="col">{colHelps}</th>
				<th scope="col">{colScope}</th>
			</tr>
		</thead>
		<tbody>
			{
				service.rows.map((row) => {
					const href = mainSlug ? getChildHrefByName(mainSlug, row.capability) : undefined;
					return (
						<tr>
							<th scope="row">
								{href ? (
									<a class="sd-table__capability-link" href={href}>
										{row.capability}
									</a>
								) : (
									row.capability
								)}
							</th>
							<td data-label={colHelps}>{row.helps}</td>
							<td data-label={colScope}>{row.scope}</td>
						</tr>
					);
				})
			}
		</tbody>
	</table>

	<div class="sd-note" role="note">
		<div class="sd-note__content">
			<p class="sd-note__text m-0">{service.note}</p>
		</div>
	</div>
</Section>

<style>
	/* Clear fixed navbar when jumping from overview card anchors */
	:global(section.service-detail) {
		scroll-margin-top: calc(80px + 16px);
	}

	.sd-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.sd-header__intro {
		min-width: 0;
	}

	.sd-header__heading {
		margin-top: 16px;
	}

	.sd-header__aside {
		flex-shrink: 0;
		max-width: 430px;
		text-align: left;
	}

	.sd-table {
		width: 100%;
		margin-top: 40px;
		border-collapse: collapse;
		table-layout: fixed;
	}

	.sd-table__col--1 {
		width: 26%;
	}

	.sd-table__col--2 {
		width: 34%;
	}

	.sd-table__col--3 {
		width: 40%;
	}

	.sd-table th,
	.sd-table td {
		border-left: none;
		border-right: none;
		text-align: left;
		vertical-align: middle;
	}

	.sd-table thead th {
		padding: 20px 0;
		border-top: 1px solid #e9e9e7;
		border-bottom: 1px solid #e9e9e7;
		font-family: var(--font-inter);
		font-size: var(--text-lead);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--color-text-on-light);
	}

	.sd-table tbody th,
	.sd-table tbody td {
		padding: 22px 24px 22px 0;
		border-bottom: 1px solid #e9e9e7;
	}

	.sd-table tbody td:last-child {
		padding-right: 0;
	}

	.sd-table tbody th {
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		font-size: var(--text-h3);
		font-weight: 500;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.sd-table__capability-link {
		color: inherit;
		text-decoration: none;
	}

	.sd-table__capability-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.sd-table__capability-link:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	.sd-table tbody td {
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	@media (hover: hover) {
		.sd-table tbody tr:hover {
			background-color: #fafaf8;
		}
	}

	.sd-note {
		display: flex;
		align-items: center;
		width: 100%;
		min-height: 90px;
		margin-top: 40px;
		padding: 20px 32px 20px 24px;
		border-radius: 20px;
		background-color: #f7f7f5;
		overflow: hidden;
	}

	.sd-note__content {
		position: relative;
		padding-left: 19px; /* 3px bar + 16px gap */
	}

	.sd-note__content::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 3px;
		border-radius: 2px;
		background-color: var(--color-primary);
		pointer-events: none;
	}

	.sd-note__text {
		font-family: var(--font-inter);
		font-size: var(--text-lead);
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	@media (max-width: 1023px) {
		.sd-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.sd-header__aside {
			max-width: 100%;
		}

		.sd-table thead th {
			font-size: var(--text-small);
			padding: 16px 0;
		}

		.sd-table tbody th {
			font-size: var(--text-h3-sm);
		}
	}

	/*
	 * Stacked cards from 900px down — 3-column table gets cramped
	 * between tablet and mobile with long capability names.
	 */
	@media (max-width: 900px) {
		.sd-table {
			display: block;
		}

		.sd-table colgroup,
		.sd-table thead {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.sd-table tbody,
		.sd-table tr,
		.sd-table th,
		.sd-table td {
			display: block;
			width: 100%;
		}

		.sd-table tbody tr {
			padding: 20px 0;
			border-top: none;
		}

		.sd-table tbody tr:first-child {
			border-top: 1px solid #e9e9e7;
		}

		.sd-table tbody th,
		.sd-table tbody td {
			padding: 0;
			border: none;
		}

		.sd-table tbody th {
			margin-bottom: 12px;
			font-size: var(--text-h3-sm);
		}

		.sd-table tbody td {
			margin-top: 10px;
		}

		.sd-table tbody td::before {
			content: attr(data-label);
			display: block;
			margin-bottom: 4px;
			font-family: var(--font-inter);
			font-size: 12px;
			font-weight: 600;
			line-height: 1.3;
			letter-spacing: 0.02em;
			text-transform: uppercase;
			color: var(--color-text-on-light);
		}

		@media (hover: hover) {
			.sd-table tbody tr:hover {
				background-color: transparent;
			}
		}
	}

	@media (max-width: 639px) {
		.sd-note {
			min-height: auto;
			padding: 20px;
		}

		.sd-note__text {
			font-size: clamp(1rem, 4vw, 1.125rem); /* ~16–18px */
		}
	}
</style>
