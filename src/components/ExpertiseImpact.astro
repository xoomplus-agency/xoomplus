---
import Section from './Section.astro';

const stats = [
	{ value: '99%', label: 'Client Satisfaction' },
	{ value: '99%', label: 'Client Satisfaction' },
	{ value: '500+', label: 'Proven Results' },
	{ value: '2k+', label: 'Happy Clients' },
];
---

<Section aria-labelledby="expertise-heading">
	<div class="expertise-header">
		<p class="pill-light mb-5">Our Expertise & Impact</p>
		<h2
			id="expertise-heading"
			class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
		>
			Driving Digital Success with Proven Strategies
		</h2>
		<p class="expertise-intro text-on-light mx-auto max-w-[1100px]">
			At XoomPlus, we combine creativity, technology, and data to deliver exceptional results. From
			innovative marketing campaigns to{' '}
			<br class="expertise-intro__break" />high-performance websites, we help businesses build strong
			digital footprints, increase brand awareness, and maximize ROI.
		</p>
	</div>

	<ul class="expertise-grid m-0 list-none p-0" role="list">
		{
			stats.map((stat) => (
				<li class="surface-card expertise-card">
					<span class="expertise-card__value">{stat.value}</span>
					<span class="expertise-card__label">{stat.label}</span>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.expertise-header {
		max-width: 1100px;
		margin-inline: auto;
		text-align: center;
	}

	/* Keep intro on 2 lines from tablet-up; allow natural wrap on small mobile */
	@media (max-width: 639px) {
		.expertise-intro__break {
			display: none;
		}
	}

	/* pb leaves room so card shadows (Y 8 / blur 24) are not clipped */
	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin-top: 40px;
		padding-bottom: 24px;
		align-items: stretch;
	}

	.expertise-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 12px;
		text-align: center;
	}

	.expertise-card__value {
		font-family: var(--font-inter);
		font-size: 52px;
		font-weight: 700;
		line-height: 1.1;
		color: #ffa800;
	}

	.expertise-card__label {
		font-family: var(--font-inter);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.expertise-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 639px) {
		.expertise-grid {
			grid-template-columns: 1fr;
		}

		.expertise-card {
			padding: 32px 20px;
		}

		.expertise-card__value {
			font-size: clamp(2.5rem, 10vw, 2.75rem); /* ~40–44px */
		}

		.expertise-card__label {
			font-size: clamp(1.125rem, 4.5vw, 1.25rem); /* ~18–20px */
		}
	}
</style>
