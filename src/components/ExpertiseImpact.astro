---
import Section from './Section.astro';

const stats = [
	{ value: '43', label: 'Happy Clients' },
	{ value: '250+', label: 'Bespoke Digital Projects Delivered' },
	{ value: '4.2x', label: 'Average Campaign Return on Investment (ROAS)' },
	{ value: '100%', label: 'In-House Senior Team' },
];
---

<Section aria-labelledby="expertise-heading">
	<div class="expertise-header" data-reveal="up">
		<p class="pill-light mb-5">Performance & Delivery Metrics</p>
		<h2
			id="expertise-heading"
			class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
		>
			Verified Performance Across the UK Commercial Landscape
		</h2>
		<p class="expertise-intro text-on-light mx-auto max-w-[1100px]">
			Our confidence comes from our clients’ success, and our numbers speak volumes about our refined
			methods. We don’t measure impressions on posts; we measure the smile on our clients’ faces.
		</p>
	</div>

	<ul class="expertise-grid m-0 list-none p-0" role="list" data-reveal-group>
		{
			stats.map((stat) => (
				<li class="surface-card expertise-card" data-reveal="up">
					<span class="expertise-card__value">{stat.value}</span>
					<span class="expertise-card__label">{stat.label}</span>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.expertise-header {
		max-width: 1100px;
		margin-inline: auto;
		text-align: center;
	}

	/* Keep intro on 2 lines from tablet-up; allow natural wrap on small mobile */
	@media (max-width: 639px) {
		.expertise-intro__break {
			display: none;
		}
	}

	/* pb leaves room so card shadows (Y 8 / blur 24) are not clipped */
	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin-top: 40px;
		padding-bottom: 24px;
		align-items: stretch;
	}

	.expertise-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 12px;
		text-align: center;
	}

	.expertise-card__value {
		font-family: var(--font-inter);
		font-size: var(--text-display);
		font-weight: 700;
		line-height: var(--text-display--line-height);
		color: #ffa800;
	}

	.expertise-card__label {
		font-family: var(--font-inter);
		font-size: var(--text-h3-sm);
		font-weight: 400;
		line-height: var(--text-h3-sm--line-height);
		color: var(--color-primary-black);
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.expertise-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 639px) {
		.expertise-grid {
			grid-template-columns: 1fr;
		}

		.expertise-card {
			padding: 32px 20px;
		}

	}
</style>
