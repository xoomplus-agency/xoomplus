---
import type { CaseStudy } from '../../data/caseStudies';

interface Props {
	title: CaseStudy['title'];
	highlight: CaseStudy['highlight'];
	description: CaseStudy['description'];
	heroPill: CaseStudy['heroPill'];
	heroImage?: CaseStudy['heroImage'];
	liveUrl: CaseStudy['liveUrl'];
	client: CaseStudy['client'];
	industry: CaseStudy['industry'];
	location: CaseStudy['location'];
	services: CaseStudy['services'];
}

const {
	title,
	highlight,
	description,
	heroPill,
	heroImage = '/images/case-study-hero.webp',
	liveUrl,
	client,
	industry,
	location,
	services,
} = Astro.props;

const headingId = 'case-study-hero-heading';

const meta = [
	{ label: 'Client', value: client },
	{ label: 'Industry', value: industry },
	{ label: 'Location', value: location },
	{ label: 'Services', value: services },
] as const;
---

<section
	class="case-study-hero page-section page-section--flush-top"
	data-bg="dark"
	aria-labelledby={headingId}
>
	<img
		class="case-study-hero__media"
		src={heroImage}
		alt=""
		width="1920"
		height="1080"
		fetchpriority="high"
		decoding="async"
		aria-hidden="true"
	/>

	<div class="case-study-hero__inner container" data-hero-enter>
		<div class="case-study-hero__copy">
			<p class="pill-dark mb-5 text-[#ff9a3c]" data-hero-item>{heroPill}</p>
			<h1 id={headingId} class="text-hero-h1 case-study-hero__title mx-auto mb-[0.5em]" data-hero-item>
				<span class="case-study-hero__title-line">{title}</span>
				<span class="case-study-hero__title-line">{highlight}</span>
			</h1>
			<p class="case-study-hero__desc m-0" data-hero-item>
				{
					description.map((line) => (
						<span class="case-study-hero__desc-line">{line}</span>
					))
				}
			</p>
			<div class="case-study-hero__actions" data-hero-item>
				<a
					class="btn inline-flex items-center justify-center box-border rounded-button px-[28px] py-[18px] text-primary-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="btn__label inline-flex items-center justify-center gap-2">
						Visit Live Website
					</span>
				</a>
				<a
					class="case-study-hero__link text-[0.98rem] font-medium tracking-[-0.01em] text-secondary-white no-underline hover:opacity-90"
					href="#case-study-content"
				>
					Explore Our Services ↓
				</a>
			</div>
		</div>

		<div class="case-study-hero__meta-wrap" data-hero-item>
			<hr class="case-study-hero__divider" />
			<dl class="case-study-hero__meta m-0">
				{
					meta.map((item) => (
						<div class="case-study-hero__meta-item">
							<dt class="case-study-hero__meta-label m-0">{item.label}</dt>
							<dd class="case-study-hero__meta-value m-0">{item.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>

<style>
	.case-study-hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 100%;
		min-height: 780px;
		height: auto;
		overflow: hidden;
		padding-top: calc(80px + 56px);
		padding-bottom: 72px;
		margin-bottom: 0;
		text-align: center;
		background-color: var(--color-primary-black);
		color: var(--color-secondary-white);
	}

	.case-study-hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		pointer-events: none;
	}

	/* Dark scrim so white hero copy stays readable over bright portfolio BGs */
	.case-study-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: rgba(0, 0, 0, 0.7);
	}

	@media (max-width: 639px) {
		.case-study-hero::after {
			background: rgba(0, 0, 0, 0.88);
		}
	}

	.case-study-hero__inner {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: clamp(2.5rem, 6vh, 4rem);
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px))
			max(var(--gutter), env(safe-area-inset-right, 0px));
	}

	.case-study-hero__copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		padding-inline: 0;
	}

	.case-study-hero__copy :global(.pill-dark) {
		max-width: 100%;
		white-space: normal;
		text-wrap: balance;
	}

	.case-study-hero__title {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		font-size: clamp(1.75rem, 1.2rem + 2.5vw, 3.75rem);
		overflow-wrap: break-word;
	}

	.case-study-hero__title-line {
		display: block;
		max-width: 100%;
	}

	@media (min-width: 1280px) {
		.case-study-hero__title {
			font-size: 60px;
		}
	}

	.case-study-hero__desc {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		margin-bottom: 1.75rem;
		padding-inline: 0;
		font-family: var(--font-inter);
		font-size: 1.125rem;
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: #c4c4c4;
		text-align: center;
		overflow-wrap: break-word;
	}

	.case-study-hero__desc-line {
		display: block;
		max-width: 100%;
	}

	/* Desktop: keep the three authored lines as single lines when they fit */
	@media (min-width: 1200px) {
		.case-study-hero__desc-line {
			white-space: nowrap;
		}
	}

	.case-study-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.75rem;
		max-width: 100%;
	}

	.case-study-hero__meta-wrap {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		text-align: left;
	}

	.case-study-hero__divider {
		width: 100%;
		height: 0;
		margin: 0 0 1.75rem;
		border: 0;
		border-top: 1px solid rgb(255 255 255 / 0.15);
	}

	.case-study-hero__meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem 1.25rem;
	}

	.case-study-hero__meta-label {
		margin-bottom: 0.5rem;
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #b8b8b8;
	}

	.case-study-hero__meta-value {
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 400;
		line-height: 1.4;
		color: #ffffff;
		overflow-wrap: anywhere;
	}

	@media (max-width: 1023px) {
		.case-study-hero {
			min-height: 0;
			padding-bottom: 56px;
		}

		.case-study-hero__meta {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.case-study-hero__desc {
			font-size: 1rem;
		}
	}

	@media (max-width: 639px) {
		.case-study-hero {
			padding-top: calc(72px + 40px);
			padding-bottom: 48px;
		}

		.case-study-hero__inner {
			padding-inline: max(1.25rem, var(--gutter), env(safe-area-inset-left, 0px))
				max(1.25rem, var(--gutter), env(safe-area-inset-right, 0px));
		}

		.case-study-hero__actions {
			flex-direction: column;
			gap: 1rem;
		}

		.case-study-hero__meta {
			grid-template-columns: minmax(0, 1fr);
		}

		.case-study-hero__desc {
			font-size: 0.95rem;
		}
	}
</style>
