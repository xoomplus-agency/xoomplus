---
import Section from '../Section.astro';
import type { CaseStudyChallenge } from '../../data/caseStudies';

interface Props extends CaseStudyChallenge {}

const { pill, heading, paragraph, cards } = Astro.props;
const headingId = 'case-study-challenge-heading';
---

<Section
	id="case-study-challenge"
	background="light-gray"
	aria-labelledby={headingId}
>
	<div class="cs-challenge__header mx-auto mb-12 text-center lg:mb-14" data-reveal="up">
		<p class="pill-light mb-5">{pill}</p>
		<h2
			id={headingId}
			class="cs-challenge__heading mx-auto mb-4 max-w-[820px] text-h2 font-semibold tracking-[-0.02em] text-primary-black"
		>
			{heading}
		</h2>
		<p class="cs-challenge__desc text-on-light mx-auto m-0">
			{
				paragraph.map((line) => (
					<span class="cs-challenge__desc-line">{line}</span>
				))
			}
		</p>
	</div>

	<ul class="industry-grid m-0 list-none p-0" role="list" data-reveal-group>
		{
			cards.map((item) => (
				<li class="industry-card" data-reveal="up">
					<div class="industry-card-icon" aria-hidden="true">
						<img
							src={item.icon}
							alt=""
							width="28"
							height="28"
							class="size-7 object-contain"
							decoding="async"
							loading="lazy"
						/>
					</div>
					<h3 class="m-0 text-[1.25rem] font-bold tracking-[-0.02em] text-primary-black">
						{item.title}
					</h3>
					<p class="m-0 text-[15px] leading-[1.5] text-[var(--color-text-on-light)] [font-family:var(--font-inter)]">
						{item.text}
					</p>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.cs-challenge__header {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
	}

	.cs-challenge__desc {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		overflow-wrap: break-word;
	}

	.cs-challenge__desc-line {
		display: block;
		max-width: 100%;
	}

	@media (min-width: 1200px) {
		.cs-challenge__desc-line {
			white-space: nowrap;
		}
	}

	/* Card styles mirrored from Industries — do not diverge */
	.industry-grid {
		display: grid;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		grid-template-columns: repeat(3, minmax(0, 464px));
		justify-content: center;
		gap: 1.25rem;
	}

	.industry-card {
		box-sizing: border-box;
		display: flex;
		width: 100%;
		max-width: 464px;
		min-height: 238px;
		height: auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		border: 1px solid #e9e9e7;
		border-radius: 24px;
		background-color: #ffffff;
		padding: 1.75rem 1.5rem;
		text-align: center;
		transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.industry-card:hover {
		box-shadow: 0 0 24px 0 rgba(149, 157, 165, 0.2);
	}

	.industry-card-icon {
		display: inline-flex;
		width: 3rem;
		height: 3rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		background: linear-gradient(180deg, #fbfbfe 0%, rgb(211 211 211 / 0.45) 100%);
	}

	@media (max-width: 1280px) {
		.industry-grid {
			grid-template-columns: repeat(2, minmax(0, 464px));
		}
	}

	@media (max-width: 720px) {
		.industry-grid {
			grid-template-columns: minmax(0, 464px);
		}
	}

	@media (min-width: 640px) and (max-width: 720px) {
		.industry-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.industry-grid > :last-child:nth-child(odd) {
			grid-column: 1 / -1;
			justify-self: center;
			width: 100%;
			max-width: min(464px, calc(50% - 0.625rem));
		}
	}

	@media (min-width: 1024px) and (max-width: 1199px) {
		.industry-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.industry-card {
			transition: none;
		}
	}
</style>
