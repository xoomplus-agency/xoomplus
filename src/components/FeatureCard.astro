---
/**
 * Shared light feature card (ServiceFeatures "Built around people" + IndustryFundamentals).
 * Surface: global `.surface-card`. Hover lift disabled to match Built around people.
 */
interface Props {
	icon: string;
	title: string;
	text: string;
	/** Optional child-service URL — stretched link over the card. */
	href?: string;
	/** When true, show amber plus opposite the icon (gray-plus ServiceFeatures variant). */
	showPlus?: boolean;
	/** Default 28; gray-plus uses 24. */
	iconSize?: number;
	class?: string;
}

const {
	icon,
	title,
	text,
	href,
	showPlus = false,
	iconSize = 28,
	class: className = '',
} = Astro.props;

const iconSrc = icon.startsWith('/') ? icon : `/icons/${icon}.svg`;
---

<article class:list={['surface-card', 'feature-card', href && 'feature-card--link', className]}>
	{
		showPlus ? (
			<div class="feature-card__top">
				<img
					class="feature-card__icon"
					src={iconSrc}
					alt=""
					width={iconSize}
					height={iconSize}
					aria-hidden="true"
					decoding="async"
					loading="lazy"
				/>
				<svg
					class="feature-card__plus"
					width="16"
					height="16"
					viewBox="0 0 16 16"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M8 3v10M3 8h10"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
					/>
				</svg>
			</div>
		) : (
			<img
				class="feature-card__icon"
				src={iconSrc}
				alt=""
				width={iconSize}
				height={iconSize}
				aria-hidden="true"
				decoding="async"
				loading="lazy"
			/>
		)
	}
	<h3 class="feature-card__title m-0">{title}</h3>
	<p class="feature-card__text m-0">{text}</p>
	{href ? <a class="feature-card__stretched" href={href} aria-label={title} /> : null}
</article>

<style>
	.feature-card {
		position: relative;
		display: flex;
		width: 100%;
		height: 100%;
		flex-direction: column;
		align-items: flex-start;
		padding: 32px 24px;
		text-align: left;
		transition: none;
	}

	.feature-card__stretched {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
	}

	@media (hover: hover) {
		.feature-card.surface-card:hover {
			transform: none;
		}
	}

	.feature-card__top {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
	}

	.feature-card__icon {
		display: block;
		width: 28px;
		height: 28px;
		flex-shrink: 0;
	}

	.feature-card--icon-sm .feature-card__icon,
	:global(.sf-section--gray-plus) .feature-card__icon {
		width: 24px;
		height: 24px;
	}

	.feature-card__plus {
		display: block;
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		color: #ffa800;
		pointer-events: none;
	}

	.feature-card__title {
		margin-top: 1.5rem;
		font-family: var(--font-sans);
		font-size: var(--text-h3-sm);
		font-weight: var(--text-h3-sm--font-weight);
		line-height: var(--text-h3-sm--line-height);
		letter-spacing: -0.01em;
		text-wrap: balance;
		color: var(--color-primary-black);
	}

	.feature-card__text {
		margin-top: 0.75rem;
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: var(--text-body--font-weight);
		line-height: var(--text-body--line-height);
		text-wrap: pretty;
		color: #555555;
	}
</style>
