---
import Button from './Button.astro';

const posts = [
	{
		image: '/images/1st.webp',
		alt: 'White lane number 2 painted on a red running track',
		category: 'Web design',
		title: 'Unlocking Your Dream Home with Immolibre',
		excerpt: 'A modern carpentry website designed to generate leads and showcase custom work.',
		href: '/blog/unlocking-your-dream-home-with-immolibre',
	},
	{
		image: '/images/2nd.webp',
		alt: 'Green rolling hills under a cloudy blue sky',
		category: 'Brand strategy',
		title: 'Immolibre: Your Partner in Real Estate Success',
		excerpt: 'A modern carpentry website designed to generate leads and showcase custom work.',
		href: '/blog/immolibre-your-partner-in-real-estate-success',
	},
	{
		image: '/images/3rd.webp',
		alt: 'Vintage black camera with a strap on a light surface',
		category: 'Development',
		title: 'Discover Immolibre: Innovative Solutions for Real Estate',
		excerpt: 'A modern carpentry website designed to generate leads and showcase custom work.',
		href: '/blog/discover-immolibre-innovative-solutions-for-real-estate',
	},
];
---

<section
	id="blogs"
	class="bg-secondary-white px-[clamp(1rem,12.3vw,236px)] py-[clamp(4rem,8vw,6.5rem)]"
	aria-labelledby="blogs-heading"
>
	<div class="mx-auto w-full max-w-[1560px]">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14">
			<p class="pill-light mb-5">Blogs</p>
			<h2
				id="blogs-heading"
				class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				Insights to Help You Navigate Digital Growth
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Hear directly from the businesses we work with about their experience working with Xoomplus.
			</p>
		</div>

		<ul class="blogs-grid m-0 list-none p-0" role="list">
			{
				posts.map((post) => (
					<li class="blogs-grid__item">
						<a class="blog-card" href={post.href}>
							<div class="blog-card__media">
								<img
									class="blog-card__img"
									src={post.image}
									alt={post.alt}
									width="400"
									height="240"
									loading="lazy"
									decoding="async"
								/>
							</div>

							<div class="blog-card__meta">
								<span class="blog-card__category">
									<span class="blog-card__dot" aria-hidden="true" />
									{post.category}
								</span>
								<span class="blog-card__label">From our blog</span>
							</div>

							<h3 class="blog-card__title">{post.title}</h3>
							<p class="blog-card__excerpt">{post.excerpt}</p>

							<div class="blog-card__footer">
								<span class="blog-card__read">Read more</span>
								<svg
									class="blog-card__arrow"
									width="16"
									height="16"
									viewBox="0 0 16 16"
									fill="none"
									aria-hidden="true"
								>
									<path
										d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"
										stroke="#FFA800"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</div>
						</a>
					</li>
				))
			}
		</ul>

		<div class="mt-10 flex justify-center">
			<Button size="nav" class="!w-[220px]" href="/blog">Read all</Button>
		</div>
	</div>
</section>

<style>
	.blogs-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.blogs-grid__item {
		min-width: 0;
		height: 100%;
	}

	.blog-card {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 20px;
		border: 1px solid #eeeeee;
		border-radius: 24px;
		background: #ffffff;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.blog-card:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	.blog-card__media {
		overflow: hidden;
		border-radius: 16px;
	}

	.blog-card__img {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 3;
		height: auto;
		object-fit: cover;
		border-radius: 16px;
		transition: transform 0.3s ease;
	}

	.blog-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 16px;
	}

	.blog-card__category {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		color: #555555;
	}

	.blog-card__dot {
		flex-shrink: 0;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffa800;
	}

	.blog-card__label {
		font-family: var(--font-inter);
		font-size: 11px;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #888888;
		white-space: nowrap;
	}

	.blog-card__title {
		margin: 12px 0 0;
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-primary-black);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(1.25em * 2);
	}

	.blog-card__excerpt {
		margin: 12px 0 20px;
		font-family: var(--font-inter);
		font-size: clamp(1rem, 2vw, 1.125rem);
		font-weight: 400;
		line-height: 1.5;
		color: #555555;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid rgba(85, 85, 85, 0.15);
	}

	.blog-card__read {
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-primary-black);
	}

	.blog-card__arrow {
		flex-shrink: 0;
		display: block;
		transition: transform 0.3s ease;
	}

	@media (min-width: 640px) {
		.blogs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.blogs-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (hover: hover) {
		.blog-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		}

		.blog-card:hover .blog-card__img {
			transform: scale(1.04);
		}

		.blog-card:hover .blog-card__arrow {
			transform: translate(3px, -3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-card,
		.blog-card__img,
		.blog-card__arrow {
			transition: none;
		}

		.blog-card:hover {
			transform: none;
			box-shadow: none;
		}

		.blog-card:hover .blog-card__img,
		.blog-card:hover .blog-card__arrow {
			transform: none;
		}
	}
</style>
