---
import Button from './Button.astro';
import BlogCard from './BlogCard.astro';
import { homeBlogs } from '../data/blogs';
---

<section
	id="blogs"
	data-bg="light"
	class="bg-secondary-white px-[clamp(1rem,12.3vw,236px)] py-section"
	aria-labelledby="blogs-heading"
>
	<div class="mx-auto w-full max-w-[1560px]">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14">
			<p class="pill-light mb-5">Blogs</p>
			<h2
				id="blogs-heading"
				class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				Insights to Help You Navigate Digital Growth
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Hear directly from the businesses we work with about their experience working with Xoomplus.
			</p>
		</div>

		<ul class="blogs-grid m-0 list-none p-0" role="list">
			{
				homeBlogs.map((post) => (
					<li class="blogs-grid__item">
						<BlogCard
							image={post.image}
							alt={post.alt}
							category={post.category}
							title={post.title}
							excerpt={post.excerpt}
							href={post.href}
						/>
					</li>
				))
			}
		</ul>

		<div class="mt-10 flex justify-center">
			<Button size="nav" class="!w-[220px]" href="/blogs">Read all</Button>
		</div>
	</div>
</section>

<style>
	.blogs-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.blogs-grid__item {
		min-width: 0;
		height: 100%;
	}

	@media (min-width: 640px) {
		.blogs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.blogs-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
