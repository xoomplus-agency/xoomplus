---
import Button from './Button.astro';
import BlogCard from './BlogCard.astro';
import { BLOG_IMAGE_PLACEHOLDER, getPosts } from '../lib/wp';

const posts = await getPosts({ perPage: 3 });
---

<section
	id="blogs"
	data-bg="light"
	class="page-section bg-secondary-white py-section"
	aria-labelledby="blogs-heading"
>
	<div class="container">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14" data-reveal="up">
			<p class="pill-light mb-5">Blogs</p>
			{/* Section heading + card titles are both h2 — outline: h2 (section) then h2 (cards). */}
			<h2
				id="blogs-heading"
				class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Insights to Help You Navigate Digital Growth
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Hear directly from the businesses we work with about their experience working with Xoomplus.
			</p>
		</div>

		<ul class="blogs-grid m-0 list-none p-0" role="list" data-reveal-group>
			{
				posts.map((post) => (
					<li class="blogs-grid__item" data-reveal="up">
						<BlogCard
							headingLevel="h2"
							post={post}
							image={post.image?.src ?? BLOG_IMAGE_PLACEHOLDER}
							alt={post.image?.alt ?? post.title}
							srcset={post.image?.srcset}
							width={post.image?.width ?? 400}
							height={post.image?.height ?? 240}
							category={post.category}
							title={post.title}
							excerpt={post.excerpt}
						/>
					</li>
				))
			}
		</ul>

		<div class="mt-10 flex justify-center">
			<Button size="nav" class="!w-[220px]" href="/blogs">Read all</Button>
		</div>
	</div>
</section>

<style>
	.blogs-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.blogs-grid__item {
		min-width: 0;
		height: 100%;
	}

	@media (min-width: 640px) {
		.blogs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.blogs-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
