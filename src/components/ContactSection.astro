---
import Button from './Button.astro';

const contactItems = [
	{
		icon: '/icons/phone.svg',
		label: '+44 330 010 4786',
		href: 'tel:+443300104786',
	},
	{
		icon: '/icons/email.svg',
		label: 'info@xoomplus.co.uk',
		href: 'mailto:info@xoomplus.co.uk',
	},
	{
		icon: '/icons/location.svg',
		label: 'UK: 33 King St, Blackburn BB2 2DH, United Kingdom',
		href: 'https://www.google.com/maps/search/?api=1&query=33+King+St,+Blackburn+BB2+2DH',
	},
] as const;
---

<section
	id="contact"
	class="bg-secondary-white px-[clamp(1rem,12.3vw,236px)] py-[clamp(4rem,8vw,6.5rem)]"
	aria-labelledby="contact-heading"
>
	<div class="contact-grid mx-auto w-full max-w-[1560px]">
		<div class="contact-info">
			<h2
				id="contact-heading"
				class="contact-heading m-0 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				<span class="contact-heading__accent">Let's Start</span>
				<br />
				the Conversation
			</h2>

			<p class="contact-intro text-on-light m-0 mt-4 max-w-[540px]">
				Tell us what you are looking to achieve and let's discuss how Xoomplus can help with your
				digital marketing, website, SEO, social media, or paid search needs.
			</p>

			<ul class="contact-list m-0 list-none p-0" role="list">
				{
					contactItems.map((item) => (
						<li class="contact-list__item">
							<span class="contact-list__icon" aria-hidden="true">
								{/*
									SVGs already include the circular badge + amber (#FFA800) icon.
									Rendered at 36px — no nested badge wrapper needed.
								*/}
								<img src={item.icon} alt="" width="36" height="36" decoding="async" />
							</span>
							{item.href ? (
								<a class="contact-list__text" href={item.href}>
									{item.label}
								</a>
							) : (
								<span class="contact-list__text">{item.label}</span>
							)}
						</li>
					))
				}
			</ul>

			{/*
				Note: This embed currently points to Islamabad (Xoomplus pin), while the
				address above is Blackburn. Swap the src for a Blackburn embed when ready.
			*/}
			<div class="contact-map">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3321.045703617947!2d73.04037407515959!3d33.65597763855125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df95000d84e457%3A0xe13a404eab3f5547!2sXoomplus!5e0!3m2!1sen!2s!4v1791444163528!5m2!1sen!2s"
					title="Xoomplus location map"
					width="600"
					height="450"
					allowfullscreen
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
				></iframe>
			</div>
		</div>

		<div class="contact-card">
			<h3 class="contact-card__title m-0">Tell us about your project</h3>
			<p class="contact-card__subtitle m-0">
				A few details help us understand the right next step.
			</p>

			<form class="contact-form" id="contact-form" novalidate>
				{/* Honeypot — leave empty; bots that fill it are rejected client-side */}
				<div class="contact-honeypot" aria-hidden="true">
					<label for="contact-website">Website</label>
					<input
						type="text"
						id="contact-website"
						name="website"
						tabindex="-1"
						autocomplete="off"
					/>
				</div>

				<div class="contact-field">
					<label for="contact-name">Your name</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						autocomplete="name"
						required
					/>
				</div>

				<div class="contact-field">
					<label for="contact-company">Company</label>
					<input
						type="text"
						id="contact-company"
						name="company"
						autocomplete="organization"
					/>
				</div>

				<div class="contact-field">
					<label for="contact-email">Email</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						autocomplete="email"
						required
					/>
				</div>

				<div class="contact-field">
					<label for="contact-phone">Phone</label>
					<input type="tel" id="contact-phone" name="phone" autocomplete="tel" />
				</div>

				<div class="contact-field">
					<label for="contact-details">Project Details</label>
					<textarea id="contact-details" name="details" rows="4"></textarea>
				</div>

				<Button type="submit" id="contact-submit" size="nav" class="!w-full">
					Submit
					<svg
						class="contact-submit__arrow"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path
							d="M3 8h10M9 4l4 4-4 4"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</Button>

				<p class="contact-status" id="contact-status" role="status" aria-live="polite" hidden
				></p>
			</form>
		</div>
	</div>
</section>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: start;
	}

	.contact-info {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.contact-heading {
		font-size: clamp(1.75rem, 4vw, var(--text-h1));
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.contact-heading__accent {
		color: var(--color-primary);
	}

	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
		margin-top: 1.5rem;
	}

	.contact-list__item {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.contact-list__icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
	}

	.contact-list__icon img {
		display: block;
		width: 36px;
		height: 36px;
	}

	.contact-list__text {
		font-family: var(--font-inter);
		font-weight: 500;
		font-size: 1.125rem;
		line-height: 1.3;
		color: var(--color-primary-black);
		text-decoration: none;
	}

	a.contact-list__text {
		outline: none;
		transition: color 0.2s ease;
	}

	a.contact-list__text:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.contact-map {
		width: 100%;
		height: 220px;
		margin-top: 1.5rem;
		border-radius: 20px;
		overflow: hidden;
	}

	.contact-map iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.contact-card {
		box-sizing: border-box;
		background: var(--color-secondary-white);
		border: 1px solid #e9e9e7;
		border-radius: 24px;
		padding: 24px 20px;
		box-shadow: 0 12px 32px 0 rgba(0, 0, 0, 0.076);
	}

	.contact-card__title {
		font-family: var(--font-inter);
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.contact-card__subtitle {
		margin-top: 0.5rem;
		font-family: var(--font-inter);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.contact-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.contact-field {
		display: flex;
		flex-direction: column;
	}

	.contact-field label {
		margin-bottom: 6px;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-primary-black);
	}

	.contact-field input,
	.contact-field textarea {
		box-sizing: border-box;
		width: 100%;
		border: 1px solid #e9e9e7;
		border-radius: 12px;
		background: var(--color-secondary-white);
		font-family: var(--font-inter);
		font-size: 1rem;
		color: var(--color-primary-black);
		outline: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.contact-field input {
		height: 44px;
		padding: 0 16px;
	}

	.contact-field textarea {
		min-height: 110px;
		padding: 12px 16px;
		resize: vertical;
	}

	.contact-field input:focus,
	.contact-field textarea:focus {
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px rgba(255, 168, 0, 0.18);
	}

	.contact-field input:user-invalid,
	.contact-field textarea:user-invalid {
		border-color: #e05a5a;
	}

	.contact-submit__arrow {
		display: block;
		flex-shrink: 0;
		transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform;
	}

	.contact-status {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		line-height: 1.4;
	}

	.contact-status--success {
		color: #1a7a3a;
	}

	.contact-status--error {
		color: #c0392b;
	}

	@media (hover: hover) {
		a.contact-list__text:hover {
			color: var(--color-primary);
		}

		:global(#contact-submit:hover:not(:disabled) .contact-submit__arrow) {
			transform: translateX(5px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-submit__arrow {
			transition: none;
		}

		:global(#contact-submit:hover:not(:disabled) .contact-submit__arrow) {
			transform: none;
		}
	}

	@media (min-width: 640px) {
		.contact-list__text {
			font-size: 1.375rem;
		}

		.contact-map {
			height: 250px;
		}

		.contact-card {
			padding: 40px;
		}
	}

	@media (min-width: 1024px) {
		.contact-grid {
			grid-template-columns: 1.3fr 1fr;
			gap: 2.5rem;
			align-items: stretch;
		}

		.contact-info {
			height: 100%;
		}

		.contact-map {
			height: 280px;
			margin-top: auto;
		}
	}
</style>

<script>
	const ENDPOINT = '/api/contact';

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
	const statusEl = document.getElementById('contact-status') as HTMLParagraphElement | null;

	if (form && submitBtn && statusEl) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			statusEl.hidden = true;
			statusEl.textContent = '';
			statusEl.classList.remove('contact-status--success', 'contact-status--error');

			const honeypot = (form.elements.namedItem('website') as HTMLInputElement | null)?.value;
			if (honeypot) {
				statusEl.textContent = 'Thanks — we will be in touch shortly.';
				statusEl.classList.add('contact-status--success');
				statusEl.hidden = false;
				form.reset();
				return;
			}

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			submitBtn.disabled = true;

			try {
				const response = await fetch(ENDPOINT, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});

				if (!response.ok) {
					throw new Error(`Request failed (${response.status})`);
				}

				statusEl.textContent = 'Thanks — your message has been sent. We will be in touch shortly.';
				statusEl.classList.add('contact-status--success');
				statusEl.hidden = false;
				form.reset();
			} catch {
				statusEl.textContent =
					'Something went wrong. Please try again or email info@xoomplus.co.uk.';
				statusEl.classList.add('contact-status--error');
				statusEl.hidden = false;
			} finally {
				submitBtn.disabled = false;
			}
		});
	}
</script>
