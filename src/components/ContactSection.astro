---
import Button from './Button.astro';
import LocationMap from './LocationMap.astro';

const contactItems = [
	{
		icon: '/icons/phone.svg',
		label: '+44 330 010 4786',
		href: 'tel:+443300104786',
	},
	{
		icon: '/icons/email.svg',
		label: 'info@xoomplus.co.uk',
		href: 'mailto:info@xoomplus.co.uk',
	},
	{
		icon: '/icons/location.svg',
		label: 'UK: 33 King St, Blackburn BB2 2DH, United Kingdom',
		href: 'https://www.google.com/maps/search/?api=1&query=33+King+St,+Blackburn+BB2+2DH',
	},
] as const;
---

<section
	id="contact"
	data-bg="light"
	class="page-section bg-secondary-white py-section"
	aria-labelledby="contact-heading"
>
	<div class="contact-grid container">
		<div class="contact-info">
			<div data-reveal="up">
				<h2
					id="contact-heading"
					class="contact-heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
				>
					<span class="contact-heading__accent">Let's Start</span>
					<br />
					the Conversation
				</h2>

				<p class="contact-intro text-on-light m-0 mt-4 max-w-[540px]">
					Tell us what you are looking to achieve and let's discuss how Xoomplus can help with your
					digital marketing, website, SEO, social media, or paid search needs.
				</p>

				<ul class="contact-list m-0 list-none p-0" role="list">
					{
						contactItems.map((item) => (
							<li class="contact-list__item">
								<span class="contact-list__icon" aria-hidden="true">
									{/*
										SVGs already include the circular badge + amber (#FFA800) icon.
										Rendered at 36px — no nested badge wrapper needed.
									*/}
									<img src={item.icon} alt="" width="36" height="36" decoding="async" />
								</span>
								{item.href ? (
									<a class="contact-list__text" href={item.href}>
										{item.label}
									</a>
								) : (
									<span class="contact-list__text">{item.label}</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			<LocationMap class="contact-map" radius={20} />
		</div>

		<div class="contact-card">
			<h3 class="contact-card__title m-0">Tell us about your project</h3>
			<p class="contact-card__subtitle m-0">
				A few details help us understand the right next step.
			</p>

			<form
				class="contact-form"
				id="contact-form"
				data-contact-form
				data-cf7-form="contact-homepage"
				novalidate
			>
				{/* Honeypot — leave empty; bots that fill it are rejected client-side */}
				<div class="contact-honeypot" aria-hidden="true">
					<label for="contact-hp-website">Website</label>
					<input
						type="text"
						id="contact-hp-website"
						name="hp_website"
						tabindex="-1"
						autocomplete="off"
					/>
				</div>

				<div class="contact-field">
					<label for="contact-name">Your name</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						autocomplete="name"
						required
					/>
					<p class="contact-field-error m-0" data-cf7-error="name" hidden></p>
				</div>

				<div class="contact-field">
					<label for="contact-company">Company</label>
					<input
						type="text"
						id="contact-company"
						name="company"
						autocomplete="organization"
						required
					/>
					<p class="contact-field-error m-0" data-cf7-error="company" hidden></p>
				</div>

				<div class="contact-field">
					<label for="contact-email">Email</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						autocomplete="email"
						required
					/>
					<p class="contact-field-error m-0" data-cf7-error="email" hidden></p>
				</div>

				<div class="contact-field">
					<label for="contact-phone">Phone</label>
					<input
						type="tel"
						id="contact-phone"
						name="phone"
						autocomplete="tel"
						required
					/>
					<p class="contact-field-error m-0" data-cf7-error="phone" hidden></p>
				</div>

				<div class="contact-field">
					<label for="contact-details">Project Details</label>
					<textarea id="contact-details" name="details" rows="4"></textarea>
					<p class="contact-field-error m-0" data-cf7-error="details" hidden></p>
				</div>

				<Button type="submit" id="contact-submit" size="nav" class="!w-full">
					Submit
					<svg
						class="contact-submit__arrow"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path
							d="M3 8h10M9 4l4 4-4 4"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</Button>

				<p class="contact-status" id="contact-status" role="status" aria-live="polite" hidden
				></p>
			</form>
		</div>
	</div>
</section>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: start;
	}

	.contact-info {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.contact-heading {
		letter-spacing: -0.02em;
	}

	.contact-heading__accent {
		color: var(--color-primary);
	}

	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
		margin-top: 1.5rem;
	}

	.contact-list__item {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.contact-list__icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
	}

	.contact-list__icon img {
		display: block;
		width: 36px;
		height: 36px;
	}

	.contact-list__text {
		font-family: var(--font-inter);
		font-weight: 500;
		font-size: 1.125rem;
		line-height: 1.3;
		color: var(--color-primary-black);
		text-decoration: none;
	}

	a.contact-list__text {
		outline: none;
		transition: color 0.2s ease;
	}

	a.contact-list__text:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Height/margin only — radius + image fill live on LocationMap */
	:global(.contact-map) {
		height: 220px;
		margin-top: 1.5rem;
	}

	/* Keep home form labels / textarea sizing identical to pre-extract */
	.contact-card :global(.contact-field label) {
		font-size: 0.875rem;
	}

	.contact-card :global(.contact-field textarea) {
		min-height: 110px;
	}

	@media (hover: hover) {
		a.contact-list__text:hover {
			color: var(--color-primary);
		}
	}

	@media (min-width: 640px) {
		.contact-list__text {
			font-size: 1.375rem;
		}

		:global(.contact-map) {
			height: 250px;
		}
	}

	@media (min-width: 1024px) {
		.contact-grid {
			grid-template-columns: 1.3fr 1fr;
			gap: 2.5rem;
			align-items: stretch;
		}

		.contact-info {
			height: 100%;
		}

		:global(.contact-map) {
			height: 280px;
			margin-top: auto;
		}
	}
</style>

<script>
	import { initContactForms } from '../scripts/contact-form';

	function scheduleContactBoot() {
		const form = document.querySelector('[data-contact-form]');
		if (!form) return;
		const boot = () => initContactForms();
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					if (!entries.some((e) => e.isIntersecting)) return;
					io.disconnect();
					boot();
				},
				{ rootMargin: '200px 0px' },
			);
			io.observe(form);
		} else {
			boot();
		}
	}

	document.addEventListener('astro:page-load', scheduleContactBoot);
	scheduleContactBoot();
</script>
