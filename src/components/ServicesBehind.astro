---
/**
 * "The services behind the possibilities" — dark section, ServiceCards + optional advisory.
 * Content from props / servicesBehind (Industries default).
 */
import Section from './Section.astro';
import ServiceCard from './ServiceCard.astro';
import Button from './Button.astro';
import {
	servicesBehind,
	type ServicesBehindSection,
} from '../data/services-behind';

interface Props {
	/** Full section content. Defaults to Industries `servicesBehind`. */
	content?: ServicesBehindSection;
}

const section = Astro.props.content ?? servicesBehind;
const headingId = `${section.id}-heading`;
const cardCount = section.cards.length;
/** 3/6 → 3 cols · 2/4 → 2 cols · odd 5+ → 3 cols · else 1 */
const gridCols =
	cardCount <= 1 ? 1 : cardCount % 3 === 0 ? 3 : cardCount % 2 === 0 ? 2 : cardCount >= 3 ? 3 : 2;
---

<Section
	id={section.id}
	background="dark"
	aria-labelledby={headingId}
	class="services-behind section-glow-top-left"
>
	<div class="services-behind__header" data-reveal="up">
		<div class="services-behind__heading-group">
			<p class="pill-dark text-primary m-0">{section.pill}</p>
			<h2
				id={headingId}
				class="text-heading-dark dark-section-heading services-behind__title m-0"
			>
				{section.title}
			</h2>
		</div>
		<p class="services-behind__intro m-0">{section.text}</p>
	</div>

	<div
		class:list={[
			'services-behind__grid',
			`services-behind__grid--cols-${gridCols}`,
		]}
		data-reveal-group
	>
		{
			section.cards.map((card) => (
				<div data-reveal="up">
					<ServiceCard
						class={
							gridCols === 3
								? 'service-card--wide service-card--grid-3'
								: 'service-card--wide'
						}
						title={card.title}
						icon={card.icon}
						description={card.description}
						features={card.items}
						cta={{ label: card.buttonLabel, href: card.href }}
						buttonLabel={card.buttonLabel}
						buttonIcon="right"
					/>
				</div>
			))
		}
	</div>

	{
		section.advisory ? (
			<div class="services-behind__advisory" data-reveal="up">
				{section.advisory.text ? (
					<p class="services-behind__advisory-text m-0">{section.advisory.text}</p>
				) : null}
				<Button size="nav" href={section.advisory.href}>
					{section.advisory.buttonLabel}
				</Button>
			</div>
		) : null
	}
</Section>

<style>
	/* Wide enough for 2×708 or 3 equal columns */
	.services-behind :global(.container) {
		max-width: var(--container-max-wide);
	}

	.services-behind__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.services-behind__heading-group {
		min-width: 0;
		flex: 1 1 auto;
	}

	.services-behind__title {
		margin-top: 16px;
	}

	.services-behind__intro {
		flex: 0 0 auto;
		max-width: 380px;
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-body-dark);
		text-align: left;
	}

	.services-behind__grid {
		display: grid;
		justify-content: center;
		gap: 24px;
		align-items: stretch;
		margin-top: 40px;
	}

	.services-behind__grid--cols-1 {
		grid-template-columns: minmax(0, 708px);
	}

	.services-behind__grid--cols-2 {
		grid-template-columns: repeat(2, minmax(0, 708px));
	}

	.services-behind__grid--cols-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.services-behind__grid :global(.service-card) {
		width: 100%;
		height: 100%;
		min-width: 0;
		max-width: 708px;
	}

	/* Three-up: let cards fill the column (708px max would break the row) */
	.services-behind__grid--cols-3 :global(.service-card),
	.services-behind__grid--cols-3 :global(.service-card--grid-3) {
		max-width: none;
	}

	/* Beat ServiceCard `text-small` / `text-[14px]` utilities */
	.services-behind__grid :global(.service-card > p),
	.services-behind__grid :global(.service-feature) {
		font-size: 16px !important;
		line-height: 1.5 !important;
	}

	.services-behind__advisory {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-top: 32px;
	}

	.services-behind__advisory-text {
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--text-body-dark);
		text-align: center;
	}

	@media (max-width: 1023px) {
		.services-behind__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.services-behind__intro {
			max-width: none;
			width: 100%;
		}

		.services-behind__grid--cols-3 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.services-behind__grid--cols-3 :global(.service-card),
		.services-behind__grid--cols-3 :global(.service-card--grid-3) {
			max-width: none;
		}
	}

	@media (max-width: 639px) {
		.services-behind__grid,
		.services-behind__grid--cols-1,
		.services-behind__grid--cols-2,
		.services-behind__grid--cols-3 {
			grid-template-columns: 1fr;
		}
	}


	/* Tablet: section header side-by-side from 900px */
	@media (min-width: 900px) and (max-width: 1023px) {
		.services-behind__header {
			flex-direction: row;
			align-items: flex-end;
			gap: 40px;
		}

		.services-behind__intro {
			max-width: 360px;
			width: auto;
		}
	}

	@media (min-width: 1024px) and (max-width: 1199px) {
		.services-behind__intro {
			max-width: 360px;
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.services-behind__grid--cols-3 > :last-child:nth-child(odd) {
			grid-column: 1 / -1;
			justify-self: center;
			width: 100%;
			max-width: calc(50% - 8px);
		}
	}
</style>
