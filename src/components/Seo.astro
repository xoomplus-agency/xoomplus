---
import { normalizeSeoPath, type PageSEO } from '../lib/wp-seo';

interface Props {
	/** Fallback title when pageSeo is absent or seoTitle is null (non-WP routes). */
	title?: string;
	/** Fallback description for non-WP routes only — never invent when pageSeo is set. */
	description?: string;
	image?: string;
	type?: string;
	/**
	 * Static canonical path for this page (e.g. `/about`, `/services/seo`).
	 * Always wins — never replaced by WordPress/Yoast at runtime.
	 * Defaults to current pathname when omitted.
	 */
	canonicalPath?: string;
	/**
	 * Normalized Yoast page SEO from getPageSEO.
	 * Used for title/description/OG/schema — not for canonical (canonical is static).
	 */
	pageSeo?: PageSEO | null;
	/** When true: force noindex,nofollow. Default false. */
	noindex?: boolean;
	/**
	 * When true: omit canonical + og:url (e.g. 404). Independent of `noindex` so
	 * site-wide staging noindex can still emit canonicals on real pages.
	 */
	omitCanonical?: boolean;
	/**
	 * Explicit robots meta (e.g. CMS post noindex → "noindex, follow").
	 * Wins over pageSeo robots when set; ignored when `noindex` is true or staging.
	 */
	robots?: string;
	/**
	 * Static pages only: og/twitter title + description match meta title/description,
	 * and `image` (hero or logo) wins over Yoast og:image. Never enable for blog posts.
	 */
	syncOgWithMeta?: boolean;
}

const {
	title = '',
	description = '',
	image,
	type = 'website',
	canonicalPath = Astro.url.pathname,
	pageSeo,
	noindex = false,
	omitCanonical = false,
	robots: robotsProp,
	syncOgWithMeta = false,
} = Astro.props;

/**
 * Canonicals always use the preferred production origin + slashless path.
 * Same tag for `/path` and `/path/` — no request-URL variance, no WP override.
 */
const PREFERRED_ORIGIN = 'https://xoomplus.co.uk';
const site = Astro.site ?? new URL(PREFERRED_ORIGIN);
const fromWp = pageSeo != null;

const seoTitle = fromWp ? (pageSeo.seoTitle ?? title) : title;
const seoDescription = fromWp
	? (pageSeo.metaDescription ?? (description || undefined))
	: description || undefined;

/** Preferred absolute canonical: https://xoomplus.co.uk[/path] — no slash, query, or hash. */
function preferredCanonicalHref(path: string): string {
	const normalized = normalizeSeoPath(path.split('?')[0].split('#')[0] || '/');
	return normalized === '/' ? `${PREFERRED_ORIGIN}/` : `${PREFERRED_ORIGIN}${normalized}`;
}

const canonical = omitCanonical ? undefined : preferredCanonicalHref(canonicalPath);

const og = fromWp ? pageSeo.social.og : null;
const x = fromWp ? pageSeo.social.x : null;

function absoluteImage(src: string | undefined | null): string | undefined {
	if (!src) return undefined;
	if (src.startsWith('http')) return src;
	return site ? new URL(src, site).href : undefined;
}

const propImage = absoluteImage(image);

const ogTitle = syncOgWithMeta
	? seoTitle
	: fromWp
		? (og?.title ?? seoTitle)
		: seoTitle;
const ogDescription = syncOgWithMeta
	? seoDescription
	: fromWp
		? (og?.description ?? undefined)
		: seoDescription;
const ogType = fromWp ? (og?.type ?? type) : type;
/** og:url matches the preferred canonical — not Yoast og:url / request slash. */
const ogUrl = canonical;
const ogSiteName = fromWp ? (og?.siteName ?? undefined) : undefined;
const ogLocale = fromWp ? (og?.locale ?? undefined) : undefined;

const ogImage = syncOgWithMeta
	? (propImage ?? absoluteImage(og?.image ?? undefined))
	: fromWp
		? (og?.image ?? undefined)
		: propImage;

const ogImageWidth =
	syncOgWithMeta && propImage ? undefined : fromWp ? (og?.imageWidth ?? undefined) : undefined;
const ogImageHeight =
	syncOgWithMeta && propImage ? undefined : fromWp ? (og?.imageHeight ?? undefined) : undefined;
const ogImageType =
	syncOgWithMeta && propImage ? undefined : fromWp ? (og?.imageType ?? undefined) : undefined;

const twitterCard = fromWp && !syncOgWithMeta
	? (x?.card ?? (ogImage ? 'summary_large_image' : 'summary'))
	: ogImage
		? 'summary_large_image'
		: 'summary';
const twitterTitle = syncOgWithMeta
	? seoTitle
	: fromWp
		? (x?.title ?? seoTitle)
		: seoTitle;
const twitterDescription = syncOgWithMeta
	? seoDescription
	: fromWp
		? (x?.description ?? undefined)
		: seoDescription;
const twitterImage = syncOgWithMeta
	? ogImage
	: fromWp
		? (x?.image ?? ogImage)
		: ogImage;

function robotsContent(seo: PageSEO): string | undefined {
	const parts: string[] = [];
	if (seo.robots.index) parts.push(seo.robots.index);
	if (seo.robots.follow) parts.push(seo.robots.follow);
	for (const value of Object.values(seo.robots.advanced)) {
		if (value) parts.push(value);
	}
	return parts.length > 0 ? parts.join(', ') : undefined;
}

/**
 * Never copy CMS “Discourage search engines” / site-wide Yoast noindex onto the
 * public Astro host. Intentional noindex uses the `noindex` prop (e.g. 404).
 */
const yoastRobotsRaw = fromWp ? robotsContent(pageSeo) : undefined;
const yoastRobots =
	yoastRobotsRaw && /\bnoindex\b/i.test(yoastRobotsRaw) ? undefined : yoastRobotsRaw;
const schemaJson = fromWp && pageSeo.schema ? JSON.stringify(pageSeo.schema) : undefined;
---

{seoTitle && <title>{seoTitle}</title>}
{seoDescription && <meta name="description" content={seoDescription} />}

{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && robotsProp && <meta name="robots" content={robotsProp} />}
{!noindex && !robotsProp && yoastRobots && <meta name="robots" content={yoastRobots} />}

{canonical && <link rel="canonical" href={canonical} />}

{ogTitle && <meta property="og:title" content={ogTitle} />}
{ogDescription && <meta property="og:description" content={ogDescription} />}
{ogType && <meta property="og:type" content={ogType} />}
{ogUrl && <meta property="og:url" content={ogUrl} />}
{ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
{ogLocale && <meta property="og:locale" content={ogLocale} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImageWidth != null && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight != null && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageType && <meta property="og:image:type" content={ogImageType} />}

<meta name="twitter:card" content={twitterCard} />
{twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
{twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
{twitterImage && <meta name="twitter:image" content={twitterImage} />}

{schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

<slot name="json-ld" />
