---
/**
 * Child-page "Services" card grid — below Working together.
 * Card chrome/hover: global `.why-card`. Images from /public/images (not icons).
 */
import Section from './Section.astro';
import type { ChildServicesCard } from '../data/child-services';

interface Props {
	id?: string;
	pill: string;
	heading: string;
	text: string;
	cards: ChildServicesCard[];
}

const { id = 'services', pill, heading, text, cards } = Astro.props;
const headingId = `${id}-heading`;
---

{
	cards.length > 0 ? (
		<Section id={id} aria-labelledby={headingId} background="white">
			<div class="child-services">
				<div class="child-services__header">
					<p class="pill-light m-0">{pill}</p>
					<h2
						id={headingId}
						class="child-heading child-heading--section child-services__heading m-0"
					>
						{heading}
					</h2>
					<p class="child-services__intro m-0">{text}</p>
				</div>

				<ul class="child-services__grid m-0 list-none p-0" role="list">
					{cards.map((card) => (
						<li class="child-services__item">
							<article class="why-card child-services__card">
								<div class="child-services__media">
									<img
										class="child-services__img"
										src={card.image.src}
										alt={card.image.alt}
										width={card.image.width ?? 800}
										height={card.image.height ?? 480}
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="child-services__body">
									<h3 class="child-services__title m-0">{card.title}</h3>
									<p class="child-services__text m-0">{card.text}</p>
								</div>
							</article>
						</li>
					))}
				</ul>
			</div>
		</Section>
	) : null
}

<style>
	.child-services__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 820px;
		margin-inline: auto;
		margin-bottom: 48px;
	}

	.child-services__heading {
		margin-top: 20px;
	}

	.child-services__intro {
		margin-top: 16px;
		max-width: 820px;
		font-family: var(--font-inter);
		font-size: 17.6px;
		font-weight: 400;
		line-height: 29.04px;
		color: rgb(85, 85, 85);
	}

	.child-services__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		align-items: stretch;
		padding-bottom: 24px;
	}

	.child-services__item {
		min-width: 0;
		display: flex;
	}

	.child-services__card {
		height: auto;
		min-height: 0;
		padding: 0;
		align-items: stretch;
		justify-content: flex-start;
		text-align: left;
		gap: 0;
		overflow: visible;
	}

	.child-services__media {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		overflow: hidden;
		border-radius: 24px 24px 0 0;
		background: transparent;
	}

	/* Crisp raster illustrations — contain avoids crop/scale mush */
	.child-services__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 2.4;
		object-fit: contain;
		image-rendering: auto;
	}

	.child-services__img {
		transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.child-services__card:hover .child-services__img {
			transform: scale(1.05);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.child-services__img {
			transition: none;
		}

		.child-services__card:hover .child-services__img {
			transform: none;
		}
	}

	.child-services__body {
		padding: 24px;
	}

	.child-services__title {
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--color-primary-black);
	}

	.child-services__text {
		margin-top: 8px;
		font-family: var(--font-inter);
		font-size: 15px;
		font-weight: 400;
		line-height: 1.5;
		color: #555555;
	}

	@media (min-width: 640px) {
		/* 4 tracks → each card spans 2 (= 2 columns). Lone last card centres. */
		.child-services__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.child-services__item {
			grid-column: span 2;
		}

		.child-services__item:last-child:nth-child(2n + 1) {
			grid-column: 2 / span 2;
		}
	}

	@media (min-width: 1024px) {
		/*
		 * 6 tracks → each card spans 2 (= 3 columns max).
		 * Incomplete last rows centre: 1 leftover (4, 7…) or 2 leftovers (5, 8…).
		 */
		.child-services__grid {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.child-services__item {
			grid-column: span 2;
		}

		/* 1 leftover — e.g. 4th of 4 */
		.child-services__item:last-child:nth-child(3n + 1) {
			grid-column: 3 / span 2;
		}

		/* 2 leftovers — e.g. 4th & 5th of 5 */
		.child-services__item:nth-last-child(2):nth-child(3n + 1) {
			grid-column: 2 / span 2;
		}

		.child-services__item:last-child:nth-child(3n + 2) {
			grid-column: 4 / span 2;
		}
	}

	@media (max-width: 639px) {
		.child-services__header {
			margin-bottom: 32px;
		}
	}
</style>
