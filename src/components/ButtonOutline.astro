---
interface Props {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	/** `default` = white fill · `outline-dark` = transparent fill for dark sections */
	variant?: 'default' | 'outline-dark';
	class?: string;
	id?: string;
	'aria-label'?: string;
}

const {
	href,
	type = 'button',
	disabled = false,
	variant = 'default',
	class: className = '',
	id,
	'aria-label': ariaLabel,
} = Astro.props;

const classes = [
	'btn-outline',
	variant === 'outline-dark' && 'btn-outline--dark',
	className,
]
	.filter(Boolean)
	.join(' ');
const Tag = href && !disabled ? 'a' : 'button';
---

<Tag
	class={classes}
	id={id}
	href={Tag === 'a' ? href : undefined}
	type={Tag === 'button' ? type : undefined}
	disabled={Tag === 'button' ? disabled : undefined}
	aria-disabled={Tag === 'a' && disabled ? 'true' : undefined}
	aria-label={ariaLabel}
>
	<slot />
</Tag>
