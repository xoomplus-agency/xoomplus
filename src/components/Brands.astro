---
import LogoLoop from './LogoLoop.astro';

const logoSizes = '(max-width: 767px) 150px, 200px';

const logos = [
	{
		src: '/images/brand-concisemedico.webp',
		srcSet:
			'/images/brand-concisemedico-150.webp 150w, /images/brand-concisemedico.webp 300w, /images/brand-concisemedico-2x.webp 450w',
		sizes: logoSizes,
		alt: 'ConciseMedico',
		width: 300,
		height: 68,
	},
	{
		src: '/images/brand-sterling-cooper.webp',
		srcSet:
			'/images/brand-sterling-cooper-150.webp 150w, /images/brand-sterling-cooper.webp 300w, /images/brand-sterling-cooper-2x.webp 450w',
		sizes: logoSizes,
		alt: 'Sterling Cooper Consultants Ltd.',
		width: 300,
		height: 68,
	},
	{
		src: '/images/brand-bodykite.webp',
		srcSet:
			'/images/brand-bodykite-150.webp 150w, /images/brand-bodykite.webp 300w, /images/brand-bodykite-2x.webp 450w',
		sizes: logoSizes,
		alt: 'Bodykite',
		width: 300,
		height: 68,
	},
	{
		src: '/images/brand-gopsych.webp',
		srcSet:
			'/images/brand-gopsych-150.webp 150w, /images/brand-gopsych.webp 300w, /images/brand-gopsych-2x.webp 450w',
		sizes: logoSizes,
		alt: 'Go Psych',
		width: 300,
		height: 68,
	},
];
---

<section
	data-bg="light"
	class="page-section overflow-x-clip bg-secondary-white py-section"
	aria-labelledby="brands-heading"
>
	<div class="container container--wide text-center">
		<div data-reveal="up">
			<h2
				id="brands-heading"
				class="text-h2 mb-[0.5em] font-semibold tracking-[-0.02em] text-primary-black"
			>
			Powering Digital Growth for UK Brands
			</h2>
			<p class="text-on-light mx-auto mb-11 max-w-[640px]">
				Brands that trusted us once have trusted us since. We tailor our services to match our clients' goals and growth needs.
			</p>
		</div>
		<div class="brands-logo-loop mx-auto w-full max-w-full">
			<LogoLoop
				logos={logos}
				speed={70}
				direction="left"
				logoHeight={68}
				gap={56}
				fadeOut
				fadeOutColor="#FFFFFF"
				ariaLabel="Xoomplus clients and technology partners"
			/>
		</div>
	</div>
</section>

<style>
	.brands-logo-loop :global(.logoloop__item img) {
		width: 200px;
		height: 68px;
		object-fit: contain;
	}

	@media (max-width: 767px) {
		.brands-logo-loop :global(.logoloop__item img) {
			width: 150px;
		}
	}
</style>
