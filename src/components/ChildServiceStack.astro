---
/**
 * Child-page "Services" — header (SSR) + ScrollStack island (all viewports).
 * Sticky stack: no data-reveal around the stack; section opts out of reveal; overflow visible.
 * SSR static list = no-JS / pre-hydration / prefers-reduced-motion fallback.
 */
import Section from './Section.astro';
import ChildServiceStackIsland from './ChildServiceStack.tsx';
import type { ChildServicesCard } from '../data/child-services';

interface Props {
	id?: string;
	pill: string;
	heading: string;
	text: string;
	cards: ChildServicesCard[];
}

const { id = 'service-stack', pill, heading, text, cards } = Astro.props;
const headingId = `${id}-heading`;
const rootId = 'child-service-stack-root';
---

{
	cards.length > 0 ? (
		<Section
			id={id}
			aria-labelledby={headingId}
			background="white"
			reveal={false}
			class="child-service-stack-section"
		>
			<div class="child-service-stack__header">
				<p class="pill-light m-0">{pill}</p>
				<h2
					id={headingId}
					class="child-heading child-heading--section child-service-stack__heading m-0"
				>
					{heading}
				</h2>
				<p class="child-service-stack__intro m-0">{text}</p>
			</div>

			{/*
			  SSR static list = visible before hydration / no-JS / reduced-motion.
			  Island (client:visible) sets data-mode="hydrated" in useEffect and
			  takes over — fallback then hidden so there is no duplicate content.
			  Reduced-motion sets data-mode="static" and keeps the SSR list.
			*/}
			<div class="child-service-stack" id={rootId} data-mode="ssr">
				<div class="child-service-stack__fallback">
					<ul class="child-stack-list m-0 list-none p-0" role="list">
						{
							cards.map((card) => (
								<li class="child-stack-list__item">
									<div class="scroll-stack-card child-stack-card">
										<article class="child-stack-card__body">
											<img
												class="child-stack-card__img"
												src={card.image.src}
												alt={card.image.alt}
												width={card.image.width ?? 800}
												height={card.image.height ?? 540}
												loading="lazy"
												decoding="async"
											/>
											<div class="child-stack-card__copy">
												<h3 class="child-stack-card__title m-0">{card.title}</h3>
												<p class="child-stack-card__text m-0">{card.text}</p>
											</div>
										</article>
									</div>
								</li>
							))
						}
					</ul>
				</div>

				<div class="child-service-stack__island">
					<ChildServiceStackIsland client:visible cards={cards} rootId={rootId} />
				</div>
			</div>
		</Section>
	) : null
}

<style is:global>
	/*
	 * Sticky requires no overflow/transform/filter/contain on ancestors.
	 * White Section has no overflow-hidden; keep this section + container clean.
	 * body overflow-x: clip (Layout, ≤1023px) breaks position:sticky — lift it
	 * only while this section is on the page.
	 */
	.child-service-stack-section,
	.child-service-stack-section > .container {
		overflow: visible !important;
		transform: none;
		filter: none;
		contain: none;
		content-visibility: visible;
		isolation: auto;
	}

	@media (max-width: 1023px) {
		body:has(.child-service-stack-section) {
			overflow-x: visible;
		}

		main.child-service-main:has(.child-service-stack-section) {
			overflow: visible;
			transform: none;
			filter: none;
			contain: none;
			content-visibility: visible;
			isolation: auto;
		}
	}

	.child-service-stack__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 820px;
		margin-inline: auto;
		margin-bottom: 48px;
	}

	.child-service-stack__heading {
		margin-top: 20px;
	}

	.child-service-stack__intro {
		margin-top: 16px;
		max-width: 640px;
		font-family: var(--font-inter);
		font-size: 17.6px;
		font-weight: 400;
		line-height: 29.04px;
		color: rgb(85, 85, 85);
	}

	/* Fixed design width; shrinks inside the page container on narrower viewports */
	.child-service-stack {
		position: relative;
		width: 100%;
		max-width: 1196px;
		margin-inline: auto;
	}

	/* Library inner pads for contained demos — reset for our container */
	.child-service-stack .scroll-stack__inner {
		padding-inline: 0;
	}

	.child-service-stack .scroll-stack__slot {
		overflow: visible;
		/* Do not override position/display — sticky must stay sticky */
	}

	/* —— Card chrome (overrides ScrollStack.css via itemClassName) —— */
	.child-service-stack .child-stack-card.scroll-stack-card,
	.child-service-stack .scroll-stack-card.child-stack-card {
		box-sizing: border-box;
		width: 1196px;
		max-width: 100%;
		height: auto;
		min-height: 260px;
		padding: 20px;
		border: 1px solid #e9e9e7;
		border-radius: 24px;
		background: #ffffff;
		color: var(--color-primary-black);
		box-shadow: 0 8px 24px 0 rgba(149, 157, 165, 0.2);
	}

	.child-stack-card__body {
		display: grid;
		grid-template-columns: 0.9fr 1fr;
		gap: 32px;
		align-items: center;
		width: 100%;
	}

	.child-stack-card__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 2.7;
		object-fit: cover;
		border-radius: 16px;
		transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.child-stack-card:hover .child-stack-card__img {
			transform: scale(1.05);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.child-stack-card__img {
			transition: none;
		}

		.child-stack-card:hover .child-stack-card__img {
			transform: none;
		}
	}

	.child-stack-card__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(26px, 2.4vw, 30px);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--color-primary-black);
	}

	.child-stack-card__text {
		margin: 12px 0 0;
		font-family: var(--font-inter);
		font-size: 15px;
		font-weight: 400;
		line-height: 1.6;
		color: #555555;
	}

	.child-stack-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.child-stack-list__item {
		min-width: 0;
	}

	/*
	 * Pre-hydration: keep SSR list in flow; park the island absolutely so
	 * client:visible can still observe it without doubling layout height.
	 * After hydrate: hide fallback. Static (reduced-motion): keep fallback only.
	 */
	.child-service-stack:not([data-mode='hydrated']) .child-service-stack__island {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		opacity: 0;
		pointer-events: none;
		z-index: -1;
	}

	.child-service-stack[data-mode='hydrated'] .child-service-stack__fallback {
		display: none;
	}

	.child-service-stack[data-mode='hydrated'] .child-service-stack__island {
		position: static;
		opacity: 1;
		pointer-events: auto;
		z-index: auto;
	}

	.child-service-stack[data-mode='static'] .child-service-stack__island {
		display: none;
	}

	.child-service-stack[data-mode='static'] .child-service-stack__fallback {
		display: block;
	}

	/* Dock clearance: last pinned card ends above ScrollToTop / safe-area */
	.child-service-stack .scroll-stack--window {
		padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
	}

	@media (min-width: 1024px) {
		.child-service-stack .scroll-stack--window {
			padding-bottom: 0;
		}
	}

	/* Mobile: one-column content-sized cards under the top bar */
	@media (max-width: 639px) {
		.child-service-stack .child-stack-card.scroll-stack-card,
		.child-service-stack .scroll-stack-card.child-stack-card {
			min-height: 0;
			padding: 16px;
			border-radius: 20px;
		}

		.child-stack-card__body {
			grid-template-columns: 1fr;
			gap: 16px;
			align-items: start;
		}

		.child-stack-card__img {
			aspect-ratio: 16 / 10;
			border-radius: 16px;
		}
	}

	/* Compact when a card exceeds the pin viewport (set by island) */
	.child-service-stack--compact .child-stack-card__img {
		aspect-ratio: 16 / 9;
	}

	.child-service-stack--compact .child-stack-card__text {
		font-size: 14px;
	}

	/* Tablet portrait: stack card body when two-col feels tight */
	@media (min-width: 640px) and (max-width: 899px) {
		.child-stack-card__body {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}

	@media (min-width: 640px) and (max-width: 1199px) and (max-height: 700px) {
		.child-service-stack .child-stack-card.scroll-stack-card,
		.child-service-stack .scroll-stack-card.child-stack-card {
			min-height: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.child-service-stack__island {
			display: none !important;
		}

		.child-service-stack__fallback {
			display: block !important;
		}
	}
</style>
