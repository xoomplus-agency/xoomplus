---
import loadingIcon from '../assets/icons/btn-loading-icon.svg';

interface Props {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	loading?: boolean;
	disabled?: boolean;
	/** `nav` = 156×48 · `hero` = 233×56 · default = content padding */
	size?: 'default' | 'nav' | 'hero';
	/** `primary` = gradient fill · `light` = white fill + amber border */
	variant?: 'primary' | 'light';
	class?: string;
	id?: string;
	'aria-label'?: string;
	'aria-controls'?: string;
	hidden?: boolean;
}

const {
	href,
	type = 'button',
	loading = false,
	disabled = false,
	size = 'default',
	variant = 'primary',
	class: className = '',
	id,
	'aria-label': ariaLabel,
	'aria-controls': ariaControls,
	hidden = false,
} = Astro.props;

const isDisabled = disabled || loading;
const isLight = variant === 'light';

const sizeClass =
	size === 'nav' ? 'btn-size-nav' : size === 'hero' ? 'btn-size-hero' : 'px-[28px] py-[18px]';

const classes = [
	'btn',
	isLight && 'btn--light',
	'inline-flex items-center justify-center',
	'box-border',
	!isLight && 'rounded-button',
	sizeClass,
	'text-primary-black',
	!isLight && 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
	isDisabled && !loading && !isLight && 'bg-button-disabled text-[#888888] pointer-events-none',
	loading && 'pointer-events-none',
	className,
]
	.filter(Boolean)
	.join(' ');

const Tag = href && !isDisabled ? 'a' : 'button';
---

<Tag
	class={classes}
	id={id}
	href={Tag === 'a' ? href : undefined}
	type={Tag === 'button' ? type : undefined}
	disabled={Tag === 'button' ? isDisabled : undefined}
	aria-busy={loading || undefined}
	aria-label={loading ? ariaLabel || 'Loading' : ariaLabel}
	aria-controls={ariaControls}
	hidden={hidden || undefined}
>
	<span class="btn__label inline-flex items-center justify-center gap-2">
		{
			loading ? (
				<img
					class="btn-loading-icon size-[21px]"
					src={loadingIcon.src}
					width="21"
					height="21"
					alt=""
					aria-hidden="true"
				/>
			) : (
				<slot />
			)
		}
	</span>
</Tag>
