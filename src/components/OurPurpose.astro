---
import Section from './Section.astro';

const intro =
	'Xoomplus was built with a clear purpose: to bridge the costly divide between great design, search visibility and real business revenue with an integrated, data-driven system.';

const cards = [
	{
		pill: 'The Problem',
		title: 'Fragmented Marketing Waste',
		text: 'A well-designed website underperforms without strong SEO foundations. Paid ad campaigns stall when landing page journeys are ignored. When digital marketing operates in divided groups, it remains an unpredictable business cost rather than a measurable growth driver.',
	},
	{
		pill: 'The Solution',
		title: 'The Xoomplus Synchronised Engine',
		text: 'We approach digital growth as a single connected system. From high-converting UI/UX and custom Shopify or WordPress development to dominating competitive Manchester search rankings and precision Google Ads funnels. We build every element to support the next.',
	},
];
---

<Section
	background="dark"
	aria-labelledby="purpose-heading"
	class="our-purpose section-glow-top-left"
>
	<div class="purpose-header" data-reveal="up">
		<p class="pill-dark text-primary mb-5">Brand Mission & Purpose</p>
		<h2 id="purpose-heading" class="text-heading-dark dark-section-heading purpose-heading m-0">
			Our Purpose
		</h2>
		<p class="dark-section-intro purpose-intro m-0">{intro}</p>
	</div>

	<div class="purpose-grid" data-reveal-group>
		{
			cards.map((card) => (
				<article class="service-card service-card--wide purpose-card" data-reveal="up">
					<p class="pill-dark text-primary m-0">{card.pill}</p>
					<h3 class="purpose-card__title m-0">{card.title}</h3>
					<p class="dark-glass-card__text purpose-card__text m-0">{card.text}</p>
				</article>
			))
		}
	</div>
</Section>

<style>
	.purpose-header {
		max-width: 640px;
		margin-inline: auto;
		text-align: center;
	}

	.purpose-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		justify-content: center;
		gap: 24px;
		margin-top: 40px;
		align-items: stretch;
	}

	.purpose-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		height: 100%;
		text-align: left;
	}

	.purpose-card__title {
		margin-top: 16px;
		font-family: var(--font-inter);
		font-size: clamp(1.5rem, 2.5vw, 2rem); /* 24–32px */
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: #ffffff;
	}

	.purpose-card__text {
		margin-top: 12px;
	}

	@media (max-width: 1023px) {
		.purpose-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.purpose-card {
			max-width: 708px;
			margin-inline: auto;
		}
	}

	@media (min-width: 900px) and (max-width: 1023px) {
		.purpose-grid {
			grid-template-columns: 1fr 1fr;
			gap: 40px;
		}

		.purpose-card {
			max-width: none;
			margin-inline: 0;
		}
	}
</style>
