---
import Section from './Section.astro';
import Button from './Button.astro';
import ButtonOutline from './ButtonOutline.astro';
import { pricingIntro } from '../data/pricing-intro';

const { id, pill, titleDark, titleAccent, paragraphs, primaryButton, secondaryButton, image } =
	pricingIntro;

const headingId = 'pricing-intro-heading';
---

<Section id={id} aria-labelledby={headingId}>
	<div class="pricing-intro">
		<div class="pricing-intro__content">
			<div data-reveal="up">
			<p class="pill-light m-0 normal-case">{pill}</p>

			<h2
				id={headingId}
				class="pricing-intro__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				{titleDark}<span class="pricing-intro__accent">{titleAccent}</span>
			</h2>

			<div class="pricing-intro__copy">
				{
					paragraphs.map((paragraph) => (
						<p class="text-on-light m-0">{paragraph}</p>
					))
				}
			</div>

			<div class="pricing-intro__actions">
				<Button href={primaryButton.href}>{primaryButton.label}</Button>
				<ButtonOutline class="pricing-intro__btn-secondary px-7" href={secondaryButton.href}>
					<span>{secondaryButton.label}</span>
				</ButtonOutline>
			</div>
			</div>
		</div>

		<div class="pricing-intro__media" data-reveal="fade">
			<img
				class="pricing-intro__image"
				src={image.src}
				alt={image.alt}
				width={image.width}
				height={image.height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
	</div>
</Section>

<style>
	.pricing-intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: center;
	}

	.pricing-intro__content {
		min-width: 0;
		text-align: left;
	}

	.pricing-intro__heading {
		margin-top: 20px;
		font-size: var(--text-h2);
		line-height: var(--text-h2--line-height);
		line-height: 1.15;
	}

	.pricing-intro__accent {
		display: block;
		color: var(--color-primary);
	}

	.pricing-intro__copy {
		display: flex;
		flex-direction: column;
		gap: 10px;
		/* ~3 lines per paragraph at body size (was 480px → 4+ lines) */
		max-width: 640px;
		margin-top: 20px;
	}

	.pricing-intro__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		margin-top: 28px;
	}

	/* Layout only — keep shared outline styles; height matches primary (H:52) */
	.pricing-intro__actions :global(.pricing-intro__btn-secondary) {
		height: 52px;
	}

	.pricing-intro__media {
		min-width: 0;
		width: 100%;
	}

	.pricing-intro__image {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (min-width: 1024px) {
		.pricing-intro__heading,
		.pricing-intro__accent {
			white-space: nowrap;
		}
	}

	@media (max-width: 1023px) {
		.pricing-intro {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.pricing-intro__media {
			max-width: 560px;
			margin-inline: auto;
		}
	}
</style>
