---
const stats = [
	{
		value: '50+',
		label: 'Projects Done',
		icon: '/icons/projects-done.svg',
	},
	{
		value: '2K+',
		label: 'Happy Clients',
		icon: '/icons/happy-clients.svg',
	},
	{
		value: '25+',
		label: 'Team Members',
		icon: '/icons/team-members.svg',
	},
];
---

<section
	id="growth"
	class="growth relative isolate overflow-hidden px-[clamp(1rem,12.3vw,236px)] py-[clamp(4rem,8vw,6.5rem)]"
	aria-labelledby="growth-heading"
>
	<div class="growth-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

	<div class="relative mx-auto w-full max-w-[1560px]">
		<p class="growth-pill mb-5">OUR GROWTH</p>
		<div class="growth-header">
			<h2 id="growth-heading" class="text-heading-dark growth-heading m-0">
				Everything You Need to Build a Stronger
				<br class="growth-heading-break" />
				Digital Presence
			</h2>
			<p class="growth-intro m-0">
				Every number here reflects our journey helping
				<br />
				tech companies grow smarter and faster.
			</p>
		</div>

		<ul class="growth-grid m-0 list-none p-0" role="list">
			{
				stats.map((stat) => (
					<li class="growth-card">
						<div class="growth-card-copy">
							<p class="growth-stat m-0">{stat.value}</p>
							<p class="growth-label m-0">{stat.label}</p>
						</div>
						<img
							class="growth-card-icon"
							src={stat.icon}
							alt=""
							width="66"
							height="64"
							decoding="async"
							loading="lazy"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.growth {
		--growth-bg: #0b0a0b;
		--growth-accent: #ffa800;
		--growth-accent-strong: rgb(255 168 0 / 0.42);
		--growth-accent-soft: rgb(255 168 0 / 0.3);
		--growth-glow-end: rgb(0 0 0 / 0);
		--growth-text: #ffffff;
		--growth-card-border: rgb(237 237 237 / 0.1);
		--growth-card-bg: linear-gradient(
			180deg,
			rgb(255 255 255 / 0.15) 0%,
			rgb(255 255 255 / 0.03) 50%,
			rgb(255 255 255 / 0.07) 100%
		);
		/* Hover — Figma diagonal: orange @ top-right → fade to bottom-left */
		--growth-card-hover-bg: linear-gradient(
			to bottom left,
			rgb(255 168 0 / 0.3) 0%,
			rgb(255 255 255 / 0.03) 50%,
			rgb(255 255 255 / 0.07) 100%
		);

		background-color: var(--growth-bg);
		color: var(--growth-text);
	}

	.growth-glow {
		background:
			/* Top-left primary glow — softer, pulled further left */
			radial-gradient(
				ellipse 48% 55% at -8% 0%,
				var(--growth-accent-strong) 0%,
				var(--growth-glow-end) 100%
			),
			/* Middle-right secondary glow */
			radial-gradient(
				ellipse 42% 48% at 88% 58%,
				var(--growth-accent-soft) 0%,
				var(--growth-glow-end) 100%
			);
	}

	.growth-pill {
		display: inline-flex;
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		padding: 6px 12px;
		border-radius: 9999px;
		border: 1px solid var(--growth-accent);
		background: transparent;
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: 0.01em;
		color: var(--growth-accent);
	}

	.growth-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: clamp(1.5rem, 4vw, 4rem);
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.growth-heading {
		flex: 1 1 auto;
		min-width: 0;
		white-space: nowrap;
		text-align: left;
	}

	/* One line on large screens; break only below */
	.growth-heading-break {
		display: none;
	}

	.growth-intro {
		flex: 0 0 auto;
		margin-left: auto;
		padding-top: 0.35rem;
		font-family: var(--font-inter);
		font-size: 22px;
		font-weight: 400;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--growth-text);
		white-space: nowrap;
	}

	.growth-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 463px));
		justify-content: center;
		gap: 1rem;
	}

	.growth-card {
		box-sizing: border-box;
		position: relative;
		display: flex;
		width: 100%;
		max-width: 463px;
		height: 141px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		isolation: isolate;
		overflow: hidden;
		border-radius: 12px;
		/* Border never changes on hover */
		border: 1px solid var(--growth-card-border);
		background: var(--growth-card-bg);
		background-clip: padding-box;
		padding: 30px;
		-webkit-backdrop-filter: blur(40px);
		backdrop-filter: blur(40px);
	}

	/* Smooth hover fill — opacity only; stays inside the border */
	.growth-card::before {
		content: "";
		position: absolute;
		inset: 1px;
		z-index: 0;
		border-radius: 11px;
		pointer-events: none;
		background: var(--growth-card-hover-bg);
		opacity: 0;
		transition: opacity 350ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.growth-card:hover::before {
		opacity: 1;
	}

	.growth-card > * {
		position: relative;
		z-index: 1;
	}

	.growth-card-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.35rem;
	}

	.growth-stat {
		font-size: clamp(2rem, 3vw, 2.75rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--growth-text);
	}

	.growth-label {
		font-family: var(--font-inter);
		font-size: 25px;
		font-weight: 400;
		line-height: 1.35;
		color: #e6e4e3;
	}

	.growth-card-icon {
		display: block;
		width: 66px;
		height: 64px;
		flex-shrink: 0;
		object-fit: contain;
	}

	@media (max-width: 1280px) {
		.growth-header {
			flex-direction: column;
			gap: 1.25rem;
		}

		.growth-heading {
			white-space: normal;
		}

		.growth-heading-break {
			display: block;
		}

		.growth-intro {
			margin-left: 0;
			white-space: normal;
		}

		.growth-intro br {
			display: none;
		}

		.growth-grid {
			grid-template-columns: repeat(2, minmax(0, 463px));
		}
	}

	@media (max-width: 720px) {
		.growth-grid {
			grid-template-columns: minmax(0, 463px);
		}

		.growth-card {
			height: auto;
			min-height: 141px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.growth-card::before {
			transition: none;
		}
	}
</style>
