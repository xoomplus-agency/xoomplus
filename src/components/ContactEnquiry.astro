---
import Section from './Section.astro';
import ContactForm from './ContactForm.astro';

/*
 * Icons live at /public/icons/ (not /public/assets/icons/ — that folder does not exist).
 * Both SVGs already use fill="#FFA800".
 */
const emailIcon = '/icons/contact-email.svg';
const phoneIcon = '/icons/contact-phone.svg';
---

<Section aria-labelledby="contact-enquiry-heading">
	<div class="enquiry">
		<div class="enquiry__info" data-reveal="up">
			<p class="pill-light m-0">Let's start</p>

			<h2
				id="contact-enquiry-heading"
				class="enquiry__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Your ambition.
				<br />
				Our next conversation.
			</h2>

			<p class="enquiry__intro text-on-light m-0">
				A new website, a stronger search presence or a more connected marketing plan. Share a little
				about your business and where you want to go.
			</p>

			{/*
				Dark glass on white: same white gradient as .service-card, layered over
				20% black + primary black so it reads near-black (service-card alone is
				too light on a white section and carries hover amber).
			*/}
			<div class="enquiry-glass">
				<h3 class="enquiry-glass__title m-0">Prefer another way?</h3>

				<div class="enquiry-glass__block">
					<div class="enquiry-glass__row">
						<img
							src={emailIcon}
							alt=""
							aria-hidden="true"
							width="20"
							height="20"
							decoding="async"
						/>
						<p class="enquiry-glass__block-title m-0">Send us an email</p>
					</div>
					<p class="enquiry-glass__text m-0">
						For a project, a partnership or a general question, start with a short introduction.
					</p>
					<a class="enquiry-glass__link" href="mailto:info@xoomplus.co.uk">info@xoomplus.co.uk</a>
				</div>

				<hr class="enquiry-glass__divider" />

				<div class="enquiry-glass__block">
					<div class="enquiry-glass__row">
						<img
							src={phoneIcon}
							alt=""
							aria-hidden="true"
							width="20"
							height="20"
							decoding="async"
						/>
						<p class="enquiry-glass__block-title m-0">Talk it through</p>
					</div>
					<p class="enquiry-glass__text m-0">
						Prefer a conversation? Let us know what you'd like to discuss.
					</p>
					<a class="enquiry-glass__link" href="tel:+443300104786">+44 330 010 4786</a>
				</div>
			</div>

			<div class="enquiry__address">
				<h3 class="enquiry__address-title m-0">Find us in Blackburn</h3>
				<p class="enquiry__address-text m-0">
					UK: 33 King St, Blackburn BB2 2DH, United Kingdom
				</p>
			</div>
		</div>

		<ContactForm idPrefix="enquiry" source="contact" headingLevel={3} align="left" />
	</div>
</Section>

<style>
	.enquiry {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
		align-items: start;
	}

	.enquiry__info {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}

	.enquiry__heading {
		margin-top: 1rem;
		letter-spacing: -0.02em;
	}

	.enquiry__intro {
		margin-top: 12px;
		max-width: 340px;
	}

	/* Near-black glass card on white — not .service-card (hover amber + no black base) */
	.enquiry-glass {
		position: relative;
		box-sizing: border-box;
		width: 100%;
		margin-top: 24px;
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 24px;
		/* Split layers: solid color + images (multi-layer `background` shorthand was dropped) */
		background-color: var(--color-primary-black);
		background-image:
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 0.15) 0%,
				rgba(255, 255, 255, 0.03) 50%,
				rgba(255, 255, 255, 0.07) 100%
			),
			linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
	}

	.enquiry-glass__title {
		font-family: var(--font-inter);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.3;
		color: #ffffff;
	}

	.enquiry-glass__block {
		margin-top: 20px;
	}

	.enquiry-glass__row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.enquiry-glass__row img {
		display: block;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
	}

	.enquiry-glass__block-title {
		font-family: var(--font-inter);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		color: #ffffff;
	}

	.enquiry-glass__text {
		margin-top: 8px;
		font-family: var(--font-inter);
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-body-dark);
	}

	.enquiry-glass__link {
		display: inline-block;
		margin-top: 12px;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-primary);
		text-decoration: none;
		outline: none;
	}

	.enquiry-glass__link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.enquiry-glass__divider {
		margin: 20px 0;
		border: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.enquiry__address {
		margin-top: 24px;
	}

	.enquiry__address-title {
		font-family: var(--font-inter);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-primary-black);
	}

	.enquiry__address-text {
		margin-top: 8px;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	@media (hover: hover) {
		.enquiry-glass__link:hover {
			text-decoration: underline;
		}
	}

	@media (min-width: 1024px) {
		.enquiry {
			grid-template-columns: 0.55fr 1fr;
			gap: 32px;
		}
	}
</style>
