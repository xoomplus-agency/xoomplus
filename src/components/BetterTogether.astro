---
import Section from './Section.astro';

const cards = [
	{
		title: 'Find+',
		subtitle: 'Search & High-Intent Discovery',
		text: 'Intercept potential clients right when they search for your services on Google, Bing, and AI search engines.',
	},
	{
		title: 'Engage+',
		subtitle: 'Brand Authority & Market Connection',
		text: 'We combine data-backed content with sharp visual assets to turn cold viewers into engaged followers and warm enquiries.',
	},
	{
		title: 'Act+',
		subtitle: 'Conversion Engineering & Retention',
		text: 'Turn inbound interest into valuable enquiries. We engineer fast, intuitive digital platforms where the next step is completely clear.',
	},
];
---

<Section aria-labelledby="better-together-heading">
	<div class="bt-header" data-reveal="up">
		<div class="bt-header__intro">
			<p class="pill-light m-0">Better together</p>
			<h2
				id="better-together-heading"
				class="bt-header__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Digital Unified System.
			</h2>
		</div>
		<p class="bt-header__aside text-on-light m-0">
			At Xoomplus, we align search visibility, web engineering and targeted advertising into a
			single connected journey. We make sure your business is easy to find, clear to understand
			and simple to buy from across Manchester and the UK.
		</p>
	</div>

	<ul class="bt-grid m-0 list-none p-0" role="list" data-reveal-group>
		{
			cards.map((card) => (
				<li class="bt-grid__item" data-reveal="up">
					<article class="surface-card bt-card">
						<h3 class="bt-card__title m-0">{card.title}</h3>
						<span class="bt-card__divider" aria-hidden="true"></span>
						<p class="bt-card__subtitle m-0">{card.subtitle}</p>
						<p class="bt-card__text m-0">{card.text}</p>
					</article>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.bt-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.bt-header__intro {
		min-width: 0;
	}

	.bt-header__heading {
		margin-top: 16px;
	}

	.bt-header__aside {
		flex-shrink: 0;
		max-width: 380px;
		text-align: left;
	}

	/* pb leaves room so card shadows (Y 8 / blur 24) are not clipped */
	.bt-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
		margin-top: 32px;
		padding-bottom: 24px;
	}

	.bt-grid__item {
		display: flex;
		min-width: 0;
		height: 100%;
	}

	.bt-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		width: 100%;
		height: 100%;
		text-align: left;
	}

	.bt-card__title {
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		font-size: 30px;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-primary-black);
	}

	.bt-card__divider {
		display: block;
		width: 56px;
		height: 2px;
		margin-top: 12px;
		border-radius: 2px;
		background-color: var(--color-primary);
	}

	.bt-card__subtitle {
		margin-top: 20px;
		font-family: var(--font-inter);
		font-size: var(--text-lead);
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-primary-black);
	}

	.bt-card__text {
		margin-top: 10px;
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	@media (max-width: 1023px) {
		.bt-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.bt-header__aside {
			max-width: 100%;
		}

		.bt-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Tablet: header side-by-side from 900; orphan third card centered */
	@media (min-width: 900px) and (max-width: 1023px) {
		.bt-header {
			flex-direction: row;
			align-items: flex-end;
			gap: 40px;
		}

		.bt-header__aside {
			max-width: 360px;
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.bt-grid__item:last-child:nth-child(odd) {
			grid-column: 1 / -1;
			width: 100%;
			max-width: calc(50% - 12px);
			justify-self: center;
		}
	}

	@media (min-width: 1024px) and (max-width: 1199px) {
		.bt-header__aside {
			max-width: 360px;
		}
	}

	@media (max-width: 639px) {
		.bt-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.bt-card__title {
			font-size: clamp(1.625rem, 6vw, 1.875rem); /* ~26–30px */
		}

		.bt-card__subtitle,
		.bt-card__text {
			font-size: 18px;
		}
	}
</style>
