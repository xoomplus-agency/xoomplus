---
import '../styles/infinite-marquee.css';

const sampleText =
	'Yourself required no at thoughts delicate landlord it be. Branched dashwood do is whatever it. Farther be chapter at visited married in it pressed. By distrusts procuring be oh frankness existence believing instantly if. Doubtful on an juvenile as of servants insisted.';

const testimonials = [
	{
		name: 'Sophia Moore',
		role: 'CEO at Webflow Agency',
		text: sampleText,
		avatar: '/images/avatar.webp',
	},
	{
		name: 'Sophia Moore',
		role: 'CEO at Webflow Agency',
		text: sampleText,
		avatar: '/images/avatar.webp',
	},
	{
		name: 'Sophia Moore',
		role: 'CEO at Webflow Agency',
		text: sampleText,
		avatar: '/images/avatar.webp',
	},
	{
		name: 'Sophia Moore',
		role: 'CEO at Webflow Agency',
		text: sampleText,
		avatar: '/images/avatar.webp',
	},
];
---

<section
	id="testimonials"
	class="bg-secondary-white px-[clamp(1rem,12.3vw,236px)] py-[clamp(4rem,8vw,6.5rem)]"
	aria-labelledby="testimonials-heading"
>
	<div class="mx-auto w-full max-w-[1560px]">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14">
			<p class="pill-light mb-5">TESTIMONIALS</p>
			<h2
				id="testimonials-heading"
				class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				What Our Clients Say
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Hear directly from the businesses we work with about their experience working with Xoomplus.
			</p>
		</div>

		<div
			class="testimonials-marquee infinite-marquee"
			style="--marquee-duration: 50s; --marquee-gap: 24px;"
			role="region"
			aria-label="Client testimonials"
		>
			<div class="infinite-marquee__track">
				{
					[false, true].map((isClone) => (
						<ul class="infinite-marquee__group" role="list" aria-hidden={isClone ? 'true' : undefined}>
							{testimonials.map((item) => (
								<li class="testimonial-card">
									<img
										class="testimonial-card__logo"
										src="/images/testimonials-gogle.webp"
										alt={isClone ? '' : 'Google Reviews'}
										width="106"
										height="53"
										decoding="async"
										loading="lazy"
									/>
									<div class="testimonial-card__quote">
										<span
											class="testimonial-card__mark testimonial-card__mark--open"
											aria-hidden="true"
										>
											“
										</span>
										<p class="testimonial-card__text">{item.text}</p>
										<span
											class="testimonial-card__mark testimonial-card__mark--close"
											aria-hidden="true"
										>
											”
										</span>
									</div>
									<div class="testimonial-card__author">
										<img
											class="testimonial-card__avatar"
											src={item.avatar}
											alt=""
											width="36"
											height="36"
											decoding="async"
											loading="lazy"
										/>
										<p class="testimonial-card__name">{item.name}</p>
										<p class="testimonial-card__role">{item.role}</p>
									</div>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.testimonials-marquee {
		/* Keep card drop shadows inside the clipped/masked viewport */
		padding-block: 40px;
		margin-block: -40px;
	}

	.testimonial-card {
		box-sizing: border-box;
		display: flex;
		flex: 0 0 475px;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		text-align: center;
		position: relative;
		width: 475px;
		min-height: 470px;
		padding: 20px 24px;
		border-radius: 16px;
		border: 1px solid #ffffff;
		background-color: #ffffff;
		box-shadow: 0 7px 30px 0 rgba(100, 100, 111, 0.2);
	}

	.testimonial-card__logo {
		display: block;
		width: 96px;
		height: auto;
		margin: 12px auto 0;
	}

	.testimonial-card__quote {
		position: relative;
		width: 100%;
		margin: 0;
		z-index: 0;
	}

	.testimonial-card__author {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 12px;
	}

	.testimonial-card__text {
		margin: 0;
		width: 405px;
		max-width: 100%;
		font-family: var(--font-inter);
		font-size: 18px;
		line-height: 1.5;
		color: #888888;
		position: relative;
		z-index: 1;
	}

	.testimonial-card__mark {
		position: absolute;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 34px;
		line-height: 1;
		color: #e6e6e6;
		pointer-events: none;
		user-select: none;
		z-index: 0;
	}

	.testimonial-card__mark--open {
		top: -4px;
		left: 0;
	}

	.testimonial-card__mark--close {
		right: 0;
		bottom: -8px;
	}

	.testimonial-card__avatar {
		width: 36px;
		height: 36px;
		margin-top: 0;
		border-radius: 50%;
		object-fit: cover;
	}

	.testimonial-card__name {
		margin: 10px 0 0;
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-primary-black);
	}

	.testimonial-card__role {
		margin: 4px 0 0;
		font-family: var(--font-inter);
		font-size: 14px;
		line-height: 1.4;
		color: #888888;
	}
</style>
