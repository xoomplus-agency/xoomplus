---
import Section from './Section.astro';
import { getServiceDetailPair } from '../data/services-detail';
import { getChildHrefByName } from '../data/main-services';

interface Props {
	serviceId: string;
}

const { serviceId } = Astro.props;
const service = getServiceDetailPair(serviceId);

if (!service) {
	throw new Error(`Unknown service detail pair id: ${serviceId}`);
}

const columnToMainSlug: Record<string, string> = {
	'social-media': 'social-media-marketing',
	ppc: 'ppc-google-ads',
};

const headingId = `${service.id}-heading`;
const [titleLine1, titleLine2] = service.title;
---

<Section
	id={service.id}
	background="dark"
	aria-labelledby={headingId}
	class="service-detail-pair section-glow-top-left"
>
	<div class="sdp-header" data-reveal="up">
		<div class="sdp-header__intro">
			<p class="pill-dark text-primary m-0">{service.pill}</p>
			<h2 id={headingId} class="sdp-header__heading text-heading-dark dark-section-heading m-0">
				{titleLine1}<br />
				{titleLine2}
			</h2>
		</div>
		<p class="sdp-header__aside m-0">{service.intro}</p>
	</div>

	<div class="sdp-columns" data-reveal-group>
		{
			service.columns.map((column, index) => (
				<>
					{index > 0 && <div class="sdp-columns__rule" aria-hidden="true" />}
					<div class="sdp-col" id={column.id} data-reveal="up">
						<p class="sdp-col__eyebrow m-0">{column.eyebrow}</p>
						<h3 class="sdp-col__title m-0">{column.title}</h3>
						<p class="sdp-col__text m-0">{column.text}</p>
						<div class="sdp-col__divider" aria-hidden="true" />
						<ul class="sdp-col__list m-0 list-none p-0">
							{column.items.map((item) => {
								const mainSlug = columnToMainSlug[column.id];
								const href = mainSlug
									? getChildHrefByName(mainSlug, item.title)
									: undefined;
								return (
									<li class="sdp-col__item">
										<h4 class="sdp-col__item-title m-0">
											{href ? (
												<a class="sdp-col__item-link" href={href}>
													{item.title}
												</a>
											) : (
												item.title
											)}
										</h4>
										<p class="sdp-col__item-text m-0">{item.text}</p>
									</li>
								);
							})}
						</ul>
					</div>
				</>
			))
		}
	</div>
</Section>

<style>
	.sdp-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.sdp-header__intro {
		min-width: 0;
	}

	.sdp-header__heading {
		margin-top: 16px;
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		letter-spacing: -0.02em;
	}

	.sdp-header__aside {
		flex-shrink: 0;
		max-width: 480px;
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: 400;
		line-height: 1.5;
		text-align: left;
		color: var(--text-body-dark);
	}

	.sdp-columns {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		column-gap: 48px;
		margin-top: 48px;
	}

	.sdp-columns__rule {
		align-self: stretch;
		width: 1px;
		background-color: rgba(255, 255, 255, 0.15);
	}

	.sdp-col {
		min-width: 0;
		scroll-margin-top: calc(80px + 16px);
	}

	.sdp-col__eyebrow {
		font-family: var(--font-inter);
		font-size: var(--text-lead);
		font-weight: 400;
		line-height: 1.4;
		color: var(--color-primary);
	}

	.sdp-col__title {
		margin-top: 16px;
		font-family: var(--font-inter);
		font-size: var(--text-h2);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.sdp-col__text {
		margin-top: 16px;
		font-family: var(--font-inter);
		font-size: var(--text-h3-sm);
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-body-dark);
	}

	.sdp-col__divider {
		width: 100%;
		height: 1px;
		margin-top: 24px;
		background-color: rgba(255, 255, 255, 0.15);
	}

	.sdp-col__item {
		padding: 20px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
	}

	.sdp-col__item:last-child {
		border-bottom: none;
	}

	.sdp-col__item-title {
		font-family: var(--font-inter);
		font-size: var(--text-h3-sm);
		font-weight: 500;
		line-height: 1.3;
		color: #ffffff;
	}

	.sdp-col__item-link {
		color: inherit;
		text-decoration: none;
	}

	.sdp-col__item-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.sdp-col__item-link:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	.sdp-col__item-text {
		margin-top: 8px;
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-body-dark);
	}

	@media (max-width: 1023px) {
		.sdp-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.sdp-header__aside {
			max-width: 100%;
		}

		.sdp-columns {
			grid-template-columns: 1fr;
			row-gap: 0;
			column-gap: 0;
		}

		.sdp-columns__rule {
			width: 100%;
			height: 1px;
			margin: 40px 0;
		}
	}

	@media (max-width: 639px) {
		.sdp-header__heading {
			font-size: clamp(1.875rem, 7vw, 2.5rem); /* ~30–40px */
		}

		.sdp-col__eyebrow {
			font-size: var(--text-body);
		}

		.sdp-col__title {
			font-size: clamp(1.875rem, 7vw, 2.5rem); /* ~30–40px */
		}

		.sdp-col__text,
		.sdp-header__aside {
			font-size: var(--text-body);
		}

		.sdp-col__item-title {
			font-size: var(--text-lead);
		}
	}
</style>
