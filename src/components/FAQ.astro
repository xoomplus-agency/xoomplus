---
import Section from './Section.astro';
import FAQAccordion from './FAQAccordion';
import type { FAQItem } from './FAQAccordion';
import { FAQ_DEFAULTS, getFaqSet, type FaqItem } from '../data/faqs';

interface Props {
	items?: FaqItem[];
	page?: string;
	pill?: string;
	heading?: string;
	text?: string;
	defaultOpen?: number | null;
	id?: string;
	/** Output FAQPage JSON-LD (default true). Set false if a second FAQ section exists on the same page. */
	jsonLd?: boolean;
}

const {
	items: itemsProp,
	page,
	pill: pillProp,
	heading: headingProp,
	text: textProp,
	defaultOpen = 0,
	id = 'faq',
	jsonLd = true,
} = Astro.props;

const set = page ? getFaqSet(page) : undefined;
const sourceItems: FaqItem[] = itemsProp?.length
	? itemsProp
	: set?.items?.length
		? set.items
		: [];

if (sourceItems.length === 0) {
	return;
}

const pill = pillProp ?? set?.pill ?? FAQ_DEFAULTS.pill;
const heading = headingProp ?? set?.heading ?? FAQ_DEFAULTS.heading;
const text = textProp ?? set?.text ?? FAQ_DEFAULTS.text;
const headingId = `${id}-heading`;

const faqItems: FAQItem[] = sourceItems.map((item, index) => ({
	id: `${id}-item-${index}`,
	question: item.question,
	answer: item.answer,
}));

/** Plain text for schema.org — strip HTML from trusted answers. */
function stripHtml(html: string): string {
	return html
		.replace(/<[^>]*>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
}

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: stripHtml(item.answer),
		},
	})),
};
---

<Section id={id} aria-labelledby={headingId}>
	<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14">
		<p class="pill-light mb-5">{pill}</p>
		<h2
			id={headingId}
			class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
		>
			{heading}
		</h2>
		<p class="text-on-light mx-auto max-w-[640px]">{text}</p>
	</div>

	<FAQAccordion client:load items={faqItems} defaultOpen={defaultOpen} />
</Section>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

<style is:global>
	/* Answer HTML from trusted FAQ data only */
	.faq-answer a {
		color: var(--color-primary-black);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.faq-answer a:hover {
		color: #ffa800;
	}

	.faq-answer ul,
	.faq-answer ol {
		margin: 0.75em 0 0;
		padding-left: 1.25em;
	}

	.faq-answer li {
		margin-top: 0.35em;
	}

	.faq-answer ul {
		list-style-type: disc;
	}

	.faq-answer ol {
		list-style-type: decimal;
	}
</style>
