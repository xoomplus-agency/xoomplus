---
import Button from './Button.astro';
import ServiceCard from './ServiceCard.astro';
import { services, helpCard } from '../data/services';

const intro =
	'Sustainable growth demands a unified digital ecosystem. We combine search discovery, brand interaction and paid acquisition to build high-performance pathways for your business.'
---

<section
	id="services"
	data-bg="dark"
	class="page-section services relative isolate overflow-hidden bg-[#0B0A0B] py-section text-secondary-white"
	aria-labelledby="services-heading"
>
	<div class="services-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

	<div class="relative container">
		<div class="mx-auto mb-12 w-full text-center lg:mb-14" data-reveal="up">
			<p class="pill-dark mb-5 text-primary">OUR SERVICES</p>
			<h2
				id="services-heading"
				class="text-heading-dark mb-4"
			>
			Full-Funnel Digital Solutions Built for Commercial Impact
			</h2>
			<p class="mx-auto max-w-[640px] text-lead font-normal leading-[1.55] text-[var(--text-body-dark)] [font-family:var(--font-inter)]">
				{intro}
			</p>
		</div>

		<div class="services-grid" data-reveal-group>
			{
				services.map((service) => (
					<div class="services-grid__cell" data-reveal="up">
						<ServiceCard
							title={service.title}
							icon={service.icon}
							description={service.description}
							features={service.features}
							cta={service.cta}
						/>
					</div>
				))
			}

			<article class="service-card service-card--help flex h-full flex-col justify-between text-center" data-reveal="up">
				<div class="flex flex-1 flex-col items-center justify-center px-2 py-6">
					<h3 class="text-h3 mb-4 font-medium tracking-[-0.02em] text-secondary-white">
						{helpCard.title}
					</h3>
					<p class="text-small mx-auto max-w-[320px] text-[var(--text-body-dark)] [font-family:var(--font-inter)]">
						{helpCard.description}
					</p>
				</div>
				<a class="service-card-btn" href={helpCard.cta.href}>
					{helpCard.cta.label}
					<span aria-hidden="true">→</span>
				</a>
			</article>
		</div>

		<div class="services-cta-bar mt-8 flex flex-col items-center justify-between gap-5 rounded-[1.25rem] bg-[rgb(255_255_255_/_0.06)] px-6 py-5 sm:flex-row sm:px-8">
			<p class="text-h3-sm m-0 text-center font-semibold tracking-[-0.01em] text-[var(--text-body-dark)] sm:text-left">
				Unsure which channel offers the highest growth return?
			</p>
			<Button size="nav" href="#contact">Request an Audit</Button>
		</div>
	</div>
</section>

<style>
	.services-glow {
		background:
			/* Top-left — soft glow, nudged slightly inward */
			radial-gradient(
				ellipse 48% 50% at 6% 8%,
				rgb(255 211 108 / 0.22) 0%,
				rgb(255 168 0 / 0.12) 45%,
				rgb(255 117 72 / 0) 100%
			),
			/* Bottom-right — slightly dimmer, nudged slightly inward */
			radial-gradient(
				ellipse 48% 52% at 94% 78%,
				rgb(255 168 0 / 0.28) 0%,
				rgb(0 0 0 / 0) 100%
			);
	}

	/* Fixed Figma width — do not change */
	.services-cta-bar {
		width: 954px;
		max-width: 100%;
		margin-inline: auto;
		-webkit-backdrop-filter: blur(40px);
		backdrop-filter: blur(40px);
	}

	/* Desktop card size: 463×547 — grid caps column width; cards stay fluid below */
	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 463px));
		justify-content: center;
		align-items: stretch;
		gap: 1rem;
	}

	/* Reveal wrappers must fill the grid cell so cards can stretch equal height */
	.services-grid__cell {
		display: flex;
		min-width: 0;
		height: 100%;
	}

	/* Size only — glass chrome lives in global.css (.service-card) */
	.services-grid :global(.service-card) {
		max-width: 463px;
		width: 100%;
		height: 100%;
		min-height: 547px;
	}

	@media (max-width: 1280px) {
		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 463px));
		}
	}

	@media (max-width: 720px) {
		.services-grid {
			grid-template-columns: minmax(0, 463px);
		}
	}

	/* Tablet: 2-col through 640–1023 (incl. former 1-col 640–720); 3-col when cards ≥280px */
	@media (min-width: 640px) and (max-width: 720px) {
		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.services-grid > :last-child:nth-child(odd) {
			grid-column: 1 / -1;
			justify-self: center;
			width: 100%;
			max-width: min(463px, calc(50% - 0.5rem));
		}
	}

	@media (min-width: 1024px) and (max-width: 1199px) {
		.services-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
