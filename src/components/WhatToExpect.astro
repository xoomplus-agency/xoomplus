---
import Section from './Section.astro';

const items = [
	{
		title: 'Complete Attribution Transparency',
		text: 'Direct visibility into campaign analytics, code assets and conversion data to track your investment against real revenue, not vanity metrics.',
	},
	{
		title: 'Open & Direct Communication',
		text: 'Direct access to the senior specialists working on your brand, with regular updates, clear conversations and zero account-handling layers.',
	},
	{
		title: 'Revenue-Focused Growth',
		text: 'A unified, long-term digital strategy designed around your specific profit margins, commercial goals and sustainable market expansion.',
	},
];
---

<Section aria-labelledby="expect-heading">
	<div class="expect">
		<div class="expect__left" data-reveal="up">
			<p class="pill-light m-0">Regional Roots & Nationwide Capabilities</p>
			<h2
				id="expect-heading"
				class="expect__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Headquartered in Blackburn. Powering Growth Across Manchester and the UK.
			</h2>
			<div class="expect__intro">
				<p class="text-on-light m-0">
					Headquartered on King Street in Blackburn, Xoomplus provides dedicated digital marketing and
					technical SEO services across Manchester and the wider UK commercial landscape.
				</p>
				<p class="text-on-light m-0">
					We give ambitious businesses direct access to senior-level talent without the bloated
					retainers of city-centre firms. Our focus is simple: building integrated digital engines
					that deliver sustainable, long-term commercial scale.
				</p>
			</div>
		</div>

		<ul class="expect__list m-0 list-none p-0" role="list" data-reveal-group>
			{
				items.map((item) => (
					<li class="expect__item" data-reveal="up">
						<span class="expect__check" aria-hidden="true">
							<svg
								width="20"
								height="20"
								viewBox="0 0 18 18"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<circle cx="9" cy="9" r="9" fill="#FFA800" />
								<path
									d="M5.25 9.25L7.75 11.75L12.75 6.5"
									stroke="#ffffff"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						<div class="expect__item-body">
							<h3 class="expect__item-title m-0">{item.title}</h3>
							<p class="expect__item-text m-0">{item.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Section>

<style>
	.expect {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 80px;
	}

	.expect__left {
		flex: 0 1 46%;
		min-width: 0;
		text-align: left;
	}

	.expect__heading {
		margin-top: 16px;
		max-width: 540px;
		line-height: 1.15;
	}

	.expect__intro {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 16px;
		max-width: 540px;
	}

	.expect__intro :global(p) {
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-on-light);
	}

	.expect__list {
		flex: 0 1 46%;
		min-width: 0;
		width: 100%;
	}

	.expect__item {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 20px 0;
		border-bottom: 1px solid #ededed;
	}

	.expect__item:first-child {
		padding-top: 0;
	}

	.expect__check {
		display: inline-flex;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		margin-top: 4px;
	}

	.expect__check svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.expect__item-body {
		flex: 1;
		min-width: 0;
	}

	.expect__item-title {
		font-family: var(--font-inter);
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.expect__item-text {
		margin-top: 8px;
		max-width: none;
		width: 100%;
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
		color: #555555;
		text-wrap: pretty;
	}

	@media (max-width: 1023px) {
		.expect {
			flex-direction: column;
			gap: 40px;
		}

		.expect__left,
		.expect__list {
			flex: none;
			width: 100%;
		}
	}

	@media (min-width: 900px) and (max-width: 1023px) {
		.expect {
			flex-direction: row;
			align-items: flex-start;
			gap: 40px;
		}

		.expect__left,
		.expect__list {
			flex: 1 1 50%;
			width: auto;
		}
	}

	@media (max-width: 639px) {
		.expect__heading {
			font-size: clamp(1.75rem, 8vw, 2rem);
		}

		.expect__check {
			width: 18px;
			height: 18px;
		}

		.expect__item-title {
			font-size: clamp(1.25rem, 5vw, 1.25rem);
		}
	}
</style>
