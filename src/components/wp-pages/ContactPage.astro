---
import PageHero from '../PageHero.astro';
import ContactEnquiry from '../ContactEnquiry.astro';
import WhatHappensNext from '../WhatHappensNext.astro';
---

<main id="main-content" class="page-contact flex-1">
	<PageHero title="Contact us" titleTag="p" />
	<ContactEnquiry />
	<WhatHappensNext />
</main>

<style is:global>
	.page-contact .enquiry__intro {
		max-width: min(100%, 680px);
	}

	@media (min-width: 1280px) {
		.page-contact .enquiry {
			grid-template-columns: 1.25fr 1fr;
		}
	}
</style>
