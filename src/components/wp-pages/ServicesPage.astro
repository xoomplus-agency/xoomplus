---
import PageHero from '../PageHero.astro';
import BetterTogether from '../BetterTogether.astro';
import ServicesOverview from '../ServicesOverview.astro';
import ServiceDetail from '../ServiceDetail.astro';
import ServiceDetailPair from '../ServiceDetailPair.astro';
import FAQ from '@/components/FAQ.astro';
import CTASection from '@/components/CTASection.astro';
---

<main id="main-content" class="page-our-services flex-1">
	<PageHero title="Our services" />
	<BetterTogether />
	<ServicesOverview />
	<ServiceDetail serviceId="seo" />
	<ServiceDetailPair serviceId="social-paid-media" />
	<ServiceDetail serviceId="digital-infrastructure" />
	<FAQ
		page="our-services"
		id="our-services-faq"
		pill="Straightforward Answers"
		heading="Frequently Asked Questions About Our Services"
		text="Clear answers about how our service pillars work together to grow your business."
	/>
	<CTASection
		pill="Ready to Scale"
		heading="Let’s Move Your Business Forward"
		text="Tell us what you are working towards. We will look at your current digital setup, outline the possibilities and recommend the best place to start."
	/>
</main>

<style is:global>
	@media (min-width: 1024px) {
		.page-our-services .bt-header__aside {
			max-width: 620px;
		}

		.page-our-services .service-detail .sd-header__aside {
			max-width: 620px;
		}

		.page-our-services .service-detail-pair .sdp-header__aside {
			max-width: 560px;
		}
	}
</style>
