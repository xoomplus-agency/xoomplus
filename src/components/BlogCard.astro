---
import { postUrl, type WpPost } from '../lib/wp';

interface Props {
	image: string;
	alt: string;
	category: string;
	title: string;
	excerpt: string;
	/**
	 * Prefer passing `post` so the href always comes from CMS `path` via postUrl().
	 * If only `href` is passed, it must already be the WordPress path (not /blogs/<slug>).
	 */
	post?: Pick<WpPost, 'path' | 'slug' | 'id' | 'title'>;
	href?: string;
	/** Smaller title/excerpt for narrow sidebar cards only */
	size?: 'default' | 'compact';
	/** Title heading level — default h3 keeps existing outlines */
	headingLevel?: 'h2' | 'h3';
	srcset?: string;
	sizes?: string;
	width?: number;
	height?: number;
	/** First-row cards use `eager`; the rest stay `lazy`. */
	loading?: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	image: imageProp,
	alt: altProp,
	category: categoryProp,
	title: titleProp,
	excerpt: excerptProp,
	post,
	href: hrefProp,
	size = 'default',
	headingLevel = 'h3',
	srcset,
	sizes = '(min-width:1024px) 33vw, 100vw',
	width = 400,
	height = 240,
	loading = 'lazy',
	fetchpriority,
} = Astro.props;

/** Null-safe — a missing field must not blank the whole listing grid. */
const title = (titleProp ?? post?.title ?? 'Untitled').toString();
const excerpt = (excerptProp ?? '').toString();
const category = (categoryProp ?? '').toString();
const image = (imageProp || '/images/1st.webp').toString();
const alt = (altProp || title).toString();

let href = '#';
try {
	href = post
		? postUrl(post)
		: hrefProp
			? postUrl({ path: hrefProp, slug: post?.slug || title, id: post?.id ?? 0, title })
			: post?.path
				? postUrl({ path: post.path, slug: post.slug || title, id: post.id ?? 0, title })
				: '#';
} catch (err) {
	console.error(`[BlogCard] href resolve failed for "${title}":`, err);
	href = '#';
}

const TitleTag = headingLevel;
const showCategory = Boolean(category.trim());
---

<article class:list={['blog-card-wrap', size === 'compact' && 'blog-card-wrap--compact']}>
	<a class="blog-card" href={href}>
		<div class="blog-card__media">
			<img
				class="blog-card__img"
				src={image}
				srcset={srcset || undefined}
				sizes={srcset ? sizes : undefined}
				alt={alt}
				width={width || 400}
				height={height || 240}
				loading={loading}
				decoding="async"
				fetchpriority={fetchpriority}
			/>
		</div>

		<div class="blog-card__meta">
			{
				showCategory ? (
					<span class="blog-card__category">
						<span class="blog-card__dot" aria-hidden="true"></span>
						{category}
					</span>
				) : (
					<span class="blog-card__category" aria-hidden="true"></span>
				)
			}
			<span class="blog-card__label">From our blog</span>
		</div>

		<TitleTag class="blog-card__title">{title}</TitleTag>
		<p class="blog-card__excerpt">{excerpt}</p>

		<div class="blog-card__footer">
			<span class="blog-card__read">Read more</span>
			<svg
				class="blog-card__arrow"
				width="16"
				height="16"
				viewBox="0 0 16 16"
				fill="none"
				aria-hidden="true"
			>
				<path
					d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"
					stroke="#FFA800"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</div>
	</a>
</article>

<style>
	.blog-card-wrap {
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 100%;
	}

	.blog-card {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 20px;
		border: 1px solid #eeeeee;
		border-radius: 24px;
		background: #ffffff;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.blog-card:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	.blog-card__media {
		overflow: hidden;
		border-radius: 16px;
	}

	.blog-card__img {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 3;
		height: auto;
		object-fit: cover;
		border-radius: 16px;
		transition: transform 0.3s ease;
	}

	.blog-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 16px;
	}

	.blog-card__category {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 500;
		line-height: 1.3;
		color: #555555;
		min-height: 1.3em;
	}

	.blog-card__dot {
		flex-shrink: 0;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffa800;
	}

	.blog-card__label {
		font-family: var(--font-inter);
		font-size: 11px;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #888888;
		white-space: nowrap;
	}

	.blog-card__title {
		margin: 12px 0 0;
		font-family: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Inter',
			sans-serif;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-primary-black);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(1.25em * 2);
	}

	.blog-card__excerpt {
		margin: 12px 0 20px;
		font-family: var(--font-inter);
		font-size: clamp(1rem, 2vw, 1.125rem);
		font-weight: 400;
		line-height: 1.5;
		color: #555555;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Sidebar-only denser type — home /blogs listing unchanged */
	.blog-card-wrap--compact .blog-card__title {
		font-size: var(--text-lead);
		min-height: calc(1.25em * 2);
	}

	.blog-card-wrap--compact .blog-card__excerpt {
		font-size: var(--text-small);
	}

	.blog-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid rgba(85, 85, 85, 0.15);
	}

	.blog-card__read {
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-primary-black);
	}

	.blog-card__arrow {
		flex-shrink: 0;
		display: block;
		transition: transform 0.3s ease;
	}

	@media (hover: hover) {
		.blog-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		}

		.blog-card:hover .blog-card__img {
			transform: scale(1.04);
		}

		.blog-card:hover .blog-card__arrow {
			transform: translate(3px, -3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-card,
		.blog-card__img,
		.blog-card__arrow {
			transition: none;
		}

		.blog-card:hover {
			transform: none;
			box-shadow: none;
		}

		.blog-card:hover .blog-card__img,
		.blog-card:hover .blog-card__arrow {
			transform: none;
		}
	}
</style>
