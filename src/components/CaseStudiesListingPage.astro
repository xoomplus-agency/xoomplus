---
/**
 * Case studies listing body (markup + styles unchanged from former /case-studies page).
 * Served at the live WP slug for ID 1037 and at /case-studies when that is the live slug.
 */
import PageHero from './PageHero.astro';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import CTASection from './CTASection.astro';
import { projects } from '../data/projects';
---

<main id="main-content" class="flex-1">
	<PageHero title="Case studies" />

	<Section aria-labelledby="case-studies-heading">
		<div class="cs-listing__header" data-reveal="up">
			<div class="cs-listing__intro">
				<p class="pill-light">Selected work</p>
				<h2
					id="case-studies-heading"
					class="cs-listing__heading text-h2 font-semibold tracking-[-0.02em] text-primary-black"
				>
					Clear challenges.<br />
					Considered directions.
				</h2>
			</div>
			<p class="cs-listing__aside text-on-light">
				Draft examples from our landing-page portfolio. Imagery is illustrative; the
				directions below are not verified client engagements or performance results.
			</p>
		</div>

		<ul class="cs-listing__grid m-0 list-none p-0" role="list" data-reveal-group>
			{
				projects.map((project) => (
					<li class="cs-listing__item" data-reveal="up">
						<ProjectCard
							category={project.category}
							name={project.name}
							image={project.image}
							imageAlt={project.imageAlt}
							imageClass={project.imageClass}
							tags={project.tags}
							title={project.title}
							excerpt={project.excerpt}
							href={project.href}
							bordered
							shiftImage
							glow
						/>
					</li>
				))
			}
		</ul>
	</Section>

	<CTASection />
</main>

<style>
	.cs-listing__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.cs-listing__intro {
		min-width: 0;
	}

	.cs-listing__heading {
		margin: 16px 0 0;
	}

	.cs-listing__aside {
		flex-shrink: 0;
		max-width: 360px;
		margin: 0;
		font-size: 18px;
		line-height: 1.5;
		text-align: left;
		color: var(--color-text-on-light);
	}

	.cs-listing__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
		margin-top: 32px;
	}

	.cs-listing__item {
		display: flex;
		min-width: 0;
		height: 100%;
	}

	@media (max-width: 1023px) {
		.cs-listing__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.cs-listing__aside {
			max-width: 100%;
		}
	}

	@media (max-width: 639px) {
		.cs-listing__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
