---
import Section from './Section.astro';

/**
 * Icons live in /public/icons/ (no /public/assets folder).
 * All four SVGs use fill #FFA800 — no color fallback needed.
 */
const principles = [
	{
		icon: '/icons/simplicity-essential.svg',
		title: 'Synchronised Funnel',
		text: 'We align your site architecture, organic search strategy and performance ads into a single strategy where one channel strengthens the next.',
	},
	{
		icon: '/icons/remain-inquisitive.svg',
		title: 'Commercial Value',
		text: 'We do not hide behind impressions or surface-level engagement. We focus on pipeline velocity, customer acquisition cost and sales revenue.',
	},
	{
		icon: '/icons/focus-on-every-detail.svg',
		title: 'Access to Senior Talent',
		text: 'You communicate directly with the lead engineers, SEO directors and top media buyers who run your campaigns daily.',
	},
	{
		icon: '/icons/evolve-through-teamwork.svg',
		title: 'Operational Transparency',
		text: 'Trust requires total visibility. You retain full ownership of your data, source code, ad platforms and conversion tracking, without any opaque retainers.',
	},
];
---

<Section aria-labelledby="guides-heading">
	<div class="guides-header" data-reveal="up">
		<p class="pill-light mb-5">Operating Principles</p>
		<h2
			id="guides-heading"
			class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
		>
			Uncompromising Standards. Zero Fluff.
		</h2>
		<p class="text-on-light mx-auto max-w-[640px]">
			Four core principles shape how our senior team designs, builds and scales your brand.
		</p>
	</div>

	<ul class="guides-grid m-0 list-none p-0" role="list" data-reveal-group>
		{
			principles.map((item) => (
				<li class="why-card guides-card" data-reveal="up">
					<div class="guides-card__icon" aria-hidden="true">
						<img
							src={item.icon}
							alt=""
							width="20"
							height="20"
							decoding="async"
							loading="lazy"
						/>
					</div>
					<h3 class="guides-card__title m-0">{item.title}</h3>
					<p class="guides-card__text m-0">{item.text}</p>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.guides-header {
		max-width: 820px;
		margin-inline: auto;
		text-align: center;
	}

	.guides-header :global(.text-on-light) {
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
	}

	/* pb leaves room so why-card hover shadows are not clipped */
	.guides-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		margin-top: 40px;
		padding-bottom: 24px;
		align-items: stretch;
	}

	.guides-card {
		align-items: flex-start;
		justify-content: flex-start;
		height: 100%;
		gap: 0;
		padding: 1.5rem 1.25rem;
		text-align: left;
	}

	.guides-card__icon {
		display: flex;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 168, 0, 0.2);
		border-radius: 10px;
		background-color: rgba(255, 168, 0, 0.05);
	}

	.guides-card__icon img {
		display: block;
		width: 20px;
		height: 20px;
		object-fit: contain;
	}

	.guides-card__title {
		margin-top: 20px;
		font-family: var(--font-inter);
		font-size: var(--text-h3);
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-primary-black);
	}

	.guides-card__text {
		margin-top: 10px;
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
		color: #555555;
	}

	/*
	 * 1024–1279: 2 columns — 4 equal columns leave ~180–220px cards,
	 * too narrow for 24px/18px copy without overflow.
	 */
	@media (max-width: 1279px) {
		.guides-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 639px) {
		.guides-grid {
			grid-template-columns: 1fr;
		}

		.guides-card {
			padding: 1.25rem 1rem;
		}

		.guides-card__title {
			font-size: clamp(1.25rem, 5vw, 1.25rem); /* 20px */
		}
	}
</style>
