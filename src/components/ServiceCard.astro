---
type FeatureItem = string | { label: string; href?: string };

interface Props {
	title: string;
	icon: string;
	description: string;
	features: FeatureItem[];
	cta: { label: string; href: string };
	/** Overrides `cta.label` when provided. */
	buttonLabel?: string;
	/** Arrow after the label. Default keeps home / About cards unchanged. */
	buttonIcon?: 'right' | 'down';
	/** Optional price amount shown under the title (e.g. pricing page). */
	price?: string;
	/** Optional period next to price (e.g. "/month"). */
	period?: string;
	/** When false, the icon is omitted. Default true keeps existing cards unchanged. */
	showIcon?: boolean;
	class?: string;
}

const {
	title,
	icon,
	description,
	features,
	cta,
	buttonLabel,
	buttonIcon = 'right',
	price,
	period,
	showIcon = true,
	class: className = '',
} = Astro.props;

const label = buttonLabel ?? cta.label;
const arrow = buttonIcon === 'down' ? '↓' : '→';
const hasPrice = Boolean(price);

function featureLabel(feature: FeatureItem): string {
	return typeof feature === 'string' ? feature : feature.label;
}

function featureHref(feature: FeatureItem): string | undefined {
	return typeof feature === 'string' ? undefined : feature.href;
}
---

<article class:list={['service-card', 'flex', 'h-full', 'flex-col', className]}>
	{
		showIcon ? (
			<img
				src={icon}
				alt=""
				width="47"
				height="47"
				class="mb-5 size-[47px] object-contain"
				decoding="async"
				loading="lazy"
				aria-hidden="true"
			/>
		) : null
	}
	<h3
		class:list={[
			'text-h3 font-medium tracking-[-0.02em] text-secondary-white',
			hasPrice ? 'mb-0' : 'mb-3',
		]}
	>
		{title}
	</h3>
	{
		hasPrice ? (
			<p class="service-card__price m-0">
				<span class="service-card__price-amount">{price}</span>
				{period ? <span class="service-card__price-period">{period}</span> : null}
			</p>
		) : null
	}
	<p
		class:list={[
			'text-small mb-5 text-[var(--text-body-dark)] [font-family:var(--font-inter)]',
			hasPrice && 'mt-3',
		]}
	>
		{description}
	</p>
	<ul class="mb-8 flex flex-1 list-none flex-col gap-2.5 p-0">
		{
			features.map((feature) => {
				const text = featureLabel(feature);
				const href = featureHref(feature);
				return (
					<li class="service-feature flex items-start gap-2.5 text-[14px] leading-snug [font-family:var(--font-inter)]">
						<span
							class="service-check mt-0.5 inline-flex size-[18px] shrink-0 items-center justify-center rounded-full"
							aria-hidden="true"
						>
							<svg width="10" height="8" viewBox="0 0 10 8" fill="none">
								<path
									d="M1 4l2.5 2.5L9 1"
									stroke="#0B0A0B"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						{href ? (
							<a class="service-feature__link" href={href}>
								{text}
							</a>
						) : (
							text
						)}
					</li>
				);
			})
		}
	</ul>
	<a class="service-card-btn mt-auto" href={cta.href}>
		{label}
		<span aria-hidden="true">{arrow}</span>
	</a>
</article>

<style>
	.service-feature__link {
		color: inherit;
		text-decoration: none;
	}

	.service-feature__link:hover {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.service-feature__link:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	.service-card__price {
		display: flex;
		align-items: baseline;
		gap: 0.2em;
		margin-top: 12px;
		margin-bottom: 0;
		font-family: inherit;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.service-card__price-amount {
		font-size: 36px;
		font-weight: 500;
	}

	.service-card__price-period {
		font-size: var(--text-body);
		font-weight: 500;
		color: rgb(255 255 255 / 0.7);
	}
</style>
