---
/**
 * Shared Google Maps embed (home ContactSection + contact page full-bleed).
 *
 * Note: This embed currently points to Islamabad (Xoomplus pin), while the
 * site address is Blackburn. Swap MAP_EMBED_SRC for a Blackburn embed when ready.
 */
const MAP_EMBED_SRC =
	'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3321.045703617947!2d73.04037407515959!3d33.65597763855125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df95000d84e457%3A0xe13a404eab3f5547!2sXoomplus!5e0!3m2!1sen!2s!4v1791444163528!5m2!1sen!2s';

interface Props {
	/** Border radius in px — home uses 20; full-bleed contact map uses 0 */
	radius?: number;
	class?: string;
}

const { radius = 20, class: className = '' } = Astro.props;
---

<div
	class:list={['location-map', className]}
	style={`--map-radius: ${radius}px`}
>
	<iframe
		src={MAP_EMBED_SRC}
		title="Xoomplus location map"
		width="600"
		height="450"
		allowfullscreen
		loading="lazy"
		referrerpolicy="strict-origin-when-cross-origin"
	></iframe>
</div>

<style>
	.location-map {
		width: 100%;
		overflow: hidden;
		line-height: 0;
		border-radius: var(--map-radius, 20px);
	}

	.location-map iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
