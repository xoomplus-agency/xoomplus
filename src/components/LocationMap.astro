---
/**
 * Static map image (home ContactSection + contact page full-bleed).
 * Image only for now — not an interactive Google Maps embed.
 */
const MAP_IMAGE_SRC = '/images/mall-blackburn-map.webp';
const MAP_LINK_HREF =
	'https://www.google.com/maps/place/The+Mall+Blackburn/@53.7484012,-2.4846822,17z';

interface Props {
	/** Border radius in px — home uses 20; full-bleed contact map uses 0 */
	radius?: number;
	class?: string;
}

const { radius = 20, class: className = '' } = Astro.props;
---

<a
	class:list={['location-map', className]}
	href={MAP_LINK_HREF}
	target="_blank"
	rel="noopener noreferrer"
	style={`--map-radius: ${radius}px`}
	aria-label="Open The Mall Blackburn on Google Maps"
>
	<img
		src={MAP_IMAGE_SRC}
		alt="Map showing The Mall Blackburn, Church Street, Blackburn"
		width="1600"
		height="520"
		loading="lazy"
		decoding="async"
	/>
</a>

<style>
	.location-map {
		display: block;
		width: 100%;
		overflow: hidden;
		line-height: 0;
		border-radius: var(--map-radius, 20px);
		outline: none;
	}

	.location-map:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	.location-map img {
		display: block;
		width: 100%;
		max-width: none;
		height: 100%;
		/* Beat global `img { h-auto }` so cover fill works in fixed-height slots */
		object-fit: cover;
		object-position: center;
	}
</style>
