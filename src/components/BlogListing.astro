---
import Section from './Section.astro';
import BlogCard from './BlogCard.astro';
import BlogPostsGrid from './BlogPostsGrid.astro';
import BlogSearch from './BlogSearch.astro';
import { BLOG_IMAGE_PLACEHOLDER } from '../lib/wp';
import { BLOG_LIST_PAGE_SIZE } from '../lib/wp-posts';

const PAGE_SIZE = BLOG_LIST_PAGE_SIZE;
---

<Section aria-labelledby="blogs-heading">
	<div
		data-blog-listing
		data-api="/api/blog-posts"
		data-per-page={String(PAGE_SIZE)}
	>
	<template id="blog-card-template">
		<!-- No data-reveal: cloned Load More cards are never observed by reveal.ts -->
		<li class="blog-listing__item" data-post-card data-category="template">
			<BlogCard
				headingLevel="h3"
				post={{ id: 0, slug: 'template', path: '/template/post/', title: 'Template' }}
				image={BLOG_IMAGE_PLACEHOLDER}
				alt="Blog article placeholder"
				title="Template"
				excerpt="Excerpt"
			/>
		</li>
	</template>
	<div class="blog-listing__header">
		<div class="blog-listing__intro" data-reveal="up">
			<p class="pill-light">Explore the blog</p>
			<h2
				id="blogs-heading"
				class="blog-listing__heading text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				The latest thinking.
			</h2>
		</div>

		<BlogSearch />
	</div>

	<hr class="blog-listing__divider" />

	<noscript>
		<style>
			[data-post-card][hidden] {
				display: block !important;
			}
			[data-blog-load-more],
			[data-blog-search-wrap] {
				display: none !important;
			}
		</style>
	</noscript>

	{/*
	  Render BlogPostsGrid inline (SSR). server:defer islands break on cPanel/Passenger
	  when island chunks are missing or deploy hashes drift — /blog then 500s.
	*/}
	<BlogPostsGrid />
	</div>
</Section>

<script>
	import '../scripts/blog-list.ts';
</script>

<style is:global>
	/* Ensure [hidden] always wins over grid/flex display utilities */
	[data-blog-listing] [hidden] {
		display: none !important;
	}

	/*
	  Grid/meta/load-more render inside BlogPostsGrid.
	  Keep rules global so the listing inherits layout.
	*/
	[data-blog-listing] .blog-listing__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 0;
	}

	[data-blog-listing] .blog-listing__meta-left,
	[data-blog-listing] .blog-listing__meta-right {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	[data-blog-listing] .blog-listing__empty {
		margin: 20px 0 0;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	[data-blog-listing] .blog-listing__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		margin-top: 40px;
	}

	[data-blog-listing] .blog-listing__item {
		min-width: 0;
		height: 100%;
	}

	[data-blog-listing] .blog-listing__load-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 40px;
	}

	[data-blog-listing] .blog-listing__load-more[hidden],
	[data-blog-listing] .blog-listing__load-more #load-more[hidden] {
		display: none !important;
	}

	[data-blog-listing] .blog-listing__load-status {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.4;
		color: #888888;
		text-align: center;
	}

	[data-blog-listing] .blog-listing__item[hidden] {
		display: none !important;
	}

	@media (min-width: 640px) {
		[data-blog-listing] .blog-listing__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		[data-blog-listing] .blog-listing__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 639px) {
		[data-blog-listing] .blog-listing__meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

<style>
	.blog-listing__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		overflow: visible;
	}

	.blog-listing__intro {
		min-width: 0;
	}

	.blog-listing__heading {
		margin: 16px 0 0;
	}

	.blog-listing__divider {
		margin: 40px 0;
		border: 0;
		border-top: 1px solid #e9e9e7;
	}

	@media (max-width: 1023px) {
		.blog-listing__header {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 639px) {
		.blog-listing__header {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
