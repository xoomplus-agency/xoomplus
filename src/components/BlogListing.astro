---
import Section from './Section.astro';
import BlogCard from './BlogCard.astro';
import Button from './Button.astro';
import {
	BLOG_IMAGE_PLACEHOLDER,
	categoryKey,
	getPosts,
	postUrl,
} from '../lib/wp';

const PAGE_SIZE = 9;

const blogs = await getPosts({ all: true });

/** Unique categories: filter value = categoryKey(name), label = display name. */
const categoryByKey = new Map<string, string>();
for (const post of blogs) {
	const key = categoryKey(post.category || post.categorySlug);
	if (!key || key === 'all') continue;
	if (!categoryByKey.has(key)) {
		categoryByKey.set(key, post.category || post.categorySlug);
	}
}
const categoryFilters = [...categoryByKey.entries()].sort((a, b) =>
	a[1].localeCompare(b[1]),
);

const initialVisible = Math.min(PAGE_SIZE, blogs.length);

/** Compact search index for the dropdown only (not the grid). */
const searchIndex = blogs.map((post) => ({
	t: post.title,
	e: post.excerpt,
	c: post.category || '',
	p: postUrl(post),
	i: post.image?.src ?? BLOG_IMAGE_PLACEHOLDER,
}));
---

<Section aria-labelledby="blogs-heading">
	<div data-blog-listing>
	<script
		type="application/json"
		id="blog-search-index"
		set:html={JSON.stringify(searchIndex)}
	/>
	<div class="blog-listing__header">
		<div class="blog-listing__intro" data-reveal="up">
			<p class="pill-light">Explore the blog</p>
			<h2
				id="blogs-heading"
				class="blog-listing__heading text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				The latest thinking.
			</h2>
		</div>

		<div class="blog-listing__search" data-blog-search-wrap>
			<label class="sr-only" for="blog-search">Search articles</label>
			<svg
				class="blog-listing__search-icon"
				width="16"
				height="16"
				viewBox="0 0 16 16"
				fill="none"
				aria-hidden="true"
			>
				<path
					d="M7 12.5A5.5 5.5 0 1 0 7 1.5a5.5 5.5 0 0 0 0 11Z"
					stroke="#555555"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<path
					d="m11.5 11.5 2.75 2.75"
					stroke="#555555"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<input
				id="blog-search"
				class="blog-listing__search-input"
				type="search"
				name="q"
				placeholder="Search articles"
				autocomplete="off"
				role="combobox"
				aria-autocomplete="list"
				aria-controls="blog-search-results"
				aria-expanded="false"
				aria-haspopup="listbox"
				data-blog-search
			/>
			<div
				id="blog-search-results"
				class="blog-listing__search-results"
				role="listbox"
				aria-label="Search results"
				hidden
				data-blog-search-results
			></div>
			<p class="sr-only" role="status" aria-live="polite" data-blog-search-live></p>
		</div>
	</div>

	<div
		class="blog-listing__filters"
		role="group"
		aria-label="Filter articles by category"
		data-blog-filters
	>
		<button
			type="button"
			class="blog-listing__chip is-active"
			aria-pressed="true"
			data-filter-chip
			data-filter="all"
		>
			All articles
		</button>
		{
			categoryFilters.map(([key, label]) => (
				<button
					type="button"
					class="blog-listing__chip"
					aria-pressed="false"
					data-filter-chip
					data-filter={key}
				>
					{label}
				</button>
			))
		}
	</div>

	<hr class="blog-listing__divider" />

	<div class="blog-listing__meta">
		<p class="blog-listing__meta-left">
			<span data-blog-perspective>All perspectives</span>
			{' '}· <span data-blog-count>{initialVisible}</span> of{' '}
			<span data-blog-matching>{blogs.length}</span> articles shown
		</p>
	</div>

	<p class="blog-listing__empty" role="status" aria-live="polite" hidden data-blog-empty>
		No articles in this category.
	</p>

	<noscript>
		<style>
			[data-post-card][hidden] {
				display: block !important;
			}
			[data-blog-load-more],
			[data-blog-search-wrap] {
				display: none !important;
			}
		</style>
	</noscript>

	<ul
		id="blog-listing-grid"
		class="blog-listing__grid m-0 list-none p-0"
		role="list"
		data-page-size={String(PAGE_SIZE)}
		data-total={String(blogs.length)}
		data-blog-grid
		data-reveal-group
	>
		{
			blogs.map((post, index) => (
				<li
					class="blog-listing__item"
					data-reveal="up"
					data-post-card
					data-category={categoryKey(post.category || post.categorySlug)}
					hidden={index >= PAGE_SIZE ? true : undefined}
				>
					<BlogCard
						headingLevel="h3"
						post={post}
						image={post.image?.src ?? BLOG_IMAGE_PLACEHOLDER}
						alt={post.image?.alt ?? post.title}
						srcset={post.image?.srcset}
						width={post.image?.width ?? 400}
						height={post.image?.height ?? 240}
						category={post.category}
						title={post.title}
						excerpt={post.excerpt}
					/>
				</li>
			))
		}
	</ul>

	<div class="blog-listing__load-more" data-blog-load-more hidden={blogs.length <= PAGE_SIZE ? true : undefined}>
		<Button
			type="button"
			id="load-more"
			class="!w-[220px]"
			aria-controls="blog-listing-grid"
			aria-label="Load more articles"
			hidden={blogs.length <= PAGE_SIZE ? true : undefined}
		>
			Load more
			<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
				<path
					d="M8 3v10M4 9l4 4 4-4"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</Button>
		<p
			class="blog-listing__load-status"
			role="status"
			aria-live="polite"
			data-blog-load-status
		>
			Showing {initialVisible} of {blogs.length} articles
		</p>
	</div>
	</div>
</Section>

<script>
	import '../scripts/blog-list.ts';
</script>

<style is:global>
	/* Ensure [hidden] always wins over grid/flex display utilities */
	[data-blog-listing] [hidden] {
		display: none !important;
	}
</style>

<style>
	.blog-listing__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		overflow: visible;
	}

	.blog-listing__intro {
		min-width: 0;
	}

	.blog-listing__heading {
		margin: 16px 0 0;
	}

	.blog-listing__search {
		position: relative;
		z-index: 20;
		flex: 1 1 360px;
		width: auto;
		min-width: min(280px, 100%);
		max-width: min(640px, 100%);
	}

	.blog-listing__search-icon {
		position: absolute;
		top: 20px;
		left: 14px;
		z-index: 2;
		display: block;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.blog-listing__search-input {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		width: 100%;
		height: 40px;
		padding: 0 14px 0 38px;
		border: 1px solid #e9e9e7;
		border-radius: 8px;
		background: #ffffff;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.4;
		color: var(--color-primary-black);
		outline: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			border-radius 0.15s ease;
	}

	.blog-listing__search-input::placeholder {
		color: #888888;
	}

	.blog-listing__search-input:focus {
		border-color: #ffa800;
		box-shadow: 0 0 0 3px rgba(255, 168, 0, 0.18);
	}

	.blog-listing__search.is-open .blog-listing__search-input {
		border-color: #e9e9e7;
		border-bottom-color: transparent;
		border-radius: 8px 8px 0 0;
		box-shadow: none;
	}

	.blog-listing__search.is-open .blog-listing__search-input:focus {
		border-color: #e9e9e7;
		border-bottom-color: transparent;
		box-shadow: none;
	}

	.blog-listing__search-results {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		z-index: 40;
		box-sizing: border-box;
		max-height: min(320px, 70vh);
		padding: 12px;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 1px solid #e9e9e7;
		border-top: 1px solid #eeeeee;
		border-radius: 0 0 8px 8px;
		background: #ffffff;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
	}

	.blog-listing__search-results::-webkit-scrollbar {
		width: 6px;
	}

	.blog-listing__search-results::-webkit-scrollbar-thumb {
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.25);
	}

	.blog-listing__search-results[hidden] {
		display: none;
	}

	/*
	 * Result rows are injected via innerHTML â€” they lack Astro scoped attrs.
	 * Scope under the static .blog-listing__search-results parent with :global().
	 */
	.blog-listing__search-results :global(.blog-listing__search-option) {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: flex-start;
		gap: 12px;
		box-sizing: border-box;
		width: 100%;
		padding: 10px 0;
		border: 0;
		border-bottom: 1px solid #e9e9e7;
		border-radius: 0;
		background: transparent;
		color: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.blog-listing__search-results :global(.blog-listing__search-option:last-child) {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.blog-listing__search-results :global(.blog-listing__search-option:first-child) {
		padding-top: 0;
	}

	.blog-listing__search-results :global(.blog-listing__search-option.is-active),
	.blog-listing__search-results :global(.blog-listing__search-option:focus-visible) {
		background: #f7f7f5;
		outline: none;
	}

	@media (hover: hover) {
		.blog-listing__search-results :global(.blog-listing__search-option:hover) {
			background: #f7f7f5;
		}
	}

	.blog-listing__search-results :global(.blog-listing__search-media) {
		flex: 0 0 64px;
		width: 64px;
		height: 48px;
		overflow: hidden;
		border-radius: 8px;
		background: #f3f3f1;
	}

	.blog-listing__search-results :global(.blog-listing__search-thumb) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		border-radius: 8px;
		object-fit: cover;
	}

	.blog-listing__search-results :global(.blog-listing__search-body) {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.blog-listing__search-results :global(.blog-listing__search-title) {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-primary-black);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-listing__search-results :global(.blog-listing__search-cat) {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.3;
		color: #888888;
	}

	.blog-listing__search-results :global(.blog-listing__search-empty) {
		margin: 0;
		padding: 4px 2px;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.4;
		color: #888888;
	}

	@media (max-width: 639px) {
		.blog-listing__search-results {
			max-height: min(280px, 60vh);
			padding: 10px;
		}

		.blog-listing__search-results :global(.blog-listing__search-option) {
			gap: 10px;
		}

		.blog-listing__search-results :global(.blog-listing__search-media) {
			flex: 0 0 56px;
			width: 56px;
			height: 42px;
		}

		.blog-listing__search-results :global(.blog-listing__search-title) {
			font-size: 13px;
		}
	}

	.blog-listing__filters {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.blog-listing__chip {
		box-sizing: border-box;
		padding: 8px 16px;
		border: 1px solid #e9e9e7;
		border-radius: 9999px;
		background: #ffffff;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-primary-black);
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform var(--dur-fast) var(--ease-out);
	}

	.blog-listing__chip.is-active {
		border-color: #ffa800;
		background: #ffa800;
		color: var(--color-primary-black);
	}

	.blog-listing__chip:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	@media (hover: hover) {
		.blog-listing__chip:hover {
			border-color: #ffa800;
		}
	}

	.blog-listing__divider {
		margin: 40px 0;
		border: 0;
		border-top: 1px solid #e9e9e7;
	}

	.blog-listing__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 0;
	}

	.blog-listing__meta-left,
	.blog-listing__meta-right {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	.blog-listing__empty {
		margin: 20px 0 0;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	.blog-listing__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		margin-top: 40px;
		content-visibility: visible;
	}

	.blog-listing__item {
		min-width: 0;
		height: 100%;
		content-visibility: visible;
	}

	.blog-listing__load-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 40px;
	}

	.blog-listing__load-more[hidden],
	.blog-listing__load-more :global(#load-more[hidden]) {
		display: none !important;
	}

	.blog-listing__load-status {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.4;
		color: #888888;
		text-align: center;
	}

	.blog-listing__item[hidden] {
		display: none !important;
	}

	@media (min-width: 640px) {
		.blog-listing__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.blog-listing__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 1023px) {
		.blog-listing__header {
			flex-wrap: wrap;
		}

		.blog-listing__search {
			flex: 1 1 100%;
			width: 100%;
			max-width: 100%;
		}
	}

	@media (max-width: 639px) {
		.blog-listing__header {
			flex-direction: column;
			align-items: stretch;
		}

		.blog-listing__filters {
			flex-wrap: nowrap;
			overflow-x: auto;
			padding-bottom: 4px;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.blog-listing__filters::-webkit-scrollbar {
			display: none;
		}

		.blog-listing__chip {
			flex-shrink: 0;
		}

		.blog-listing__meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
