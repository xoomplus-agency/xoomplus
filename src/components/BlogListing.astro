---
import Section from './Section.astro';
import BlogCard from './BlogCard.astro';
import BlogPostsGrid from './BlogPostsGrid.astro';
import BlogGridSkeleton from './BlogGridSkeleton.astro';
import {
	BLOG_IMAGE_PLACEHOLDER,
	categoryKey,
	getPublishedCategories,
} from '../lib/wp';
import { BLOG_LIST_PAGE_SIZE } from '../lib/wp-posts';

const PAGE_SIZE = BLOG_LIST_PAGE_SIZE;

/** Categories only — posts load in BlogPostsGrid (server:defer). */
let categoryFilters: { id: number; key: string; label: string }[] = [];
try {
	const categories = await getPublishedCategories();
	categoryFilters = categories
		.filter(
			(cat) =>
				!/^uncategorized$/i.test(cat.slug) && !/^uncategorised$/i.test(cat.slug),
		)
		.map((cat) => ({
			id: cat.id,
			key: categoryKey(cat.name || cat.slug),
			label: cat.name || cat.slug,
		}))
		.sort((a, b) => a.label.localeCompare(b.label));
} catch (err) {
	console.error('[BlogListing] getPublishedCategories failed:', err);
}
---

<Section aria-labelledby="blogs-heading">
	<div
		data-blog-listing
		data-api="/api/blog-posts"
		data-per-page={String(PAGE_SIZE)}
	>
	<template id="blog-card-template">
		<!-- No data-reveal: cloned Load More cards are never observed by reveal.ts -->
		<li class="blog-listing__item" data-post-card data-category="template">
			<BlogCard
				headingLevel="h3"
				post={{ id: 0, slug: 'template', path: '/template/post/', title: 'Template' }}
				image={BLOG_IMAGE_PLACEHOLDER}
				alt=""
				category="Category"
				title="Template"
				excerpt="Excerpt"
			/>
		</li>
	</template>
	<div class="blog-listing__header">
		<div class="blog-listing__intro" data-reveal="up">
			<p class="pill-light">Explore the blog</p>
			<h2
				id="blogs-heading"
				class="blog-listing__heading text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				The latest thinking.
			</h2>
		</div>

		<div class="blog-listing__search" data-blog-search-wrap>
			<label class="sr-only" for="blog-search">Search articles</label>
			<svg
				class="blog-listing__search-icon"
				width="16"
				height="16"
				viewBox="0 0 16 16"
				fill="none"
				aria-hidden="true"
			>
				<path
					d="M7 12.5A5.5 5.5 0 1 0 7 1.5a5.5 5.5 0 0 0 0 11Z"
					stroke="#555555"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<path
					d="m11.5 11.5 2.75 2.75"
					stroke="#555555"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<input
				id="blog-search"
				class="blog-listing__search-input"
				type="search"
				name="q"
				placeholder="Search articles"
				autocomplete="off"
				role="combobox"
				aria-autocomplete="list"
				aria-controls="blog-search-results"
				aria-expanded="false"
				aria-haspopup="listbox"
				data-blog-search
			/>
			<div
				id="blog-search-results"
				class="blog-listing__search-results"
				role="listbox"
				aria-label="Search results"
				hidden
				data-blog-search-results
			></div>
			<p class="sr-only" role="status" aria-live="polite" data-blog-search-live></p>
		</div>
	</div>

	<div
		class="blog-listing__filters"
		role="group"
		aria-label="Filter articles by category"
		data-blog-filters
	>
		<button
			type="button"
			class="blog-listing__chip is-active"
			aria-pressed="true"
			data-filter-chip
			data-filter="all"
		>
			All articles
		</button>
		{
			categoryFilters.map((cat) => (
				<button
					type="button"
					class="blog-listing__chip"
					aria-pressed="false"
					data-filter-chip
					data-filter={cat.key}
					data-category-id={String(cat.id)}
				>
					{cat.label}
				</button>
			))
		}
	</div>

	<hr class="blog-listing__divider" />

	<noscript>
		<style>
			[data-post-card][hidden] {
				display: block !important;
			}
			[data-blog-load-more],
			[data-blog-search-wrap] {
				display: none !important;
			}
		</style>
	</noscript>

	{/*
	  Posts are a server island: shell (title, filters, search) streams first;
	  BlogGridSkeleton shows until getPosts resolves. Freshness unchanged
	  (getPosts still uses cache: no-store).
	*/}
	<BlogPostsGrid server:defer>
		<BlogGridSkeleton slot="fallback" />
	</BlogPostsGrid>
	</div>
</Section>

<script>
	import '../scripts/blog-list.ts';
</script>

<style is:global>
	/* Ensure [hidden] always wins over grid/flex display utilities */
	[data-blog-listing] [hidden] {
		display: none !important;
	}

	/*
	  Grid/meta/load-more render inside BlogPostsGrid / BlogGridSkeleton
	  (server:defer). Keep rules global so deferred HTML inherits layout.
	*/
	[data-blog-listing] .blog-listing__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 0;
	}

	[data-blog-listing] .blog-listing__meta-left,
	[data-blog-listing] .blog-listing__meta-right {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	[data-blog-listing] .blog-listing__empty {
		margin: 20px 0 0;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.5;
		color: #888888;
	}

	[data-blog-listing] .blog-listing__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		margin-top: 40px;
		content-visibility: visible;
	}

	[data-blog-listing] .blog-listing__item {
		min-width: 0;
		height: 100%;
		content-visibility: visible;
	}

	/* Below-fold only (first row has no --cv). Fixed intrinsic size avoids zero-height. */
	[data-blog-listing] .blog-listing__item--cv {
		content-visibility: auto;
		contain-intrinsic-size: 400px 420px;
	}

	[data-blog-listing] .blog-listing__load-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 40px;
	}

	[data-blog-listing] .blog-listing__load-more[hidden],
	[data-blog-listing] .blog-listing__load-more #load-more[hidden] {
		display: none !important;
	}

	[data-blog-listing] .blog-listing__load-status {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.4;
		color: #888888;
		text-align: center;
	}

	[data-blog-listing] .blog-listing__item[hidden] {
		display: none !important;
	}

	@media (min-width: 640px) {
		[data-blog-listing] .blog-listing__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		[data-blog-listing] .blog-listing__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 639px) {
		[data-blog-listing] .blog-listing__meta {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

<style>
	.blog-listing__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		overflow: visible;
	}

	.blog-listing__intro {
		min-width: 0;
	}

	.blog-listing__heading {
		margin: 16px 0 0;
	}

	.blog-listing__search {
		position: relative;
		z-index: 20;
		flex: 1 1 360px;
		width: auto;
		min-width: min(280px, 100%);
		max-width: min(640px, 100%);
	}

	.blog-listing__search-icon {
		position: absolute;
		top: 20px;
		left: 14px;
		z-index: 2;
		display: block;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.blog-listing__search-input {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		width: 100%;
		height: 40px;
		padding: 0 14px 0 38px;
		border: 1px solid #e9e9e7;
		border-radius: 8px;
		background: #ffffff;
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 400;
		line-height: 1.4;
		color: var(--color-primary-black);
		outline: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			border-radius 0.15s ease;
	}

	.blog-listing__search-input::placeholder {
		color: #888888;
	}

	.blog-listing__search-input:focus {
		border-color: #ffa800;
		box-shadow: 0 0 0 3px rgba(255, 168, 0, 0.15);
	}

	.blog-listing__search-results {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		right: 0;
		z-index: 30;
		box-sizing: border-box;
		max-height: min(360px, 70vh);
		overflow-x: hidden;
		overflow-y: auto;
		padding: 12px;
		border: 1px solid #e9e9e7;
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 12px 32px rgba(11, 10, 11, 0.12);
	}

	.blog-listing__search-results :global(.blog-listing__search-option) {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: flex-start;
		gap: 12px;
		box-sizing: border-box;
		width: 100%;
		padding: 10px 0;
		border: 0;
		border-bottom: 1px solid #e9e9e7;
		border-radius: 0;
		background: transparent;
		color: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.blog-listing__search-results :global(.blog-listing__search-option:last-child) {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.blog-listing__search-results :global(.blog-listing__search-option:first-child) {
		padding-top: 0;
	}

	.blog-listing__search-results :global(.blog-listing__search-option.is-active),
	.blog-listing__search-results :global(.blog-listing__search-option:focus-visible) {
		background: #f7f7f5;
		outline: none;
	}

	@media (hover: hover) {
		.blog-listing__search-results :global(.blog-listing__search-option:hover) {
			background: #f7f7f5;
		}
	}

	.blog-listing__search-results :global(.blog-listing__search-media) {
		flex: 0 0 64px;
		width: 64px;
		height: 48px;
		overflow: hidden;
		border-radius: 8px;
		background: #f3f3f1;
	}

	.blog-listing__search-results :global(.blog-listing__search-thumb) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		border-radius: 8px;
		object-fit: cover;
	}

	.blog-listing__search-results :global(.blog-listing__search-body) {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.blog-listing__search-results :global(.blog-listing__search-title) {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-primary-black);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-listing__search-results :global(.blog-listing__search-cat) {
		margin: 0;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 400;
		line-height: 1.3;
		color: #888888;
	}

	.blog-listing__search-results :global(.blog-listing__search-empty) {
		margin: 0;
		padding: 4px 2px;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 400;
		line-height: 1.4;
		color: #888888;
	}

	@media (max-width: 639px) {
		.blog-listing__search-results {
			max-height: min(280px, 60vh);
			padding: 10px;
		}

		.blog-listing__search-results :global(.blog-listing__search-option) {
			gap: 10px;
		}

		.blog-listing__search-results :global(.blog-listing__search-media) {
			flex: 0 0 56px;
			width: 56px;
			height: 42px;
		}

		.blog-listing__search-results :global(.blog-listing__search-title) {
			font-size: 13px;
		}
	}

	.blog-listing__filters {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.blog-listing__chip {
		box-sizing: border-box;
		padding: 8px 16px;
		border: 1px solid #e9e9e7;
		border-radius: 9999px;
		background: #ffffff;
		font-family: var(--font-inter);
		font-size: 13px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-primary-black);
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform var(--dur-fast) var(--ease-out);
	}

	.blog-listing__chip.is-active {
		border-color: #ffa800;
		background: #ffa800;
		color: var(--color-primary-black);
	}

	.blog-listing__chip:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 2px;
	}

	@media (hover: hover) {
		.blog-listing__chip:hover {
			border-color: #ffa800;
		}
	}

	.blog-listing__divider {
		margin: 40px 0;
		border: 0;
		border-top: 1px solid #e9e9e7;
	}

	@media (max-width: 1023px) {
		.blog-listing__header {
			flex-wrap: wrap;
		}

		.blog-listing__search {
			flex: 1 1 100%;
			width: 100%;
			max-width: 100%;
		}
	}

	@media (max-width: 639px) {
		.blog-listing__header {
			flex-direction: column;
			align-items: stretch;
		}

		.blog-listing__filters {
			flex-wrap: nowrap;
			overflow-x: auto;
			padding-bottom: 4px;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.blog-listing__filters::-webkit-scrollbar {
			display: none;
		}

		.blog-listing__chip {
			flex-shrink: 0;
		}
	}
</style>
