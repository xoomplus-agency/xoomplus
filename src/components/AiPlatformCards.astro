---
/**
 * Light AI platform cards — used on AI SEO after the services grid.
 * White surface cards on #F7F7F5 with amber index markers.
 */
import Section from './Section.astro';
import type { AiPlatformCardsContent } from '../data/ai-platforms';

interface Props {
	content: AiPlatformCardsContent;
}

const { content } = Astro.props;
const headingId = `${content.id}-heading`;
const [titleLine1, titleLine2] = content.titleLines ?? [content.title, ''];
const useTitleLines = Boolean(content.titleLines);
---

<Section id={content.id} background="light-gray" aria-labelledby={headingId} class="ai-platforms">
	<div class="ai-platforms__header" data-reveal="up">
		<div class="ai-platforms__intro">
			<p class="pill-light ai-platforms__pill m-0">{content.pill}</p>
			<h2
				id={headingId}
				class="ai-platforms__heading m-0 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				{
					useTitleLines ? (
						<>
							<span class="ai-platforms__line">{titleLine1}</span>
							<span class="ai-platforms__line">{titleLine2}</span>
						</>
					) : (
						content.title
					)
				}
			</h2>
		</div>
		<p class="ai-platforms__lead text-on-light m-0">{content.text}</p>
	</div>

	<ul class="ai-platforms__grid m-0 list-none p-0" role="list" data-reveal-group>
		{
			content.cards.map((card, index) => (
				<li class="ai-platforms__item" data-reveal="up">
					<article class="surface-card ai-platforms__card">
						<span class="ai-platforms__index" aria-hidden="true">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="ai-platforms__card-title m-0">{card.title}</h3>
						<p class="ai-platforms__card-text m-0">{card.text}</p>
					</article>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.ai-platforms__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
	}

	.ai-platforms__intro {
		min-width: 0;
	}

	.ai-platforms__pill {
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
	}

	.ai-platforms__heading {
		margin-top: 16px;
	}

	.ai-platforms__line {
		display: block;
	}

	.ai-platforms__lead {
		flex-shrink: 0;
		max-width: 440px;
		text-align: left;
	}

	.ai-platforms__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		margin-top: 40px;
		padding-bottom: 8px;
	}

	.ai-platforms__item {
		min-width: 0;
		height: 100%;
	}

	.ai-platforms__card {
		position: relative;
		display: flex;
		height: 100%;
		flex-direction: column;
		align-items: flex-start;
		padding: 28px 28px 28px 32px;
		overflow: hidden;
	}

	.ai-platforms__card::before {
		content: '';
		position: absolute;
		top: 24px;
		bottom: 24px;
		left: 0;
		width: 3px;
		border-radius: 0 2px 2px 0;
		background: var(--color-primary);
	}

	.ai-platforms__index {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 40px;
		height: 28px;
		padding: 0 10px;
		border-radius: 999px;
		background: rgba(255, 168, 0, 0.12);
		font-family: var(--font-inter);
		font-size: var(--text-small);
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-primary);
	}

	.ai-platforms__card-title {
		margin-top: 1.25rem;
		font-family: var(--font-sans);
		font-size: var(--text-h3-sm);
		font-weight: var(--text-h3-sm--font-weight);
		line-height: var(--text-h3-sm--line-height);
		letter-spacing: -0.01em;
		text-wrap: balance;
		color: var(--color-primary-black);
	}

	.ai-platforms__card-text {
		margin-top: 0.75rem;
		font-family: var(--font-inter);
		font-size: var(--text-body);
		font-weight: var(--text-body--font-weight);
		line-height: var(--text-body--line-height);
		text-wrap: pretty;
		color: #555555;
	}

	@media (max-width: 1023px) {
		.ai-platforms__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.ai-platforms__lead {
			max-width: 100%;
		}
	}

	@media (max-width: 639px) {
		.ai-platforms__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
