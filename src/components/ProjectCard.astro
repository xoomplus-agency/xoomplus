---
import type { ProjectMetric } from '../data/projects';

interface Props {
	category: string;
	name: string;
	image: string;
	imageAlt?: string;
	imageClass?: string;
	tags: string[];
	title: string;
	excerpt: string;
	href: string;
	/** When set, renders the home metrics footer instead of “View Details” */
	metrics?: ProjectMetric[];
	/** Listing page only — #e9e9e7 stroke */
	bordered?: boolean;
	/** Listing — nudge non-Bodykite mockups right */
	shiftImage?: boolean;
	/** Home — nudge Bodykite mockup right only */
	shiftBodykite?: boolean;
	/** Listing only — top-left amber radial glow on the dark header */
	glow?: boolean;
}

const {
	category,
	name,
	image,
	imageAlt = '',
	imageClass,
	tags,
	title,
	excerpt,
	href,
	metrics,
	bordered = false,
	shiftImage = false,
	shiftBodykite = false,
	glow = false,
} = Astro.props;

const showMetrics = Boolean(metrics && metrics.length >= 2);
const linkLabel = showMetrics ? `${name} case study` : `View details: ${name}`;
---

<article
	class:list={[
		'case-card',
		bordered && 'case-card--bordered',
		shiftImage && 'case-card--shift-image',
		shiftBodykite && 'case-card--shift-bodykite',
	]}
>
	<a class="case-card-link" href={href} aria-label={linkLabel}>
		<div class:list={['case-hero', glow && 'project-card--glow']}>
			<span class="case-glow" aria-hidden="true"></span>
			<div class="case-hero-copy">
				<p class="case-industry m-0">{category}</p>
				<p class="case-hero-title m-0">{name}</p>
			</div>
			<div class="case-hero-media">
				<div class="case-hero-img-wrap">
					<img
						src={image}
						alt={imageAlt}
						width="280"
						height="150"
						class:list={['case-hero-img', imageClass]}
						decoding="async"
						loading="lazy"
					/>
				</div>
			</div>
		</div>

		<div class="case-body">
			<ul class="case-categories m-0 flex list-none flex-wrap gap-2 p-0" role="list">
				{
					tags.map((tag) => (
						<li class="case-category">{tag}</li>
					))
				}
			</ul>

			<h3 class="case-title m-0">{title}</h3>
			<p class="case-desc m-0">{excerpt}</p>

			{
				showMetrics && metrics ? (
					<div class="case-footer">
						<div class="case-metrics">
							<div class="case-metric">
								<p class="case-metric-value m-0">{metrics[0].value}</p>
								<p class="case-metric-label m-0">{metrics[0].label}</p>
							</div>
							<span class="case-metric-sep" aria-hidden="true">
								|
							</span>
							<div class="case-metric">
								<p class="case-metric-value m-0">{metrics[1].value}</p>
								<p class="case-metric-label m-0">{metrics[1].label}</p>
							</div>
						</div>
						<span class="case-arrow" aria-hidden="true">
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path
									d="M3.75 9h10.5M9.75 4.5 14.25 9l-4.5 4.5"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
					</div>
				) : (
					<div class="case-footer case-footer--details">
						<span class="case-view-details">View Details</span>
						<span class="case-arrow" aria-hidden="true">
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
								<path
									d="M3.75 9h10.5M9.75 4.5 14.25 9l-4.5 4.5"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
					</div>
				)
			}
		</div>
	</a>
</article>

<style>
	.case-card {
		--case-ink: #0a0a0a;
		--case-accent: #ffa800;
		--case-muted: #888888;
		--case-pill-bg: #f7f7f5;
		--case-border: #e9e9e7;
		--case-radius: 24px;

		position: relative;
		box-sizing: border-box;
		display: flex;
		width: 100%;
		height: 100%;
		min-height: 380px;
		overflow: hidden;
		isolation: isolate;
		border: 1px solid transparent;
		border-radius: var(--case-radius);
		/* Black hero band + white body — glow sits above this, below the image */
		background:
			linear-gradient(var(--case-ink), var(--case-ink)) top / 100% 150px no-repeat,
			#ffffff;
		font-family: var(--font-inter);
		box-shadow: 0 8px 24px 0 rgb(149 157 165 / 0);
		transition:
			box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1),
			border-color 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.case-card--bordered {
		border-color: var(--case-border);
	}

	.case-card-link {
		position: relative;
		z-index: 1;
		display: flex;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		border-radius: inherit;
		color: inherit;
		text-decoration: none;
	}

	/* Soft amber glow — lives inside .case-hero so blur cannot leak into the white body */
	.case-glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		border-radius: inherit;
	}

	.case-glow::before {
		content: '';
		position: absolute;
		right: -10%;
		top: -20%;
		width: 85%;
		height: 140%;
		background: radial-gradient(
			ellipse at center,
			rgba(255, 168, 0, 0.55) 0%,
			rgba(255, 168, 0, 0.22) 45%,
			transparent 70%
		);
		filter: blur(22px);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	@media (hover: hover) {
		.case-card:hover {
			border-color: #ffffff;
			box-shadow: 0 8px 24px 0 rgb(149 157 165 / 0.2);
		}

		.case-card--bordered:hover {
			border-color: var(--case-border);
		}

		.case-card:hover .case-hero.project-card--glow::before {
			opacity: 0;
		}
	}

	.case-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		height: 150px;
		flex-shrink: 0;
		overflow: hidden;
		background-color: transparent;
	}

	/* /case-studies only — top-left amber corner glow (static; hidden on hover) */
	.case-hero.project-card--glow::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 42%;
		height: 120%;
		z-index: 0;
		pointer-events: none;
		opacity: 1;
		background: radial-gradient(
			circle 200px at top left,
			rgba(255, 168, 0, 0.73) 0%,
			rgba(0, 0, 0, 0) 70%
		);
		transition: opacity 0.4s ease;
	}

	@media (max-width: 639px) {
		.case-hero.project-card--glow::before {
			width: 55%;
		}
	}

	.case-hero-copy {
		position: relative;
		z-index: 2;
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		gap: 0.45rem;
		padding: 1.15rem 1.1rem 1.15rem 1.25rem;
		background-color: transparent;
	}

	.case-industry {
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--case-accent);
	}

	.case-hero-title {
		font-size: clamp(1.5rem, 2.2vw, 2rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.03em;
		background-image: linear-gradient(180deg, #ffffff 30%, #999999 100%);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}

	.case-hero-media {
		position: relative;
		z-index: 1;
		min-width: 0;
		height: 100%;
		overflow: hidden;
		background-color: transparent;
	}

	.case-hero-img-wrap {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.case-hero-img {
		display: block;
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left center;
		transform: scale(1);
		transform-origin: center;
		will-change: transform;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Listing — nudge non-Bodykite mockups right */
	.case-card--shift-image .case-hero-img {
		transform: translateX(10%) scale(1);
	}

	/*
	 * Bodykite asset (358×150): empty/transparent edges, mockups mid-right.
	 * Cover + 60% position + slight zoom so the phone fills the media area.
	 */
	.case-hero-img:global(.case-hero-img--bodykite) {
		position: relative;
		width: 100%;
		height: 100%;
		max-width: none;
		min-width: 0;
		object-fit: cover;
		object-position: 60% center;
		transform: scale(1);
		transform-origin: center center;
	}

	.case-card--shift-image .case-hero-img:global(.case-hero-img--bodykite),
	.case-card--shift-bodykite .case-hero-img:global(.case-hero-img--bodykite) {
		transform: scale(1.35);
	}

	/* Sterling Cooper only — tune --img-shift-x */
	:global(.project-img--sterling) {
		--img-shift-x: 40px;
		transform: translateX(var(--img-shift-x)) scale(1);
	}

	/* Override listing 10% nudge so Sterling uses its own shift only */
	.case-card--shift-image :global(.project-img--sterling) {
		transform: translateX(var(--img-shift-x)) scale(1);
	}

	@media (hover: hover) {
		.case-card:hover .case-glow::before {
			opacity: 1;
		}

		.case-card:hover .case-hero-img {
			transform: scale(1.05);
		}

		.case-card--shift-image:hover .case-hero-img {
			transform: translateX(10%) scale(1.05);
		}

		.case-card:hover .case-hero-img:global(.case-hero-img--bodykite),
		.case-card--shift-image:hover .case-hero-img:global(.case-hero-img--bodykite),
		.case-card--shift-bodykite:hover .case-hero-img:global(.case-hero-img--bodykite) {
			transform: scale(1.42);
		}

		.case-card:hover :global(.project-img--sterling),
		.case-card--shift-image:hover :global(.project-img--sterling) {
			transform: translateX(var(--img-shift-x)) scale(1.05);
		}
	}

	.case-body {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.7rem;
		background-color: #ffffff;
		padding: 1rem 1.25rem 28px;
	}

	.case-category {
		display: inline-flex;
		box-sizing: border-box;
		height: 23px;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background-color: var(--case-pill-bg);
		padding: 5px 10px;
		font-family: var(--font-inter);
		font-size: 12px;
		font-weight: 500;
		line-height: 1;
		color: var(--color-text-on-light);
		white-space: nowrap;
	}

	.case-title {
		font-size: 24px;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--case-ink);
	}

	.case-desc {
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.5;
		color: #555555;
	}

	.case-footer {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
	}

	.case-footer--details {
		align-items: center;
		padding-top: 1rem;
		border-top: 1px solid var(--case-border);
	}

	.case-view-details {
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--case-ink);
	}

	.case-metrics {
		display: flex;
		align-items: center;
		gap: 0;
	}

	.case-metric-sep {
		display: block;
		flex-shrink: 0;
		width: 1px;
		height: 2.75rem;
		margin: 0 1.1rem;
		overflow: hidden;
		background-color: rgb(85 85 85 / 0.22);
		color: transparent;
		user-select: none;
	}

	.case-metric-value {
		font-size: 24px;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--case-accent);
	}

	.case-metric-label {
		margin-top: 0.15rem;
		font-family: var(--font-inter);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--case-muted);
	}

	.case-arrow {
		display: inline-flex;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background-color: var(--case-accent);
		color: var(--case-ink);
	}

	.case-arrow svg {
		transform: rotate(0deg);
		transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.case-card:hover .case-arrow svg {
		transform: rotate(-30deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.case-card,
		.case-glow::before,
		.case-hero.project-card--glow::before,
		.case-hero-img,
		.case-arrow svg {
			transition: none;
		}

		.case-card:hover .case-hero-img {
			transform: scale(1);
		}

		.case-card--shift-image:hover .case-hero-img {
			transform: translateX(10%) scale(1);
		}

		.case-card:hover .case-hero-img:global(.case-hero-img--bodykite),
		.case-card--shift-image:hover .case-hero-img:global(.case-hero-img--bodykite),
		.case-card--shift-bodykite:hover .case-hero-img:global(.case-hero-img--bodykite) {
			transform: scale(1.35);
		}

		.case-card:hover :global(.project-img--sterling),
		.case-card--shift-image:hover :global(.project-img--sterling) {
			transform: translateX(var(--img-shift-x)) scale(1);
		}

		.case-card:hover .case-arrow svg {
			transform: none;
		}
	}
</style>
