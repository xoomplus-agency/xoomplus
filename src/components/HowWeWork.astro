---
/**
 * "How we work together" — light-gray section: header, two images, three text cards.
 * Content from props / defaultHowWeWork. No JS.
 */
import Section from './Section.astro';
import { defaultHowWeWork, type HowWeWorkContent } from '../data/how-we-work';

interface Props {
	content?: HowWeWorkContent;
	/** Section + heading id prefix. About and child both use `how-we-work`. */
	id?: string;
}

const { content = defaultHowWeWork, id = 'how-we-work' } = Astro.props;
const { pill, titleLines, introLines, images, cards } = content;
const headingId = `${id}-heading`;
---

<Section
	id={id}
	background="light-gray"
	aria-labelledby={headingId}
	class="hww-section"
>
	<div class="hww-header">
		<div class="hww-header__left">
			<p class="pill-light m-0">{pill}</p>
			<h2
				id={headingId}
				class="hww-heading m-0 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				{
					titleLines.length > 1 ? (
						titleLines.map((line) => <span class="hww-heading__line">{line}</span>)
					) : (
						titleLines[0]
					)
				}
			</h2>
		</div>
		<p class="hww-intro m-0">
			{introLines[0]}<br class="hww-intro__break" />
			{introLines[1]}<br class="hww-intro__break" />
			{introLines[2]}
		</p>
	</div>

	<div class="hww-images">
		{
			images.map((image) => (
				<div class:list={['hww-images__frame', image.wide && 'hww-images__frame--wide']}>
					<img
						class="hww-images__img"
						src={image.src}
						alt={image.alt}
						width={image.width}
						height={image.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
			))
		}
	</div>

	<ul class="hww-columns m-0 list-none p-0" role="list">
		{
			cards.map((card) => (
				<li class="hww-column">
					<article class="hww-card">
						<h3 class="hww-card__title m-0">{card.title}</h3>
						<p class="hww-card__text m-0">{card.text}</p>
					</article>
				</li>
			))
		}
	</ul>
</Section>

<style>
	/* Room below cards so box-shadow is not clipped by the next section */
	.hww-section {
		padding-bottom: calc(var(--section-padding-y) + 24px);
	}

	.hww-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 48px;
	}

	.hww-header__left {
		flex: 1 1 400px;
		min-width: 0;
		text-align: left;
	}

	.hww-heading {
		margin-top: 16px;
		line-height: 1.15;
	}

	.hww-heading__line {
		display: block;
	}

	/* One line when the row is wide enough for heading + 3-line intro */
	@media (min-width: 1600px) {
		.hww-heading {
			white-space: nowrap;
		}
	}

	.hww-intro {
		flex: 0 0 590px;
		width: 590px;
		max-width: 590px;
		font-family: var(--font-inter);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
		color: #555555;
		text-align: left;
	}

	/* Forced 3-line breaks on desktop; natural wrap on smaller screens */
	.hww-intro__break {
		display: none;
	}

	@media (min-width: 1024px) {
		.hww-intro__break {
			display: inline;
		}
	}

	.hww-images {
		display: flex;
		gap: 16px;
		margin-top: 32px;
		height: clamp(200px, 22vw, 320px);
	}

	.hww-images__frame {
		flex: 1 1 0;
		overflow: hidden;
		border-radius: 18px;
		min-width: 0;
		height: 100%;
	}

	.hww-images__frame--wide {
		flex: 1.7 1 0;
	}

	.hww-images__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 18px;
	}

	.hww-columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		align-items: stretch;
		margin-top: 24px;
	}

	.hww-column {
		min-width: 0;
		display: flex;
	}

	.hww-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		padding: 20px 24px;
		border: 1px solid rgba(0, 0, 0, 0.04);
		border-radius: 16px;
		background: #ffffff;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
		text-align: center;
	}

	.hww-card__title {
		font-family: var(--font-inter);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-primary-black);
	}

	.hww-card__text {
		font-family: var(--font-inter);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.5;
		color: #555555;
	}

	/* Tablet 640–1023px */
	@media (min-width: 640px) and (max-width: 1023px) {
		.hww-header {
			flex-direction: column;
			gap: 20px;
		}

		.hww-header__left,
		.hww-intro {
			flex: none;
			width: 100%;
			max-width: 100%;
		}

		.hww-intro {
			width: 100%;
		}

		.hww-images {
			height: 200px;
		}

		.hww-columns {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 16px;
		}
	}

	@media (min-width: 640px) and (max-width: 899px) {
		.hww-columns {
			grid-template-columns: 1fr;
			gap: 12px;
		}
	}

	/* Mobile <640px */
	@media (max-width: 639px) {
		.hww-header {
			flex-direction: column;
			gap: 20px;
		}

		.hww-header__left,
		.hww-intro {
			flex: none;
			width: 100%;
			max-width: 100%;
		}

		.hww-intro {
			width: 100%;
		}

		.hww-heading {
			font-size: clamp(1.75rem, 8vw, 2rem); /* ~28–32px */
		}

		.hww-intro {
			font-size: clamp(1rem, 4vw, 1.125rem);
		}

		.hww-images {
			flex-direction: column;
			height: auto;
			gap: 14px;
		}

		.hww-images__frame,
		.hww-images__frame--wide {
			flex: none;
			width: 100%;
			height: 200px;
		}

		.hww-columns {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.hww-card__title {
			font-size: 18px;
		}

		.hww-card__text {
			font-size: 15px;
		}
	}
</style>
