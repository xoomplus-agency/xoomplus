---
import Button from './Button.astro';
import ProjectCard from './ProjectCard.astro';
import { homeProjects } from '../data/projects';
import { getWpPagePath } from '../lib/wp-seo';

const caseStudiesHref = await getWpPagePath('caseStudies');

const intro =
	'We don’t just say we deliver; we deliver. Here are a few stories of how we brought strategy, creativity and performance to achieve digital success for our clients.';
---

<section
	id="case-studies"
	data-bg="light"
	class="page-section case-studies bg-secondary-white py-section"
	aria-labelledby="case-studies-heading"
>
	<div class="container">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14" data-reveal="up">
			<p class="pill-light mb-5">Case Studies</p>
			<h2
				id="case-studies-heading"
				class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Real Projects. Clear Challenges. Measurable Outcomes.
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				{intro}
			</p>
		</div>

		<ul class="case-grid m-0 list-none p-0" role="list" data-reveal-group>
			{
				homeProjects.map((project) => {
					const category = project.homeCategory ?? project.category;
					const tags = project.homeTags ?? project.tags;
					const title = `${project.name} | ${category}`;

					return (
						<li class="case-grid__item" data-reveal="up">
							<ProjectCard
								category={category}
								name={project.name}
								image={project.image}
								imageAlt=""
								imageClass={project.imageClass}
								tags={tags}
								title={title}
								excerpt={project.homeExcerpt ?? project.excerpt}
								href={project.href}
								metrics={project.metrics}
								shiftBodykite={project.id === 'bodykite'}
							/>
						</li>
					);
				})
			}
		</ul>

		<div class="mt-12 flex justify-center lg:mt-14">
			<Button href={caseStudiesHref}>View All Case Studies</Button>
		</div>
	</div>
</section>

<style>
	.case-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 464px));
		justify-content: center;
		gap: 1.25rem;
	}

	.case-grid__item {
		display: flex;
		width: 100%;
		max-width: 464px;
		min-width: 0;
	}

	.case-grid__item :global(.case-card) {
		max-width: 464px;
	}

	@media (max-width: 1280px) {
		.case-grid {
			grid-template-columns: repeat(2, minmax(0, 464px));
		}
	}

	@media (max-width: 720px) {
		.case-grid {
			grid-template-columns: minmax(0, 464px);
		}
	}

	@media (min-width: 640px) and (max-width: 720px) {
		.case-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.case-grid > :last-child:nth-child(odd) {
			grid-column: 1 / -1;
			justify-self: center;
			width: 100%;
			max-width: min(464px, calc(50% - 0.625rem));
		}
	}

	@media (min-width: 1024px) and (max-width: 1199px) {
		.case-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
