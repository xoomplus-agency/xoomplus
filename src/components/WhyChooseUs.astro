---
import Button from './Button.astro';

/** Card order matches screenshot L→R, top→bottom */
const features = [
	{
		icon: '/icons/strategy-first.svg',
		title: 'Strategy First',
		description:
			'We start with your goals, audience, and opportunities before moving into execution.',
	},
	{
		icon: '/icons/experienced-team.svg',
		title: 'Experienced Team',
		description:
			'Bring together the expertise needed across design, development, SEO, social media, and digital marketing.',
	},
	{
		icon: '/icons/clear-reporting.svg',
		title: 'Clear Reporting',
		description:
			'Understand what is being worked on, what is changing, and where opportunities are developing.',
	},
	{
		icon: '/icons/tailored-strategies.svg',
		title: 'Tailored Strategies',
		description:
			'Your business is different, so your digital strategy should be built around your specific needs.',
	},
	{
		icon: '/icons/result-focused.svg',
		title: 'Results Focused',
		description:
			'Keep the work connected to meaningful business objectives rather than activity alone.',
	},
	{
		icon: '/icons/long-term-growth.svg',
		title: 'Long-Term Growth',
		description:
			'Build digital foundations that can continue to improve as your business grows.',
	},
];
---

<section
	id="why-xoomplus"
	data-bg="light"
	class="bg-secondary-white px-[clamp(1rem,12.3vw,236px)] py-section"
	aria-labelledby="why-heading"
>
	<div class="mx-auto w-full max-w-[1560px]">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14">
			<p class="pill-light mb-5">WHY XOOMPLUS</p>
			<h2
				id="why-heading"
				class="mb-4 text-h1 font-medium tracking-[-0.03em] text-primary-black"
			>
				A Digital Partner Focused on Your Business Goals
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Your digital presence should do more than look good. We bring strategy, creativity,
				technology, and performance together to create digital experiences that support your
				business objectives.
			</p>
		</div>

		<ul class="why-grid m-0 list-none p-0" role="list">
			{
				features.map((item) => (
					<li class="why-card">
						<div class="why-card-icon" aria-hidden="true">
							<img
								src={item.icon}
								alt=""
								width="28"
								height="28"
								class="size-7 object-contain"
								decoding="async"
								loading="lazy"
							/>
						</div>
						<h3 class="m-0 text-[1.25rem] font-bold tracking-[-0.02em] text-primary-black">
							{item.title}
						</h3>
						<p class="m-0 text-[15px] leading-[1.5] text-[var(--color-text-on-light)] [font-family:var(--font-inter)]">{item.description}</p>
					</li>
				))
			}
		</ul>

		<div class="mt-12 flex justify-center lg:mt-14">
			<Button size="nav" href="#contact">Let’s Talk</Button>
		</div>
	</div>
</section>

<style>
	.why-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 464px));
		justify-content: center;
		gap: 1.25rem;
	}

	/* Size / centering only — chrome lives in global.css (.why-card) */
	.why-card {
		max-width: 464px;
		height: 238px;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 1.75rem 1.5rem;
		text-align: center;
	}

	.why-card-icon {
		display: inline-flex;
		width: 3rem;
		height: 3rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		background: linear-gradient(
			180deg,
			#fbfbfe 0%,
			rgb(211 211 211 / 0.45) 100%
		);
	}

	@media (max-width: 1280px) {
		.why-grid {
			grid-template-columns: repeat(2, minmax(0, 464px));
		}
	}

	@media (max-width: 720px) {
		.why-grid {
			grid-template-columns: minmax(0, 464px);
		}

		.why-card {
			height: auto;
			min-height: 238px;
		}
	}
</style>
