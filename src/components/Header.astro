---
import Button from './Button.astro';
import ServicesMegaMenu from './ServicesMegaMenu.astro';
import { getNavItemsResolved, isNavActive, type NavItem } from '../data/nav';
import { getServicesMenuSections, servicesMenu } from '../data/services-menu';

interface Props {
	/** `solid` = primary black bar for white pages without a hero (e.g. blog detail) */
	variant?: 'default' | 'solid';
	/** `light` = menu pill over white/#F7F7F5 from first paint (e.g. blog detail) */
	theme?: 'dark' | 'light';
	/** When true, no nav item is marked active (404 and similar). */
	suppressActive?: boolean;
	/**
	 * Pre-resolved nav (e.g. fetched in parallel with the post). When set,
	 * skips a second getNavItemsResolved() round-trip.
	 */
	navItems?: NavItem[];
}

const {
	variant = 'default',
	theme = 'dark',
	suppressActive = false,
	navItems: navItemsProp,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = navItemsProp ?? (await getNavItemsResolved());
const allServicesHref =
	nav.find((item) => item.label === 'Services')?.href ?? '/services';
const megaPanelId = 'services-mega-menu';
const mobileDrawerId = 'mobile-nav-drawer';
const mobileServicesId = 'mobile-services-sheet';
const servicesSections = getServicesMenuSections();

function isActive(href: string, matchPrefixes?: string[]) {
	if (suppressActive) return false;
	if (href.startsWith('#')) return false;
	return isNavActive(pathname, href, matchPrefixes);
}

---

<header
	class="pointer-events-none fixed inset-x-0 top-0 z-50"
	data-site-header
	data-variant={variant}
	data-theme={theme === 'light' ? 'light' : undefined}
>
	<!--
		Default: Logo left · glass nav (links only) center · CTA right
		Scrolled: one unified glass shell around logo + links + CTA
	-->
	<div
		class="pointer-events-auto relative mx-auto hidden w-full max-w-[1920px] grid-cols-[1fr_auto_1fr] items-center gap-x-6 bg-transparent pl-8 pr-8 pt-6 lg:grid lg:pl-12 lg:pr-12"
		data-nav-desktop
	>
		<a
			class="nav-logo-link z-[1] shrink-0 justify-self-start"
			href="/"
			aria-label="Xoomplus home"
			data-nav-logo
		>
			<img
				src="/images/logo-xoomplus.webp"
				alt="Xoomplus"
				width="132"
				height="36"
				class="logo logo--white"
				loading="eager"
				decoding="async"
			/>
			<img
				src="/images/logo-black.webp"
				alt=""
				width="132"
				height="36"
				class="logo logo--black"
				loading="eager"
				decoding="async"
				aria-hidden="true"
			/>
		</a>

		<nav
			class="nav-glass relative min-w-0 justify-self-center rounded-full"
			aria-label="Primary"
			data-nav-cluster
		>
			{/* Shared hover / active indicator — plain CSS, no backdrop-filter */}
			<div
				class="nav-indicator"
				data-nav-indicator
				aria-hidden="true"
				style="--nav-ind-opacity: 0; --nav-ind-x: 0px; --nav-ind-w: 0px;"
			></div>
			<ul class="nav-pill-links relative z-[1] m-0 flex list-none items-center gap-0 p-1" data-nav-links>
				{
					nav.map((item) => {
						const active = isActive(item.href, item.matchPrefixes);
						const isServices = Boolean(item.hasDropdown);

						if (isServices) {
							return (
								<li class="services-nav-item" data-services-nav>
									<a
										class:list={[
											'nav-pill-link inline-flex items-center justify-center gap-[0.3rem] whitespace-nowrap rounded-full px-3.5 py-2.5 text-[0.875rem] font-medium tracking-[-0.01em]',
											active && 'nav-link-active font-semibold',
										]}
										href={item.href}
										aria-current={active ? 'page' : undefined}
										aria-haspopup="true"
										aria-expanded="false"
										aria-controls={megaPanelId}
										data-services-trigger
										data-nav-link
									>
										{item.label}
										<svg
											class="opacity-85"
											width="10"
											height="6"
											viewBox="0 0 10 6"
											aria-hidden="true"
										>
											<path
												d="M1 1l4 4 4-4"
												fill="none"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</a>
									<ServicesMegaMenu />
								</li>
							);
						}

						return (
							<li>
								<a
									class:list={[
										'nav-pill-link inline-flex items-center justify-center gap-[0.3rem] whitespace-nowrap rounded-full px-3.5 py-2.5 text-[0.875rem] font-medium tracking-[-0.01em]',
										active && 'nav-link-active font-semibold',
									]}
									href={item.href}
									aria-current={active ? 'page' : undefined}
									data-nav-link
								>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>

		<div class="z-[1] shrink-0 justify-self-end" data-nav-cta>
			<Button size="nav" href="#contact">Let’s Talk</Button>
		</div>
	</div>

	<!-- Mobile top: Logo ………… Menu (<1024px); glass shell when scrolled -->
	<div
		class="pointer-events-auto mx-auto flex w-full items-center justify-between gap-3 bg-transparent pl-4 pr-4 pt-[calc(1.5rem+env(safe-area-inset-top,0px))] sm:pl-6 sm:pr-6 lg:hidden"
		data-nav-mobile
	>
		<a class="nav-logo-link shrink-0" href="/" aria-label="Xoomplus home" data-nav-logo-mobile>
			<img
				src="/images/logo-xoomplus.webp"
				alt="Xoomplus"
				width="132"
				height="36"
				class="logo logo--white"
				loading="eager"
				decoding="async"
			/>
			<img
				src="/images/logo-black.webp"
				alt=""
				width="132"
				height="36"
				class="logo logo--black"
				loading="eager"
				decoding="async"
				aria-hidden="true"
			/>
		</a>

		<button
			class="mobile-menu-btn shrink-0"
			type="button"
			aria-expanded="false"
			aria-controls={mobileDrawerId}
			aria-label="Open menu"
			data-mobile-menu-toggle
		>
			<span class="mobile-menu-btn__icon" aria-hidden="true"></span>
			<span class="mobile-menu-btn__label">Menu</span>
		</button>
	</div>

	<!-- Right drawer (full links) -->
	<div class="mobile-drawer-root lg:hidden" data-mobile-drawer-root hidden inert>
		<button
			class="mobile-drawer__backdrop"
			type="button"
			tabindex="-1"
			aria-label="Close menu"
			data-mobile-drawer-backdrop
		></button>
		<aside
			id={mobileDrawerId}
			class="mobile-drawer"
			role="dialog"
			aria-modal="true"
			aria-label="Site menu"
			data-mobile-drawer
		>
			<div class="mobile-drawer__head">
				<p class="mobile-drawer__title">Menu</p>
				<button
					class="mobile-drawer__close"
					type="button"
					aria-label="Close menu"
					data-mobile-drawer-close
				>
					<span aria-hidden="true">×</span>
				</button>
			</div>
			<nav aria-label="Mobile menu">
				<ul class="mobile-drawer__list">
					{
						nav.map((item) => {
							const active = isActive(item.href, item.matchPrefixes);
							const isServices = Boolean(item.hasDropdown);

							if (isServices) {
								return (
									<li>
										<button
											class:list={['mobile-drawer__link', active && 'is-active']}
											type="button"
											aria-expanded="false"
											aria-controls={mobileServicesId}
											aria-haspopup="dialog"
											data-mobile-drawer-services
										>
											{item.label}
											<svg
												class="mobile-drawer__chevron"
												width="10"
												height="6"
												viewBox="0 0 10 6"
												aria-hidden="true"
											>
												<path
													d="M1 1l4 4 4-4"
													fill="none"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</button>
									</li>
								);
							}

							return (
								<li>
									<a
										class:list={['mobile-drawer__link', active && 'is-active']}
										href={item.href}
										aria-current={active ? 'page' : undefined}
										data-mobile-drawer-link
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
			<div class="mobile-drawer__cta">
				<Button size="nav" class="!w-full" href="#contact">Let’s Talk</Button>
			</div>
		</aside>
	</div>

	<!-- Mobile Services mega sheet (from bottom nav) -->
	<div class="mobile-services-root lg:hidden" data-mobile-services-root hidden inert>
		<button
			class="mobile-services__backdrop"
			type="button"
			tabindex="-1"
			aria-label="Close services menu"
			data-mobile-services-backdrop
		></button>
		<div
			id={mobileServicesId}
			class="mobile-services-sheet"
			role="dialog"
			aria-modal="true"
			aria-label="Services"
			data-mobile-services-sheet
		>
			<div class="mobile-services-sheet__head">
				<button
					class="mobile-services-sheet__back"
					type="button"
					data-mobile-services-close
				>
					<span aria-hidden="true">←</span>
					<span>Back</span>
				</button>
				<p class="mobile-services-sheet__title">Services</p>
				<button
					class="mobile-services-sheet__close"
					type="button"
					aria-label="Close services menu"
					data-mobile-services-close
				>
					<span aria-hidden="true">×</span>
				</button>
			</div>
			<div class="mobile-services-sheet__body">
				<a
					class="mobile-services-sheet__all"
					href={allServicesHref}
					data-mobile-services-link
				>
					All Services
				</a>
				{
					servicesSections.map((section) => (
						<details class="mobile-services-acc">
							<summary class="mobile-services-acc__summary">
								<span>{section.title}</span>
								<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
									<path
										d="M1 1l4 4 4-4"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</summary>
							<ul class="mobile-services-acc__list">
								<li>
									<a
										class="mobile-services-acc__parent"
										href={section.href}
										data-mobile-services-link
									>
										Overview
									</a>
								</li>
								{section.links.map((link) => (
									<li>
										<a href={link.href} data-mobile-services-link>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</details>
					))
				}
			</div>
			<div class="mobile-services-sheet__footer">
				<p class="mobile-services-sheet__footer-heading">{servicesMenu.footer.heading}</p>
				<p class="mobile-services-sheet__footer-text">{servicesMenu.footer.text}</p>
				<Button size="nav" class="!w-full" href={servicesMenu.footer.buttonHref}>
					{servicesMenu.footer.buttonLabel}
				</Button>
			</div>
		</div>
	</div>
</header>

<style>
	/* Instant theme tokens — no fade (duration kept at 0ms for optional later fade) */
	[data-site-header] {
		--nav-theme-duration: 0ms;
		--nav-shrink-duration: 250ms;
		--nav-shrink-ease: cubic-bezier(0.23, 1, 0.32, 1);
		--nav-pill-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
		--nav-pill-blur: 10px;
		--nav-pill-saturate: 1.3;
		--nav-link: #ffffff;
		--nav-link-active: #ffffff;
		--nav-indicator: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.08));
		--nav-indicator-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
		--nav-rim: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.65),
			rgba(255, 255, 255, 0.08) 45%,
			rgba(255, 255, 255, 0.06) 60%,
			rgba(255, 255, 255, 0.35)
		);
		--nav-glass-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			inset 0 -1px 0 rgba(255, 255, 255, 0.1),
			inset 0 0 10px rgba(255, 255, 255, 0.06),
			0 4px 16px rgba(0, 0, 0, 0.14);
		color-scheme: dark;
	}

	[data-site-header][data-theme='light'] {
		--nav-pill-bg: rgba(0, 0, 0, 0.05);
		--nav-pill-blur: 10px;
		--nav-pill-saturate: 1.3;
		--nav-link: #111111;
		--nav-link-active: #111111;
		--nav-indicator: linear-gradient(135deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.04));
		--nav-indicator-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
		--nav-rim: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.6),
			rgba(255, 255, 255, 0.2) 45%,
			rgba(255, 255, 255, 0.12) 60%,
			rgba(255, 255, 255, 0.4)
		);
		--nav-glass-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 2px 8px rgba(0, 0, 0, 0.06);
		color-scheme: light;
	}

	/* Single pure-CSS glass surface (exactly one backdrop-filter host at a time) */
	.nav-glass {
		border: none;
		background: var(--nav-pill-bg);
		-webkit-backdrop-filter: blur(var(--nav-pill-blur)) saturate(var(--nav-pill-saturate));
		backdrop-filter: blur(var(--nav-pill-blur)) saturate(var(--nav-pill-saturate));
		box-shadow: var(--nav-glass-shadow);
	}

	.nav-glass::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: var(--nav-rim);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		pointer-events: none;
		z-index: 0;
	}

	@media (max-width: 1023px), (prefers-reduced-transparency: reduce) {
		.nav-glass {
			background: rgba(20, 19, 18, 0.78);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			box-shadow: none;
		}
		.nav-glass::before {
			display: none;
		}
	}

	@media (prefers-contrast: more) {
		.nav-glass {
			background: rgba(20, 19, 18, 0.9);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			box-shadow: none;
		}
		.nav-glass::before {
			display: none;
		}
	}

	[data-nav-desktop] .nav-pill-link {
		color: var(--nav-link);
	}

	[data-nav-desktop] .nav-link-active {
		color: var(--nav-link-active);
		background-color: transparent;
	}

	[data-site-header][data-theme='light'] [data-menu-icon],
	[data-site-header][data-theme='light'] [data-menu-icon]::before,
	[data-site-header][data-theme='light'] [data-menu-icon]::after {
		background-color: #555555;
	}

	/* Indicator — plain CSS, NO backdrop-filter */
	.nav-indicator {
		position: absolute;
		top: 3px;
		left: 0;
		z-index: 0;
		width: var(--nav-ind-w, 0px);
		height: calc(100% - 6px);
		transform: translate3d(var(--nav-ind-x, 0px), 0, 0);
		border-radius: 9999px;
		background: var(--nav-indicator);
		box-shadow: var(--nav-indicator-shadow);
		backface-visibility: hidden;
		transform-style: flat;
		pointer-events: none;
		opacity: var(--nav-ind-opacity, 0);
		transition:
			transform 0.2s cubic-bezier(0.23, 1, 0.32, 1),
			width 0.2s cubic-bezier(0.23, 1, 0.32, 1),
			opacity 0.15s ease;
	}

	.nav-indicator::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: var(--nav-rim);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		pointer-events: none;
	}

	.nav-indicator.nav-indicator--gliding {
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-indicator {
			transition:
				opacity 0.1s ease,
				width 0s,
				transform 0s;
		}
	}

	.nav-pill-link:focus-visible {
		outline: 2px solid light-dark(#0a84ff, #5ac8fa);
		outline-offset: 2px;
	}

	.nav-logo-link {
		position: relative;
		display: flex;
		align-items: center;
		align-self: stretch;
		line-height: 0;
		margin-left: 0;
	}

	.nav-logo-link .logo {
		display: block;
		width: clamp(104px, 10vw, 132px);
		height: calc(clamp(104px, 10vw, 132px) * 57 / 244);
		object-fit: fill;
		object-position: center;
		transform: translateY(-5px);
		transition: none;
	}

	.nav-logo-link .logo--black {
		position: absolute;
		left: 0;
		top: 50%;
		width: clamp(104px, 10vw, 132px);
		height: calc(clamp(104px, 10vw, 132px) * 57 / 244);
		object-fit: fill;
		transform: translateY(calc(-50% - 5px));
	}

	[data-site-header] .nav-logo-link .logo--white {
		opacity: 1;
	}

	[data-site-header] .nav-logo-link .logo--black {
		opacity: 0;
	}

	[data-site-header][data-theme='light'] .nav-logo-link .logo--white {
		opacity: 0;
	}

	[data-site-header][data-theme='light'] .nav-logo-link .logo--black {
		opacity: 1;
	}

	[data-site-header][data-variant='solid'] {
		background-color: var(--color-primary-black);
	}

	[data-site-header][data-variant='solid'] [data-nav-desktop],
	[data-site-header][data-variant='solid'] [data-nav-mobile] {
		background-color: transparent;
	}

	[data-nav-desktop],
	[data-nav-mobile] {
		transition:
			width var(--nav-shrink-duration) var(--nav-shrink-ease),
			max-width var(--nav-shrink-duration) var(--nav-shrink-ease),
			margin-top var(--nav-shrink-duration) var(--nav-shrink-ease),
			margin-inline var(--nav-shrink-duration) var(--nav-shrink-ease),
			padding var(--nav-shrink-duration) var(--nav-shrink-ease),
			border-radius var(--nav-shrink-duration) var(--nav-shrink-ease),
			gap var(--nav-shrink-duration) var(--nav-shrink-ease);
	}

	[data-nav-cluster] {
		position: relative;
		transition: none;
	}

	/* Scrolled: move the ONE glass surface to the unified shell */
	[data-site-header][data-scrolled] [data-nav-desktop] {
		width: min(94vw, 1100px);
		max-width: 1100px;
		margin-top: 0.75rem;
		padding: 0.5rem 16px;
		border: none;
		border-radius: 9999px;
		gap: 0.75rem;
		background: var(--nav-pill-bg);
		-webkit-backdrop-filter: blur(var(--nav-pill-blur)) saturate(var(--nav-pill-saturate));
		backdrop-filter: blur(var(--nav-pill-blur)) saturate(var(--nav-pill-saturate));
		box-shadow: var(--nav-glass-shadow);
	}

	[data-site-header][data-scrolled] [data-nav-desktop]::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: var(--nav-rim);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		pointer-events: none;
		z-index: 0;
	}

	@media (min-width: 1024px) {
		[data-site-header][data-scrolled] [data-nav-desktop] {
			padding-left: 20px;
			padding-right: 20px;
		}
	}

	@media (min-width: 1280px) {
		[data-site-header][data-scrolled] [data-nav-desktop] {
			padding-left: 24px;
			padding-right: 24px;
		}
	}

	[data-site-header][data-scrolled] [data-nav-cluster] {
		background: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		box-shadow: none;
	}

	[data-site-header][data-scrolled] [data-nav-cluster]::before {
		display: none;
	}

	[data-site-header][data-scrolled] [data-nav-desktop] > .nav-logo-link,
	[data-site-header][data-scrolled] [data-nav-desktop] > [data-nav-cluster],
	[data-site-header][data-scrolled] [data-nav-desktop] > [data-nav-cta] {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 1023px), (prefers-reduced-transparency: reduce) {
		[data-site-header][data-scrolled] [data-nav-desktop] {
			background: rgba(20, 19, 18, 0.78);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			box-shadow: none;
		}
		[data-site-header][data-scrolled] [data-nav-desktop]::before {
			display: none;
		}
	}

	@media (prefers-contrast: more) {
		[data-site-header][data-scrolled] [data-nav-desktop] {
