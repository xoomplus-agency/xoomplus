		function apply(link, { immediate = false } = {}) {
			const m = measure(link);
			if (!m) {
				indicator.style.setProperty('--nav-ind-opacity', '0');
				setGliding(false);
				return;
			}
			const skipMotion = immediate || reduceMotion.matches;
			if (skipMotion) indicator.style.transition = 'none';
			else setGliding(true);
			indicator.style.setProperty('--nav-ind-x', `${m.x}px`);
			indicator.style.setProperty('--nav-ind-w', `${m.w}px`);
			indicator.style.setProperty('--nav-ind-opacity', '1');
			if (skipMotion) {
				void indicator.offsetWidth;
				indicator.style.transition = '';
				setGliding(false);
			}
		}

		function goRest({ immediate = false } = {}) {
			if (activeLink) apply(activeLink, { immediate });
			else indicator.style.setProperty('--nav-ind-opacity', '0');
		}

		function remasure() {
			const focused = links.find((link) => link.matches(':focus-visible'));
			if (focused) {
				apply(focused, { immediate: true });
				return;
			}
			const hovered = links.find((link) => link.matches(':hover'));
			if (hovered) {
				apply(hovered, { immediate: true });
				return;
			}
			goRest({ immediate: true });
		}

		goRest({ immediate: true });

		for (const link of links) {
			link.addEventListener('pointerenter', () => {
				apply(link);
			});
			link.addEventListener('focusin', () => {
				if (link.matches(':focus-visible')) apply(link);
			});
		}

		cluster.addEventListener('pointerleave', () => goRest());
		cluster.addEventListener('focusout', (event) => {
			const next = event.relatedTarget;
			if (next instanceof Node && cluster.contains(next)) return;
			goRest();
		});

		/* Remeasure after shrink transition ends — never in a scroll loop */
		if (desktop instanceof HTMLElement) {
			desktop.addEventListener('transitionend', (event) => {
				if (event.target !== desktop || event.propertyName !== 'width') return;
				remasure();
			});
		}

		window.addEventListener(
			'resize',
			() => {
				remasure();
			},
			{ passive: true },
		);
	}

	initNavIndicator();

	/* ── Mobile right drawer + Services sheet ── */
	const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
	const mobileDrawerRoot = document.querySelector('[data-mobile-drawer-root]');
	const mobileDrawer = document.querySelector('[data-mobile-drawer]');
	const mobileDrawerBackdrop = document.querySelector('[data-mobile-drawer-backdrop]');
	const mobileDrawerClose = document.querySelector('[data-mobile-drawer-close]');
	const mobileDrawerServices = document.querySelector('[data-mobile-drawer-services]');
	const mobileServicesRoot = document.querySelector('[data-mobile-services-root]');
	const mobileServicesSheet = document.querySelector('[data-mobile-services-sheet]');
	const mobileServicesBackdrop = document.querySelector('[data-mobile-services-backdrop]');
	let mobileDrawerOpen = false;
	let mobileServicesOpen = false;

	function isMobileNav() {
		return window.matchMedia('(max-width: 1023px)').matches;
	}

	/** Cleared on unlock; errors cannot leave the page scroll-locked. */
	let scrollLockFailsafe = 0;

	function unlockPageScroll() {
		document.documentElement.style.overflow = '';
		document.body.style.overflow = '';
		document.body.style.pointerEvents = '';
		if (scrollLockFailsafe) {
			window.clearTimeout(scrollLockFailsafe);
			scrollLockFailsafe = 0;
		}
	}

	function lockPageScroll(lock) {
		try {
			if (lock) {
				document.documentElement.style.overflow = 'hidden';
				if (scrollLockFailsafe) window.clearTimeout(scrollLockFailsafe);
				scrollLockFailsafe = window.setTimeout(() => {
					unlockPageScroll();
				}, 3000);
			} else {
				unlockPageScroll();
			}
		} catch {
			unlockPageScroll();
		}
	}

	function setMobileDrawerOpen(open) {
		try {
			if (
				!(mobileMenuToggle instanceof HTMLButtonElement) ||
				!(mobileDrawerRoot instanceof HTMLElement) ||
				!(mobileDrawer instanceof HTMLElement)
			) {
				return;
			}

			if (!isMobileNav() && open) open = false;

			mobileDrawerOpen = open;
			mobileMenuToggle.setAttribute('aria-expanded', String(open));
			mobileMenuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

			if (open) {
				if (mobileServicesOpen) setMobileServicesOpen(false, { skipFocus: true });
				mobileDrawerRoot.hidden = false;
				mobileDrawerRoot.removeAttribute('inert');
				requestAnimationFrame(() => {
					mobileDrawerRoot.setAttribute('data-open', '');
				});
				lockPageScroll(true);
				mobileDrawerClose instanceof HTMLButtonElement
					? mobileDrawerClose.focus()
					: mobileDrawer.focus();
			} else {
				mobileDrawerRoot.removeAttribute('data-open');
				mobileDrawerRoot.setAttribute('inert', '');
				if (!mobileServicesOpen) lockPageScroll(false);
				const finish = () => {
					if (mobileDrawerOpen) return;
					mobileDrawerRoot.hidden = true;
				};
				mobileDrawer.addEventListener('transitionend', finish, { once: true });
				window.setTimeout(finish, 320);
				mobileMenuToggle.focus();
			}
		} catch {
			lockPageScroll(false);
		}
	}

	function setMobileServicesOpen(open, { skipFocus = false } = {}) {
		try {
			if (!(mobileServicesRoot instanceof HTMLElement) || !(mobileServicesSheet instanceof HTMLElement)) {
				return;
			}

			if (!isMobileNav() && open) open = false;

			mobileServicesOpen = open;
			if (mobileDrawerServices instanceof HTMLButtonElement) {
				mobileDrawerServices.setAttribute('aria-expanded', String(open));
			}

			if (open) {
				if (mobileDrawerOpen) setMobileDrawerOpen(false);
				mobileServicesRoot.hidden = false;
				mobileServicesRoot.removeAttribute('inert');
				requestAnimationFrame(() => {
					mobileServicesRoot.setAttribute('data-open', '');
				});
				lockPageScroll(true);
				if (!skipFocus) {
					const back = mobileServicesRoot.querySelector('[data-mobile-services-close]');
					if (back instanceof HTMLButtonElement) back.focus();
				}
			} else {
				mobileServicesRoot.removeAttribute('data-open');
				mobileServicesRoot.setAttribute('inert', '');
				if (!mobileDrawerOpen) lockPageScroll(false);
				const finish = () => {
					if (mobileServicesOpen) return;
					mobileServicesRoot.hidden = true;
				};
				mobileServicesSheet.addEventListener('transitionend', finish, { once: true });
				window.setTimeout(finish, 320);
				if (!skipFocus && mobileDrawerServices instanceof HTMLButtonElement) {
					/* Re-open drawer so Services remains reachable after closing the sheet */
					setMobileDrawerOpen(true);
				}
			}
		} catch {
			lockPageScroll(false);
		}
	}

	if (mobileMenuToggle instanceof HTMLButtonElement) {
		mobileMenuToggle.addEventListener('click', () => {
			setMobileDrawerOpen(!mobileDrawerOpen);
		});
	}
	if (mobileDrawerBackdrop instanceof HTMLElement) {
		mobileDrawerBackdrop.addEventListener('click', () => setMobileDrawerOpen(false));
	}
	if (mobileDrawerClose instanceof HTMLButtonElement) {
		mobileDrawerClose.addEventListener('click', () => setMobileDrawerOpen(false));
	}
	document.querySelectorAll('[data-mobile-drawer-link]').forEach((link) => {
		link.addEventListener('click', () => setMobileDrawerOpen(false));
	});

	if (mobileDrawerServices instanceof HTMLButtonElement) {
		mobileDrawerServices.addEventListener('click', () => {
			setMobileServicesOpen(true);
		});
	}
	if (mobileServicesBackdrop instanceof HTMLElement) {
		mobileServicesBackdrop.addEventListener('click', () => setMobileServicesOpen(false));
	}
	document.querySelectorAll('[data-mobile-services-close]').forEach((btn) => {
		btn.addEventListener('click', () => setMobileServicesOpen(false));
	});
	document.querySelectorAll('[data-mobile-services-link]').forEach((link) => {
		link.addEventListener('click', () => setMobileServicesOpen(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (mobileServicesOpen) {
			setMobileServicesOpen(false);
			return;
		}
		if (mobileDrawerOpen) {
			setMobileDrawerOpen(false);
			return;
		}
		if (isMegaOpen()) closeMega({ returnFocus: true });
	});

	window.addEventListener(
		'resize',
		() => {
			if (!isMobileNav()) {
				if (mobileDrawerOpen) setMobileDrawerOpen(false);
				if (mobileServicesOpen) setMobileServicesOpen(false, { skipFocus: true });
			}
		},
		{ passive: true },
	);

	/* ── Desktop Services mega menu ── */
	const servicesNav = document.querySelector('[data-services-nav]');
	const servicesTrigger = document.querySelector('[data-services-trigger]');
	const megaPanel = document.querySelector('[data-services-mega]');

	const OPEN_DELAY_MS = 80;
	const CLOSE_DELAY_MS = 120;
	let openTimer = 0;
	let closeTimer = 0;
	let megaOpen = false;

	function isDesktopMega() {
		return window.matchMedia('(min-width: 1024px)').matches;
	}

	function isMegaOpen() {
		return megaOpen;
	}

	function setMegaOpen(open) {
		if (!(megaPanel instanceof HTMLElement) || !(servicesTrigger instanceof HTMLElement)) return;
		if (!isDesktopMega() && open) return;

		megaOpen = open;
		megaPanel.dataset.open = open ? 'true' : 'false';
		megaPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
		if (open) megaPanel.removeAttribute('inert');
		else megaPanel.setAttribute('inert', '');
		servicesTrigger.setAttribute('aria-expanded', String(open));
		if (open) {
			servicesTrigger.setAttribute('data-mega-open', '');
		} else {
			servicesTrigger.removeAttribute('data-mega-open');
		}
	}

	function openMega() {
		window.clearTimeout(closeTimer);
		window.clearTimeout(openTimer);
		setMegaOpen(true);
	}

	function closeMega({ returnFocus = false } = {}) {
		window.clearTimeout(openTimer);
		window.clearTimeout(closeTimer);
		setMegaOpen(false);
		if (returnFocus && servicesTrigger instanceof HTMLElement) {
			servicesTrigger.focus();
		}
	}

	function scheduleOpen() {
		if (!isDesktopMega()) return;
		window.clearTimeout(closeTimer);
		window.clearTimeout(openTimer);
		openTimer = window.setTimeout(() => setMegaOpen(true), OPEN_DELAY_MS);
	}

	function scheduleClose() {
		window.clearTimeout(openTimer);
		window.clearTimeout(closeTimer);
		closeTimer = window.setTimeout(() => setMegaOpen(false), CLOSE_DELAY_MS);
	}

	function prefersFinePointer() {
		return window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	}

	if (
		servicesNav instanceof HTMLElement &&
		servicesTrigger instanceof HTMLElement &&
		megaPanel instanceof HTMLElement
	) {
		setMegaOpen(false);

		servicesNav.addEventListener('mouseenter', () => {
			if (prefersFinePointer()) scheduleOpen();
		});
		servicesNav.addEventListener('mouseleave', () => {
			if (prefersFinePointer()) scheduleClose();
		});

		megaPanel.addEventListener('mouseenter', () => {
			if (prefersFinePointer()) {
				window.clearTimeout(closeTimer);
				openMega();
			}
		});
		megaPanel.addEventListener('mouseleave', () => {
			if (prefersFinePointer()) scheduleClose();
		});

		servicesTrigger.addEventListener('focus', () => {
			if (isDesktopMega()) openMega();
		});

		servicesTrigger.addEventListener('keydown', (event) => {
			if (!isDesktopMega()) return;
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				if (megaOpen) closeMega();
				else openMega();
			}
		});

		/* Touch / coarse pointer at desktop width: first tap opens; second tap navigates */
		servicesTrigger.addEventListener('click', (event) => {
			if (!isDesktopMega() || prefersFinePointer()) return;
			if (!megaOpen) {
				event.preventDefault();
				openMega();
			}
		});

		megaPanel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => closeMega());
		});

		document.addEventListener('focusin', (event) => {
			if (!megaOpen || !isDesktopMega()) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (servicesNav.contains(target) || megaPanel.contains(target)) return;
			closeMega();
		});

		document.addEventListener('pointerdown', (event) => {
			if (!megaOpen || !isDesktopMega()) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (servicesNav.contains(target) || megaPanel.contains(target)) return;
			closeMega();
		});

		window.addEventListener(
			'resize',
			() => {
				if (!isDesktopMega()) closeMega();
			},
			{ passive: true },
		);
	}
</script>
