---
import ButtonOutline from './ButtonOutline.astro';

/**
 * Home “Our Locations” card.
 * Manchester → /locations/manchester
 */
const locations = [
	{
		slug: 'manchester',
		title: 'Manchester',
		image: '/images/manchester-1.webp',
		alt: 'Aerial view of the Manchester city skyline',
		items: [
			'SEO Manchester',
			'Web Design Manchester',
			'PPC Manchester',
			'Social Media Manchester',
		],
	},
];
---

<section
	id="locations"
	data-bg="light"
	class="page-section bg-secondary-white py-section"
	aria-labelledby="locations-heading"
>
	<div class="container">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14" data-reveal="up">
			<p class="pill-light mb-5">OUR LOCATIONS</p>
			<h2
				id="locations-heading"
				class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Driving Commercial Growth Across Manchester and Nationwide
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Headquartered in Blackburn, Xoomplus delivers agile, data-led services for high-impact SEO,
				custom web development and targeted digital performance in Manchester and across the UK.
			</p>
		</div>

		<ul class="locations-grid m-0 list-none p-0" role="list" data-reveal-group>
			{
				locations.map((location) => {
					const href = `/locations/${location.slug}`;
					return (
						<li class="location-card card-hover" data-reveal="up">
							<div class="location-card-media">
								<img
									src={location.image}
									alt={location.alt}
									width="320"
									height="280"
									class="location-card-img"
									decoding="async"
									loading="lazy"
								/>
							</div>
							<div class="location-card-body">
								<div class="location-card-copy">
									<h3 class="location-card-title m-0">{location.title}</h3>
									<ul class="location-list m-0 list-none p-0" role="list">
										{location.items.map((item) => (
											<li class="location-list-item">
												<span class="location-check" aria-hidden="true">
													<svg
														width="18"
														height="18"
														viewBox="0 0 18 18"
														fill="none"
														xmlns="http://www.w3.org/2000/svg"
													>
														<circle cx="9" cy="9" r="9" fill="#FFA800" />
														<path
															d="M5.25 9.25L7.75 11.75L12.75 6.5"
															stroke="#ffffff"
															stroke-width="1.75"
															stroke-linecap="round"
															stroke-linejoin="round"
														/>
													</svg>
												</span>
												<span>{item}</span>
											</li>
										))}
									</ul>
								</div>
								{/* Main card link + stretched-link overlay — whole card clickable, no nested <a> */}
								<ButtonOutline class="w-full location-card-link" href={href}>
									<span>View Details</span>
									<svg
										class="btn-outline__icon"
										width="16"
										height="16"
										viewBox="0 0 16 16"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
										aria-hidden="true"
									>
										<path
											d="M3 8h10M9 4l4 4-4 4"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</ButtonOutline>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.locations-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		gap: 1.75rem;
	}

	.location-card {
		position: relative;
		display: grid;
		grid-template-columns: 40% 60%;
		width: 100%;
		max-width: 720px;
		height: 311px;
		overflow: hidden;
		border: 1px solid #eeeeee;
		border-radius: 16px;
		background-color: #ffffff;
		box-shadow: 0 8px 24px 0 rgba(149, 157, 165, 0.2);
	}

	/* Stretch the View Details <a> over the card without nesting links */
	.location-card :global(.location-card-link)::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.location-card-media {
		min-height: 0;
		min-width: 0;
	}

	.location-card-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.location-card-body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.25rem;
	}

	.location-card-copy {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.location-card-title {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-primary-black);
	}

	.location-list {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.location-list-item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		line-height: 1.4;
		color: #6b6b6b;
	}

	.location-check {
		display: inline-flex;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
	}

	@media (max-width: 639px) {
		.location-card {
			grid-template-columns: 1fr;
			height: auto;
		}

		.location-card-media {
			height: 180px;
		}

		.location-card-img {
			height: 180px;
		}
	}
</style>
