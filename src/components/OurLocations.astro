---
/**
 * Home “Our Locations” cards.
 * Blackburn → /locations/blackburn
 */
const locations = [
	{
		slug: 'blackburn',
		title: 'Blackburn',
		image: '/images/blackburn-location-card.webp',
		alt: 'Blackburn city centre and surrounding area',
		items: [
			'SEO Blackburn',
			'Web Design Blackburn',
			'PPC Blackburn',
			'Social Media Blackburn',
		],
	},
];
---

<section
	id="locations"
	data-bg="light"
	class="page-section bg-secondary-white py-section"
	aria-labelledby="locations-heading"
>
	<div class="container">
		<div class="mx-auto mb-12 max-w-[820px] text-center lg:mb-14" data-reveal="up">
			<p class="pill-light mb-5">OUR LOCATIONS</p>
			<h2
				id="locations-heading"
				class="mb-4 text-h2 font-semibold tracking-[-0.02em] text-primary-black"
			>
				Driving Commercial Growth Across Manchester and Nationwide
			</h2>
			<p class="text-on-light mx-auto max-w-[640px]">
				Headquartered in Blackburn, Xoomplus delivers agile, data-led marketing services for high-impact SEO, custom web development and targeted digital performance in Manchester and across the UK.

			</p>
		</div>

		<ul class="locations-grid m-0 list-none p-0" role="list" data-reveal-group>
			{
				locations.map((location) => {
					const href = `/locations/${location.slug}`;
					return (
						<li data-reveal="up">
							<a
								class="location-card"
								href={href}
								data-astro-prefetch="viewport"
								aria-label={`View ${location.title} location details`}
							>
								<div class="location-card-media">
									<img
										src={location.image}
										alt={location.alt}
										width="320"
										height="280"
										class="location-card-img"
										decoding="async"
										loading="lazy"
									/>
								</div>
								<div class="location-card-body">
									<div class="location-card-copy">
										<h3 class="location-card-title m-0">{location.title}</h3>
										<ul class="location-list m-0 list-none p-0" role="list">
											{location.items.map((item) => (
												<li class="location-list-item">
													<span class="location-check" aria-hidden="true">
														<svg
															width="18"
															height="18"
															viewBox="0 0 18 18"
															fill="none"
															xmlns="http://www.w3.org/2000/svg"
														>
															<circle cx="9" cy="9" r="9" fill="#FFA800" />
															<path
																d="M5.25 9.25L7.75 11.75L12.75 6.5"
																stroke="#ffffff"
																stroke-width="1.75"
																stroke-linecap="round"
																stroke-linejoin="round"
															/>
														</svg>
													</span>
													<span>{item}</span>
												</li>
											))}
										</ul>
									</div>
									<span class="btn-outline w-full location-card-cta" aria-hidden="true">
										<span>View Details</span>
										<svg
											class="btn-outline__icon"
											width="16"
											height="16"
											viewBox="0 0 16 16"
											fill="none"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path
												d="M3 8h10M9 4l4 4-4 4"
												stroke="currentColor"
												stroke-width="1.75"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</span>
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.locations-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
		justify-items: stretch;
		gap: 1.75rem;
	}

	.location-card {
		position: relative;
		display: grid;
		grid-template-columns: 40% 60%;
		width: 588px;
		max-width: 100%;
		justify-self: center;
		height: 311px;
		overflow: hidden;
		border: 1px solid #eeeeee;
		border-radius: 16px;
		background-color: #ffffff;
		box-shadow: 0 8px 24px 0 rgba(149, 157, 165, 0.2);
		text-decoration: none;
		color: inherit;
		transition:
			transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
			box-shadow 250ms cubic-bezier(0.23, 1, 0.32, 1),
			border-color 250ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.location-card:focus-visible {
		outline: 2px solid #ffa800;
		outline-offset: 3px;
	}

	.location-card-media {
		min-height: 0;
		min-width: 0;
		overflow: hidden;
	}

	.location-card-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1);
		transition: transform 350ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.location-card-body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.25rem;
	}

	.location-card-copy {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.location-card-title {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-primary-black);
		transition: color 200ms ease;
	}

	.location-list {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.location-list-item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--font-inter);
		font-size: 0.875rem;
		line-height: 1.4;
		color: #6b6b6b;
	}

	.location-check {
		display: inline-flex;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
	}

	.location-card :global(.btn-outline__icon) {
		transition: transform 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.location-card:hover {
			transform: translate3d(0, -4px, 0);
			border-color: rgba(255, 168, 0, 0.35);
			box-shadow: 0 14px 32px 0 rgba(149, 157, 165, 0.28);
		}

		.location-card:hover .location-card-img {
			transform: scale(1.04);
		}

		.location-card:hover .location-card-title {
			color: #ffa800;
		}

		.location-card:hover :global(.btn-outline__icon) {
			transform: translateX(3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.location-card,
		.location-card-img,
		.location-card-title,
		.location-card :global(.btn-outline__icon) {
			transition: none;
		}

		.location-card:hover {
			transform: none;
		}

		.location-card:hover .location-card-img {
			transform: none;
		}
	}

	@media (max-width: 639px) {
		.location-card {
			grid-template-columns: 1fr;
			height: auto;
		}

		.location-card-media {
			height: 180px;
		}

		.location-card-img {
			height: 180px;
		}
	}
</style>
