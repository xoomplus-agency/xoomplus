---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { getPageSEO, isMappedSeoPath, type PageSEO } from '../lib/wp-seo';
import { SITE_NOINDEX } from '../config';
import type { NavItem } from '../data/nav';
import '../styles/global.css';
import '../styles/tablet.css';
import '../styles/motion.css';
/* Above-the-fold fonts only — hero H1 (SF Pro Bold) + body (Inter 400) */
import sfProDisplayBold from '../assets/fonts/SFPRODISPLAYBOLD.woff2';
import interRegular from '../assets/fonts/Inter-400.woff2';

interface Props {
	/** Fallback title for non-WP-mapped routes (blogs, services, etc.). */
	title?: string;
	/** Fallback description for non-WP-mapped routes only. */
	description?: string;
	image?: string;
	type?: string;
	canonicalPath?: string;
	/**
	 * Override pathname for WP SEO lookup when the request path differs from the CMS route.
	 * Canonicals / og:url use the resolved CMS path.
	 */
	seoPath?: string;
	/** Pass-through to Header — `solid` for white pages without a dark hero */
	headerVariant?: 'default' | 'solid';
	/**
	 * Nav chrome theme from first paint. Prefer this over `headerTheme`.
	 * `light` also sets `data-theme="light"` on `<html>` (white pages, no dark hero).
	 */
	theme?: 'dark' | 'light';
	/** @deprecated Prefer `theme`. Pass-through to Header when `theme` is omitted. */
	headerTheme?: 'dark' | 'light';
	/** When true: noindex/nofollow, no canonical, no og:url. Default false. */
	noindex?: boolean;
	/**
	 * Explicit robots meta (e.g. "noindex, follow" for CMS posts).
	 * Does not strip canonical/og — use `noindex` for full suppression.
	 */
	robots?: string;
	/** When true, no nav item is marked active (e.g. 404 under /blogs/…). */
	suppressNavActive?: boolean;
	/**
	 * Skip WordPress page SEO lookup (blog posts pass title/description themselves).
	 * Cuts TTFB on `/[category]/[slug]` where getPageSEO is wasted work.
	 */
	skipWpSeo?: boolean;
	/** Optional `<link rel="preload" as="image">` for the LCP featured image. */
	lcpImagePreload?: {
		href: string;
		imagesrcset?: string;
		imagesizes?: string;
	};
	/** Cross-origin image hosts to preconnect (e.g. WP media origin). */
	preconnectOrigins?: string[];
	/** Optional nav override (default is build-time static — no WP). */
	navItems?: NavItem[];
}

const {
	title = 'Xoomplus — Digital Marketing & Growth Partner',
	description = 'Xoomplus combines SEO, web design and development, social media marketing, and paid search to help businesses grow.',
	image,
	type = 'website',
	canonicalPath,
	seoPath,
	headerVariant = 'default',
	theme: themeProp,
	headerTheme = 'dark',
	noindex = false,
	robots: robotsProp,
	suppressNavActive = false,
	skipWpSeo = false,
	lcpImagePreload,
	preconnectOrigins = [],
	navItems,
} = Astro.props;

const theme = themeProp ?? headerTheme;
/** Site-wide flag forces noindex on every page (blogs + static) until flipped off. */
const effectiveNoindex = noindex || SITE_NOINDEX;

const path = seoPath ?? Astro.url.pathname;

const mappedPromise =
	effectiveNoindex || skipWpSeo ? Promise.resolve(false) : isMappedSeoPath(path);
const pageSeoPromise =
	effectiveNoindex || skipWpSeo ? Promise.resolve(null) : getPageSEO(path);
const [mapped, pageSeoResult] = await Promise.all([mappedPromise, pageSeoPromise]);

/** Yoast SEO for mapped routes — fetched once in the shared layout. */
const pageSeo: PageSEO | null = mapped ? pageSeoResult : null;

if (effectiveNoindex) {
	Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
} else if (robotsProp) {
	Astro.response.headers.set('X-Robots-Tag', robotsProp);
}
---

<!doctype html>
<html lang="en" data-theme={theme === 'light' ? 'light' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/*
			Critical path: meta → (inlined CSS via build.inlineStylesheets) → font preloads →
			optional LCP image preload → deferred modules. No render-blocking JS.
		*/}
		{/* Hero H1 (SF Pro Bold) + body (Inter 400) — only these two preloaded */}
		<link
			rel="preload"
			href={sfProDisplayBold}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={interRegular}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{
			lcpImagePreload && (
				<link
					rel="preload"
					as="image"
					href={lcpImagePreload.href}
					imagesrcset={lcpImagePreload.imagesrcset || undefined}
					imagesizes={lcpImagePreload.imagesizes || undefined}
					fetchpriority="high"
					type={lcpImagePreload.href.endsWith('.avif') ? 'image/avif' : undefined}
				/>
			)
		}
		{/* Blog/media origins only — never on the critical path for pages without remote LCP */}
		{
			preconnectOrigins.map((origin) => (
				<>
					<link rel="preconnect" href={origin} crossorigin />
					<link rel="dns-prefetch" href={origin} />
				</>
			))
		}
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<Seo
			title={mapped ? undefined : title}
			description={mapped ? undefined : description}
			image={image}
			type={type}
			canonicalPath={canonicalPath}
			pageSeo={pageSeo}
			noindex={effectiveNoindex}
			robots={effectiveNoindex ? undefined : robotsProp}
		>
			<slot name="json-ld" slot="json-ld" />
		</Seo>
	</head>
	<body
		class="m-0 flex min-h-screen w-full flex-col"
		data-header-variant={headerVariant}
		data-header-theme={theme}
	>
		<Header
			variant={headerVariant}
			theme={theme}
			suppressActive={suppressNavActive}
			navItems={navItems}
		/>
		<slot />
		<Footer />
		<ScrollToTop />
		<script src="../scripts/reveal.ts"></script>
	</body>
</html>

<style is:global>
	/* Native cross-document view transitions — CSS only, progressive enhancement, zero JS */
	@view-transition {
		navigation: auto;
	}

	/* body only — clipping html breaks IntersectionObserver / scroll reveals on mobile */
	@media (max-width: 1023px) {
		body {
			overflow-x: clip;
		}
	}
</style>
