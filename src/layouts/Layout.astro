---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { isStaging, STAGING_ROBOTS } from '../lib/site-env';
import { getPageSEO, isMappedSeoPath, type PageSEO } from '../lib/wp-seo';
import { getBlogCategoryPrefixes } from '../lib/wp';
import type { NavItem } from '../data/nav';
import '../styles/global.css';
import '../styles/motion.css';
import sfProDisplayBold from '../assets/fonts/SFPRODISPLAYBOLD.OTF';

interface Props {
	/** Fallback title for non-WP-mapped routes (blogs, services, etc.). */
	title?: string;
	/** Fallback description for non-WP-mapped routes only. */
	description?: string;
	image?: string;
	type?: string;
	canonicalPath?: string;
	/**
	 * Override pathname for WP SEO lookup when the request path differs from the CMS route.
	 * Canonicals / og:url use the resolved CMS path.
	 */
	seoPath?: string;
	/** Pass-through to Header — `solid` for white pages without a dark hero */
	headerVariant?: 'default' | 'solid';
	/**
	 * Nav chrome theme from first paint. Prefer this over `headerTheme`.
	 * `light` also sets `data-theme="light"` on `<html>` (white pages, no dark hero).
	 */
	theme?: 'dark' | 'light';
	/** @deprecated Prefer `theme`. Pass-through to Header when `theme` is omitted. */
	headerTheme?: 'dark' | 'light';
	/** When true: noindex/nofollow, no canonical, no og:url. Default false. */
	noindex?: boolean;
	/**
	 * Explicit robots meta (e.g. "noindex, follow" for CMS posts).
	 * Does not strip canonical/og — use `noindex` for full suppression.
	 */
	robots?: string;
	/** When true, no nav item is marked active (e.g. 404 under /blogs/…). */
	suppressNavActive?: boolean;
	/**
	 * Skip WordPress page SEO lookup (blog posts pass title/description themselves).
	 * Cuts TTFB on `/[category]/[slug]` where getPageSEO is wasted work.
	 */
	skipWpSeo?: boolean;
	/** Optional `<link rel="preload" as="image">` for the LCP featured image. */
	lcpImagePreload?: {
		href: string;
		imagesrcset?: string;
		imagesizes?: string;
	};
	/** Cross-origin image hosts to preconnect (e.g. WP media origin). */
	preconnectOrigins?: string[];
	/** Pre-resolved nav items — avoids a duplicate WP round-trip in Header. */
	navItems?: NavItem[];
}

const {
	title = 'Xoomplus — Digital Marketing & Growth Partner',
	description = 'Xoomplus combines SEO, web design and development, social media marketing, and paid search to help businesses grow.',
	image,
	type = 'website',
	canonicalPath,
	seoPath,
	headerVariant = 'default',
	theme: themeProp,
	headerTheme = 'dark',
	noindex = false,
	robots: robotsProp,
	suppressNavActive = false,
	skipWpSeo = false,
	lcpImagePreload,
	preconnectOrigins = [],
	navItems,
} = Astro.props;

const theme = themeProp ?? headerTheme;

const path = seoPath ?? Astro.url.pathname;

// Start the blog-category lookup with SEO/route resolution so the header
// does not wait on it after the page body is otherwise ready.
if (!noindex) {
	void getBlogCategoryPrefixes();
}

const mappedPromise =
	noindex || skipWpSeo ? Promise.resolve(false) : isMappedSeoPath(path);
const pageSeoPromise =
	noindex || skipWpSeo ? Promise.resolve(null) : getPageSEO(path);
const [mapped, pageSeoResult] = await Promise.all([mappedPromise, pageSeoPromise]);

/** Yoast SEO for mapped routes — fetched once in the shared layout. */
const pageSeo: PageSEO | null = mapped ? pageSeoResult : null;

if (isStaging()) {
	Astro.response.headers.set('X-Robots-Tag', STAGING_ROBOTS);
} else if (noindex) {
	Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
} else if (robotsProp) {
	Astro.response.headers.set('X-Robots-Tag', robotsProp);
}
---

<!doctype html>
<html lang="en" data-theme={theme === 'light' ? 'light' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* LCP image discovery first — before fonts/CSS compete for the connection */}
		{
			preconnectOrigins.map((origin) => (
				<>
					<link rel="preconnect" href={origin} crossorigin />
					<link rel="dns-prefetch" href={origin} />
				</>
			))
		}
		{
			lcpImagePreload && (
				<link
					rel="preload"
					as="image"
					href={lcpImagePreload.href}
					imagesrcset={lcpImagePreload.imagesrcset || undefined}
					imagesizes={lcpImagePreload.imagesizes || undefined}
					fetchpriority="high"
				/>
			)
		}
		<link
			rel="preload"
			href={sfProDisplayBold}
			as="font"
			type="font/otf"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add('js');
			/* Preloader guard: skip on /blogs and blog posts; once per session; hard-cap 1.5s.
			   Only acts when a preloader node/class is present — never fights nav scroll-lock. */
			(function () {
				var KEY = 'xp-preloader-seen';
				var path = location.pathname.replace(/\/+$/, '') || '/';
				var isBlogs = path === '/blogs';
				var isBlogPost =
					/^\/[^/]+\/[^/]+$/.test(path) &&
					path.indexOf('/services/') !== 0 &&
					path.indexOf('/api/') !== 0;
				function hasPreloader() {
					var body = document.body;
					return Boolean(
						document.querySelector('[data-preloader], .preloader, #preloader') ||
							(body && body.classList.contains('is-loading')) ||
							(body && body.classList.contains('preload-active')),
					);
				}
				function release() {
					if (!hasPreloader()) return;
					var body = document.body;
					document.documentElement.style.overflow = '';
					if (body) {
						body.style.overflow = '';
						body.style.pointerEvents = '';
						body.style.position = '';
						body.classList.remove('is-loading', 'preload-active');
					}
					var el = document.querySelector('[data-preloader], .preloader, #preloader');
					if (el) el.remove();
				}
				if (isBlogs || isBlogPost) {
					release();
					return;
				}
				if (!hasPreloader()) return;
				try {
					if (sessionStorage.getItem(KEY) === '1') {
						release();
						return;
					}
					sessionStorage.setItem(KEY, '1');
				} catch (_) {}
				window.setTimeout(release, 1500);
				window.setTimeout(release, 3000);
			})();
		</script>
		<Seo
			title={mapped ? undefined : title}
			description={mapped ? undefined : description}
			image={image}
			type={type}
			canonicalPath={canonicalPath}
			pageSeo={pageSeo}
			noindex={noindex}
			robots={robotsProp}
		>
			<slot name="json-ld" slot="json-ld" />
		</Seo>
	</head>
	<body class="m-0 flex min-h-screen w-full flex-col">
		<Header
			variant={headerVariant}
			theme={theme}
			suppressActive={suppressNavActive}
			navItems={navItems}
		/>
		<slot />
		<Footer />
		<ScrollToTop />
		<script src="../scripts/reveal.ts"></script>
	</body>
</html>

<style is:global>
	@media (max-width: 1023px) {
		html,
		body {
			overflow-x: clip;
		}
	}
</style>
