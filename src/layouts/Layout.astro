---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isStaging, STAGING_ROBOTS } from '../lib/site-env';
import '../styles/global.css';
import sfProDisplayBold from '../assets/fonts/SFPRODISPLAYBOLD.OTF';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: string;
	canonicalPath?: string;
	/** Pass-through to Header — `solid` for white pages without a dark hero */
	headerVariant?: 'default' | 'solid';
	/** Pass-through to Header — `light` for pages that start on white (no dark hero) */
	headerTheme?: 'dark' | 'light';
}

const {
	title = 'Xoomplus — Digital Marketing & Growth Partner',
	description = 'Xoomplus combines SEO, web design and development, social media marketing, and paid search to help businesses grow.',
	image,
	type = 'website',
	canonicalPath,
	headerVariant = 'default',
	headerTheme = 'dark',
} = Astro.props;

if (isStaging()) {
	Astro.response.headers.set('X-Robots-Tag', STAGING_ROBOTS);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link
			rel="preload"
			href={sfProDisplayBold}
			as="font"
			type="font/otf"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={title}
			description={description}
			image={image}
			type={type}
			canonicalPath={canonicalPath}
		>
			<slot name="json-ld" slot="json-ld" />
		</Seo>
	</head>
	<body class="m-0 flex min-h-screen w-full flex-col">
		<Header variant={headerVariant} theme={headerTheme} />
		<slot />
		<Footer />
	</body>
</html>
